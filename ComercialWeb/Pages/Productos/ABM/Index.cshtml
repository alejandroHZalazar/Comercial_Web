@* Toast *@
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toastProd" class="toast align-items-center text-bg-success border-0" role="alert" data-bs-delay="3000">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="toastProdMsg">Operación exitosa</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ================================================================
//  INSTANCIAS MODAL (Bootstrap 5.1.0)
// ================================================================
let _modalProd     = null;
let _modalConfProd = null;
let _idBajaProd    = null;

document.addEventListener('DOMContentLoaded', () => {
    _modalProd     = new bootstrap.Modal(document.getElementById('productoModal'),    { backdrop: 'static' });
    _modalConfProd = new bootstrap.Modal(document.getElementById('modalConfirmarProd'));

    document.getElementById('TipoBusqueda').selectedIndex = @ViewData["FiltroDefecto"];

    document.getElementById('productoForm').addEventListener('submit', function () {
        ['PrecioProveedor','Costo','PrecioLista','GananciaProducto','DescuentoProducto'].forEach(id => {
            const inp = document.getElementById(id);
            if (inp?.value) inp.value = inp.value.replace('.', ',');
        });
    });

    // Mostrar/ocultar los porcentajes por producto según el proveedor seleccionado
    document.getElementById('ProveedorSelect').addEventListener('change', () => toggleCamposPorcentaje(true));

    document.getElementById('btnConfirmarBajaProd').addEventListener('click', ejecutarBajaProd);
});

// ================================================================
//  PORCENTAJES POR PRODUCTO — visibilidad según proveedor
// ================================================================
// Devuelve true si el proveedor seleccionado maneja porcentajes por producto.
function proveedorEsPorProducto() {
    const sel = document.getElementById('ProveedorSelect');
    const opt = sel.options[sel.selectedIndex];
    return opt?.getAttribute('data-precios-por-producto') === '1';
}

// Muestra/oculta la sección. Si prefillDefaults=true y se activa por producto con
// los campos vacíos, precarga los porcentajes por defecto del proveedor como punto de partida.
function toggleCamposPorcentaje(prefillDefaults) {
    const seccion = document.getElementById('seccionPorcentajesProducto');
    const gInp    = document.getElementById('GananciaProducto');
    const dInp    = document.getElementById('DescuentoProducto');

    if (proveedorEsPorProducto()) {
        seccion.style.display = '';
        if (prefillDefaults) {
            const sel = document.getElementById('ProveedorSelect');
            const opt = sel.options[sel.selectedIndex];
            if (!gInp.value) gInp.value = opt?.getAttribute('data-ganancia')  ?? '';
            if (!dInp.value) dInp.value = opt?.getAttribute('data-descuento') ?? '';
        }
    } else {
        // Proveedor por-proveedor (NULL/0): se ocultan y se vacían para que se envíen como NULL.
        seccion.style.display = 'none';
        gInp.value = '';
        dInp.value = '';
    }
}

// ================================================================
//  BÚSQUEDA (Enter o botón)
// ================================================================
async function buscarProductos() {
    const tipo  = parseInt(document.getElementById('TipoBusqueda').value);
    const valor = document.getElementById('txtBusqueda').value.trim();
    if (!valor) { document.getElementById('txtBusqueda').focus(); return; }

    const tbody = document.getElementById('tbodyProductos');
    tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state">
        <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
        <div>Buscando…</div></div></td></tr>`;

    try {
        const res  = await fetch(`/Productos/ABM/Index?handler=BuscarProductos&tipo=${tipo}&valor=${encodeURIComponent(valor)}`);
        const html = await res.text();
        tbody.innerHTML = html;

        const filas = tbody.querySelectorAll('tr[data-id]');
        const lbl   = document.getElementById('lblResultados');
        lbl.style.display = '';
        lbl.textContent   = `${filas.length} resultado${filas.length !== 1 ? 's' : ''}`;

        if (filas.length === 1) {
            mostrarDetalle(parseInt(filas[0].dataset.id), filas[0]);
        }
    } catch {
        tbody.innerHTML = `<tr><td colspan="4"><div class="empty-state">
            <div class="text-danger small">Error al buscar productos</div></div></td></tr>`;
    }
}

// ================================================================
//  DETALLE DE PRODUCTO (clic en fila)
// ================================================================
function mostrarDetalle(id, trEl) {
    // Resaltar fila seleccionada
    document.querySelectorAll('#tbodyProductos tr').forEach(r => r.classList.remove('selected'));
    if (trEl) trEl.classList.add('selected');

    document.getElementById('IdProductoSeleccionado').value = id;
    document.getElementById('detalleContenido').innerHTML =
        `<div class="detail-placeholder"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Cargando…</div></div>`;

    fetch(`/Productos/ABM/Index?handler=Detalle&id=${id}`)
        .then(r => r.text())
        .then(html => document.getElementById('detalleContenido').innerHTML = html)
        .catch(() => document.getElementById('detalleContenido').innerHTML =
            `<div class="empty-state text-danger small">Error al cargar el detalle</div>`);
}

// ================================================================
//  MODAL NUEVO
// ================================================================
function abrirModalNuevoProducto() {
    document.getElementById('productoForm').reset();
    document.getElementById('ProductoId').value = 0;
    document.getElementById('productoModalLabel').textContent = 'Nuevo Producto';
    document.getElementById('inputCantidad').disabled = false;
    document.getElementById('stockEditNote').style.display = 'none';
    // Sin proveedor seleccionado → sección de porcentajes por producto oculta
    toggleCamposPorcentaje(false);
    _resetGaleria(0);
    _modalProd.show();
}

// ================================================================
//  MODAL EDITAR
// ================================================================
async function abrirModalEditar(id) {
    try {
        const res     = await fetch(`/Productos/ABM?handler=Producto&id=${id}`);
        if (!res.ok) throw new Error('No encontrado');
        const prod = await res.json();

        document.getElementById('ProductoId').value = prod.id;
        document.querySelector("input[name='Producto.CodProveedor']").value   = prod.codProveedor  ?? '';
        document.querySelector("input[name='Producto.CodBarras']").value      = prod.codBarras     ?? '';
        document.querySelector("input[name='Producto.Descripcion']").value    = prod.descripcion   ?? '';
        document.querySelector("select[name='Producto.FkRubro']").value       = prod.fkRubro       ?? '';
        document.querySelector("select[name='Producto.FkProveedor']").value   = prod.fkProveedor   ?? '';
        document.getElementById('PrecioProveedor').value = prod.precioProveedor ?? '';
        document.getElementById('Costo').value           = prod.costo            ?? '';
        document.getElementById('PrecioLista').value     = prod.precio           ?? '';
        document.querySelector("input[name='Producto.Cantidad']").value       = prod.cantidad      ?? '';
        document.querySelector("input[name='Producto.CantidadMinima']").value = prod.cantidadMinima ?? '';
        document.querySelector("input[name='Producto.CantidadMinimaVenta']").value = prod.cantidadMinimaVenta ?? '';
        document.getElementById('GananciaProducto').value  = prod.ganancia  ?? '';
        document.getElementById('DescuentoProducto').value = prod.descuento ?? '';
        document.getElementById('DescripcionLarga').value = prod.descripcionLarga ?? '';

        // Visibilidad de porcentajes por producto según el proveedor del producto
        // (no precargar defaults: respetar los valores ya guardados)
        toggleCamposPorcentaje(false);

        // Imágenes: la galería se sirve desde BD vía handler (no base64 en la respuesta JSON)
        _resetGaleria(prod.id);
        _imagenesExistentes = prod.imagenes || [];
        renderGaleria();

        document.getElementById('inputCantidad').disabled         = true;
        document.getElementById('stockEditNote').style.display    = '';
        document.getElementById('productoModalLabel').textContent = 'Editar Producto';
        _modalProd.show();
    } catch (e) {
        mostrarToastProd('Error al cargar el producto', true);
    }
}

// ================================================================
//  CALCULAR PRECIO
// ================================================================
function calcularPrecio() {
    const precioProveedor = parseFloat((document.getElementById('PrecioProveedor').value || '').replace(',', '.')) || 0;
    const sel     = document.getElementById('ProveedorSelect');
    const opt     = sel.options[sel.selectedIndex];

    let ganancia, descuento;
    if (proveedorEsPorProducto()) {
        // Porcentajes cargados a nivel producto
        ganancia  = parseFloat((document.getElementById('GananciaProducto').value  || '').replace(',', '.')) || 0;
        descuento = parseFloat((document.getElementById('DescuentoProducto').value || '').replace(',', '.')) || 0;
    } else {
        // Comportamiento actual: porcentajes a nivel proveedor
        ganancia  = parseFloat(opt?.getAttribute('data-ganancia'))  || 0;
        descuento = parseFloat(opt?.getAttribute('data-descuento')) || 0;
    }

    document.getElementById('PrecioLista').value = (precioProveedor + precioProveedor * ganancia  / 100).toFixed(2);
    document.getElementById('Costo').value       = (precioProveedor - precioProveedor * descuento / 100).toFixed(2);
}

// ================================================================
//  CONFIRMAR BAJA
// ================================================================
function confirmarEliminar(id, nombre) {
    _idBajaProd = id;
    document.getElementById('confirmProdNombre').textContent = nombre;
    _modalConfProd.show();
}

async function ejecutarBajaProd() {
    const token = document.getElementById('antiForgeryToken').value;
    const btn   = document.getElementById('btnConfirmarBajaProd');
    btn.disabled = true; btn.textContent = 'Procesando…';

    try {
        const res  = await fetch(`/Productos/ABM?handler=Eliminar&id=${_idBajaProd}`, {
            method : 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        _modalConfProd.hide();
        mostrarToastProd('Producto dado de baja correctamente');

        const fila = document.querySelector(`#tbodyProductos tr[data-id="${_idBajaProd}"]`);
        if (fila) {
            fila.style.transition = 'opacity .3s';
            fila.style.opacity = '0';
            setTimeout(() => fila.remove(), 320);
        }
        // Limpiar detalle si era el producto seleccionado
        if (document.getElementById('IdProductoSeleccionado').value == _idBajaProd) {
            document.getElementById('detalleContenido').innerHTML =
                `<div class="detail-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"
                         style="width:52px;height:52px;margin-bottom:.75rem;opacity:.4;">
                        <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4h-3.5z"/>
                    </svg>
                    <div class="fw-semibold" style="font-size:.9rem;">Seleccioná un producto</div>
                </div>`;
            document.getElementById('IdProductoSeleccionado').value = '';
        }
    } catch (e) {
        _modalConfProd.hide();
        mostrarToastProd('Error al dar de baja: ' + e.message, true);
    } finally {
        btn.disabled = false; btn.textContent = 'Dar de baja';
    }
}

// ================================================================
//  TOAST
// ================================================================
function mostrarToastProd(msg, isError = false) {
    const el = document.getElementById('toastProd');
    el.className = `toast align-items-center border-0 ${isError ? 'text-bg-danger' : 'text-bg-success'}`;
    document.getElementById('toastProdMsg').textContent = msg;
    new bootstrap.Toast(el, { delay: 3000 }).show();
}

// ================================================================
//  IMÁGENES (múltiples) — galería, upload, drag & drop
// ================================================================
// Modo alta (Producto.Id == 0): _imagenesPendientes es una lista local (aún no
//   persistida en BD) que viaja como JSON en el hidden field al hacer Guardar.
// Modo edición (Producto.Id > 0): _imagenesExistentes refleja filas reales de
//   imagenesProductos; cada acción (subir/eliminar/principal/mover) se aplica
//   de inmediato vía AJAX — Guardar nunca toca las imágenes ya persistidas.
let _idProductoGaleria  = 0;
let _imagenesPendientes = [];   // [{dataUrl, esPrincipal, orden}]
let _imagenesExistentes = [];   // [{id, esPrincipal, orden}]

document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('inputImagenFile');
    const dropZone  = document.getElementById('imgDropZone');

    // Selección por clic en input (puede ser multi-archivo)
    fileInput.addEventListener('change', () => {
        if (fileInput.files.length > 0) _subirImagenes([...fileInput.files]);
        fileInput.value = '';
    });

    // Drag & drop (multi-archivo)
    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', ()  => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        if (e.dataTransfer.files.length > 0) _subirImagenes([...e.dataTransfer.files]);
    });
});

function _resetGaleria(idProducto) {
    _idProductoGaleria  = idProducto || 0;
    _imagenesPendientes = [];
    _imagenesExistentes = [];
    document.getElementById('ImagenesNuevasJson').value = '';
    document.getElementById('inputImagenFile').value = '';
    const st = document.getElementById('imgUploadStatus');
    st.classList.add('d-none'); st.textContent = '';
    renderGaleria();
}

function _actualizarImagenesNuevasJson() {
    document.getElementById('ImagenesNuevasJson').value =
        _imagenesPendientes.length ? JSON.stringify(_imagenesPendientes) : '';
}

// Dibuja la galería según el modo (alta = pendientes locales, edición = filas reales).
function renderGaleria() {
    const cont  = document.getElementById('galeriaImagenes');
    const vacia = document.getElementById('galeriaVacia');
    const esAlta = _idProductoGaleria === 0;
    const lista = esAlta ? _imagenesPendientes : _imagenesExistentes;

    cont.innerHTML = '';
    vacia.style.display = lista.length ? 'none' : '';

    lista.forEach((img, idx) => {
        const src = esAlta ? img.dataUrl : `/Productos/ABM?handler=ImagenItem&id=${img.id}`;
        const div = document.createElement('div');
        div.className = 'img-thumb' + (img.esPrincipal ? ' es-principal' : '');
        div.innerHTML =
            `<img src="${src}" alt="Imagen producto" />` +
            (img.esPrincipal ? `<span class="badge-principal" title="Principal">★</span>` : '') +
            `<button type="button" class="btn-quitar-img" title="Quitar imagen">✕</button>` +
            `<div class="thumb-actions">` +
                `<button type="button" class="btn-mover" data-dir="arriba" title="Mover antes" ${idx === 0 ? 'disabled' : ''}>◀</button>` +
                `<button type="button" class="btn-marcar-principal" title="Marcar como principal" ${img.esPrincipal ? 'disabled' : ''}>★</button>` +
                `<button type="button" class="btn-mover" data-dir="abajo" title="Mover después" ${idx === lista.length - 1 ? 'disabled' : ''}>▶</button>` +
            `</div>`;

        div.querySelector('.btn-quitar-img').addEventListener('click', () => eliminarImagenGaleria(esAlta, idx, img));
        div.querySelector('.btn-marcar-principal').addEventListener('click', () => marcarPrincipalGaleria(esAlta, idx, img));
        div.querySelectorAll('.btn-mover').forEach(btn =>
            btn.addEventListener('click', () => moverImagenGaleria(esAlta, idx, img, btn.dataset.dir)));

        cont.appendChild(div);
    });
}

async function _subirImagenes(files) {
    const st = document.getElementById('imgUploadStatus');
    const token = document.getElementById('antiForgeryToken').value;
    let ok = 0, fallo = 0;

    st.classList.remove('d-none'); st.className = 'small text-muted mb-1';
    st.textContent = files.length > 1 ? `Subiendo ${files.length} imágenes…` : 'Subiendo imagen…';

    for (const file of files) {
        const form = new FormData();
        form.append('archivo', file);
        form.append('productoId', _idProductoGaleria);
        // La primera imagen que se carga (sin ninguna otra existente/pendiente) queda como principal.
        const yaHayImagenes = _idProductoGaleria === 0 ? _imagenesPendientes.length > 0 : _imagenesExistentes.length > 0;
        form.append('esPrincipal', (!yaHayImagenes && ok === 0) ? 'true' : 'false');

        try {
            const resp = await fetch('/Productos/ABM?handler=SubirImagenProducto', {
                method : 'POST',
                headers: { 'RequestVerificationToken': token },
                body   : form
            });
            const data = await resp.json();

            if (data.ok) {
                ok++;
                if (_idProductoGaleria > 0) {
                    // Edición: ya quedó persistida en BD.
                    _imagenesExistentes.push({ id: data.id, esPrincipal: data.esPrincipal, orden: data.orden });
                } else {
                    // Alta: se guarda como pendiente hasta el submit del formulario.
                    const esPrincipal = _imagenesPendientes.length === 0;
                    _imagenesPendientes.push({ dataUrl: data.dataUrl, esPrincipal, orden: _imagenesPendientes.length });
                    _actualizarImagenesNuevasJson();
                }
            } else {
                fallo++;
                st.textContent = data.msg ?? 'Error al subir la imagen.';
            }
        } catch {
            fallo++;
            st.textContent = 'Error de red al subir la imagen.';
        }
    }

    renderGaleria();
    if (fallo === 0) {
        st.className = 'small text-success mb-1';
        st.textContent = _idProductoGaleria > 0 ? 'Imágenes cargadas.' : 'Imágenes cargadas. Se guardarán al presionar Guardar.';
    } else {
        st.className = 'small text-danger mb-1';
    }
}

async function eliminarImagenGaleria(esAlta, idx, img) {
    if (esAlta) {
        _imagenesPendientes.splice(idx, 1);
        // Si se quitó la principal, promover la primera restante para no quedar sin principal.
        if (img.esPrincipal && _imagenesPendientes.length > 0) _imagenesPendientes[0].esPrincipal = true;
        _imagenesPendientes.forEach((im, i) => im.orden = i);
        _actualizarImagenesNuevasJson();
        renderGaleria();
        return;
    }
    const token = document.getElementById('antiForgeryToken').value;
    try {
        await fetch(`/Productos/ABM?handler=EliminarImagen&id=${img.id}`, {
            method : 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        _imagenesExistentes.splice(idx, 1);
        // Reflejar en el cliente la promoción automática de principal que hace el servidor.
        if (img.esPrincipal && _imagenesExistentes.length > 0) _imagenesExistentes[0].esPrincipal = true;
        renderGaleria();
    } catch {
        mostrarToastProd('Error al eliminar la imagen', true);
    }
}

async function marcarPrincipalGaleria(esAlta, idx, img) {
    if (esAlta) {
        _imagenesPendientes.forEach((im, i) => im.esPrincipal = i === idx);
        _actualizarImagenesNuevasJson();
        renderGaleria();
        return;
    }
    const token = document.getElementById('antiForgeryToken').value;
    try {
        await fetch(`/Productos/ABM?handler=MarcarPrincipal&idProducto=${_idProductoGaleria}&id=${img.id}`, {
            method : 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        _imagenesExistentes.forEach(im => im.esPrincipal = im.id === img.id);
        renderGaleria();
    } catch {
        mostrarToastProd('Error al marcar la imagen como principal', true);
    }
}

async function moverImagenGaleria(esAlta, idx, img, direccion) {
    const destino = direccion === 'arriba' ? idx - 1 : idx + 1;
    if (esAlta) {
        if (destino < 0 || destino >= _imagenesPendientes.length) return;
        [_imagenesPendientes[idx], _imagenesPendientes[destino]] = [_imagenesPendientes[destino], _imagenesPendientes[idx]];
        _imagenesPendientes.forEach((im, i) => im.orden = i);
        _actualizarImagenesNuevasJson();
        renderGaleria();
        return;
    }
    if (destino < 0 || destino >= _imagenesExistentes.length) return;
    const token = document.getElementById('antiForgeryToken').value;
    try {
        await fetch(`/Productos/ABM?handler=MoverImagen&idProducto=${_idProductoGaleria}&id=${img.id}&direccion=${direccion}`, {
            method : 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        [_imagenesExistentes[idx], _imagenesExistentes[destino]] = [_imagenesExistentes[destino], _imagenesExistentes[idx]];
        renderGaleria();
    } catch {
        mostrarToastProd('Error al reordenar la imagen', true);
    }
}
</script>
}
