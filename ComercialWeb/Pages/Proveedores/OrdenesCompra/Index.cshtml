@page
@model Comercial_Web.Pages.Proveedores.OrdenesCompra.IndexModel
@{
    ViewData["Title"] = "Orden de Compra";
}

<style>
    /* ===== PAGE HEADER ===== */
    .page-header {
        background: linear-gradient(135deg,#1a2a4a 0%,#2d4a7a 100%);
        border-radius:12px; padding:1.25rem 1.5rem; margin-bottom:1.5rem; color:#fff;
    }
    .page-header h4 { margin:0; font-weight:700; letter-spacing:.3px; }

    /* ===== SECTION CARDS ===== */
    .section-card {
        background:#fff; border:1px solid #e3e6f0; border-radius:12px;
        box-shadow:0 2px 8px rgba(0,0,0,.06); overflow:visible; margin-bottom:1.25rem;
    }
    .section-card-header {
        background:linear-gradient(90deg,#f0f4ff 0%,#f8f9fc 100%);
        border-bottom:1px solid #e3e6f0; padding:.65rem 1.1rem;
        display:flex; align-items:center; justify-content:space-between;
        flex-wrap:wrap; gap:.5rem; border-radius:11px 11px 0 0;
    }
    .section-card-header-left { display:flex; align-items:center; gap:.5rem; }
    .section-card-header span { font-weight:700; font-size:.75rem; text-transform:uppercase; letter-spacing:.5px; color:#4e73df; }
    .section-card-body { padding:1rem 1.1rem; }
    .form-label { font-size:.82rem; font-weight:600; color:#4a5568; margin-bottom:3px; }

    /* ===== BUTTONS ===== */
    .btn-oc {
        border:none; border-radius:8px; padding:.42rem 1rem; font-size:.83rem; font-weight:600;
        display:inline-flex; align-items:center; gap:.4rem;
        cursor:pointer; transition:all .18s; white-space:nowrap;
    }
    .btn-oc svg { width:15px; height:15px; flex-shrink:0; }
    .btn-oc-primary   { background:#4e73df; color:#fff; } .btn-oc-primary:hover   { background:#3a5bc7; }
    .btn-oc-success   { background:#1cc88a; color:#fff; } .btn-oc-success:hover   { background:#17a673; }
    .btn-oc-danger    { background:#e74a3b; color:#fff; } .btn-oc-danger:hover    { background:#c93627; }
    .btn-oc-secondary { background:#858796; color:#fff; } .btn-oc-secondary:hover { background:#6a6b7a; }
    .btn-oc-warning   { background:#f6c23e; color:#222; } .btn-oc-warning:hover   { background:#e0a800; }
    .btn-oc-outline   { background:#fff; color:#4e73df; border:1px solid #4e73df; }
    .btn-oc-outline:hover { background:#eef2ff; }
    .btn-oc:disabled  { opacity:.55; cursor:not-allowed; }

    /* ===== GRILLA ===== */
    .oc-table { width:100%; border-collapse:collapse; font-size:.81rem; }
    .oc-table thead tr { background:linear-gradient(90deg,#1a2a4a 0%,#2d4a7a 100%); }
    .oc-table th { padding:.5rem .65rem; color:#fff; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px; white-space:nowrap; }
    .oc-table td { padding:.38rem .65rem; color:#2d3748; border-bottom:1px solid #f0f0f0; vertical-align:middle; }
    .oc-table tbody tr:hover { background:#f8f9ff; }
    .oc-pedido-input {
        width:80px; border:1px solid #ced4da; border-radius:6px;
        padding:.22rem .45rem; font-size:.82rem; text-align:right;
    }
    .oc-pedido-input:focus { border-color:#4e73df; box-shadow:0 0 0 2px rgba(78,115,223,.15); outline:none; }
    .oc-btn-del { background:none; border:none; padding:.2rem .35rem; border-radius:5px; cursor:pointer; color:#e74a3b; transition:all .15s; }
    .oc-btn-del:hover { background:#fdecea; }
    .oc-code { font-size:.75rem; background:#f0f4ff; color:#2d4a7a; border-radius:4px; padding:.1rem .35rem; }

    /* ===== MESSAGES ===== */
    .oc-msg { font-size:.82rem; padding:.28rem .6rem; border-radius:6px; }
    .oc-msg-ok  { background:#d1f5e8; color:#0d6e4e; }
    .oc-msg-err { background:#fdecea; color:#c0392b; }

    /* ===== AUTOCOMPLETE ===== */
    #lbDesc {
        position:absolute; top:100%; left:0; right:0; z-index:1200;
        background:#fff; border:1px solid #d0d7e8; border-radius:8px;
        box-shadow:0 4px 16px rgba(0,0,0,.12); max-height:200px; overflow-y:auto;
    }
    .oc-autocomplete-item {
        padding:.35rem .75rem; font-size:.82rem; cursor:pointer; transition:background .12s;
    }
    .oc-autocomplete-item:hover,.oc-autocomplete-item:focus { background:#f0f4ff; outline:none; }

    /* ===== EMPTY STATE ===== */
    .empty-state { text-align:center; padding:2rem 1rem; color:#bbb; }

    /* ===== CNT BADGE ===== */
    .cnt-badge { background:#eef2ff; color:#4e73df; border-radius:12px; padding:.15rem .55rem; font-size:.72rem; font-weight:700; }

    /* ===== PROGRESS ===== */
    .progress-wrap { height:18px; border-radius:9px; background:#e9ecef; overflow:hidden; }
    .progress-bar-oc {
        height:100%; border-radius:9px;
        background:linear-gradient(90deg,#4e73df 0%,#1cc88a 100%);
        transition:width .3s ease; display:flex; align-items:center; justify-content:center;
        font-size:.68rem; font-weight:700; color:#fff; min-width:2rem;
    }

    /* ===== PANEL ÉXITO ===== */
    .exito-panel {
        border:1.5px solid #1cc88a; border-radius:12px;
        background:linear-gradient(90deg,#f0fdf4 0%,#f8fff8 100%);
        padding:1.1rem 1.25rem; display:flex; align-items:center;
        justify-content:space-between; flex-wrap:wrap; gap:.75rem;
    }
    .exito-badge { background:#1cc88a; color:#fff; border-radius:8px; padding:.35rem .85rem; font-size:.83rem; font-weight:700; }

    /* ===== MODAL ===== */
    .modal-header-oc {
        background:linear-gradient(135deg,#1a2a4a 0%,#2d4a7a 100%);
        padding:.85rem 1.1rem; display:flex; align-items:center; gap:.65rem;
    }
    .modal-header-oc h5 { margin:0; color:#fff; font-weight:700; font-size:.9rem; }
    .modal-header-oc .btn-close { filter:invert(1); opacity:.8; margin-left:auto; }
    .modal-content { border:none; border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,.18); }

    /* Spinner */
    .spinner-sm {
        display:inline-block; width:14px; height:14px;
        border:2px solid rgba(255,255,255,.35); border-top-color:#fff;
        border-radius:50%; animation:spin .7s linear infinite; flex-shrink:0;
    }
    @@keyframes spin { to { transform:rotate(360deg); } }
</style>

@* ===== PAGE HEADER ===== *@
<div class="page-header d-flex align-items-center gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
    </svg>
    <div>
        <h4>Orden de Compra</h4>
        <small class="opacity-75">Cargá productos y generá notas de pedido a proveedores</small>
    </div>
</div>

@* ===== PROVEEDOR + OPCIONES ===== *@
<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-header-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
            <span>Proveedor</span>
        </div>
    </div>
    <div class="section-card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Proveedor</label>
                <select asp-for="ProveedorId" asp-items="Model.Proveedores"
                        class="form-select form-select-sm" id="ProveedorId"
                        style="border-radius:8px;">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">IVA (%)</label>
                <select asp-for="IvaId" asp-items="Model.Ivas"
                        class="form-select form-select-sm" id="IvaId"
                        style="border-radius:8px;" onchange="recalcularTotales()"></select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn-oc btn-oc-primary" onclick="confirmarProveedor()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/></svg>
                    Confirmar proveedor
                </button>
            </div>
            <div class="col-auto ms-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn-oc btn-oc-outline" id="btnCantMinima">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l4.586-4.586a1 1 0 0 0 0-1.414l-7-7A1 1 0 0 0 6.586 1H2zm4 3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
                    Cant. Mínima
                </button>
                <button type="button" class="btn-oc btn-oc-outline" data-bs-toggle="modal" data-bs-target="#modalStockProductos" id="btnStockProductos">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5z"/></svg>
                    Stock / A Pedir
                </button>
            </div>
        </div>
    </div>
</div>

@* ===== BÚSQUEDA DE PRODUCTOS ===== *@
<fieldset id="fieldsetPrincipal" disabled>
<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-header-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
            <span>Búsqueda de Productos</span>
        </div>
    </div>
    <div class="section-card-body">
        <div class="row g-3 align-items-end">
            @* Tipo de búsqueda *@
            <div class="col-md-2">
                <label class="form-label">Tipo filtro</label>
                <select asp-for="TipoBusqueda" id="TipoBusqueda" class="form-select form-select-sm" style="border-radius:8px;">
                    <option value="1">Cód. Proveedor</option>
                    <option value="2">Cód. de Barras</option>
                    <option value="3">Cód. Interno</option>
                </select>
            </div>
            @* Filtro código *@
            <div class="col-md-2">
                <label class="form-label">Código</label>
                <input type="text" id="txtFiltro" class="form-control form-control-sm"
                       style="border-radius:8px;"
                       onkeydown="buscarProductoEnter(event)"
                       placeholder="Ingresá y Enter…" />
            </div>
            @* Cantidad *@
            <div class="col-md-1">
                <label class="form-label">Cantidad</label>
                <input type="number" id="txtCantidad" class="form-control form-control-sm text-end"
                       style="border-radius:8px;" step="@Model.CantidadStep" min="0" />
            </div>
            @* Resultado búsqueda *@
            <div class="col-md-4 d-flex align-items-end">
                <span id="lblresultadobusqueda" class="oc-msg"></span>
            </div>
            @* Descuento / Recargo *@
            <div class="col-md-2">
                <label class="form-label">Descuento (%)</label>
                <input type="number" asp-for="Descuento" id="txtDescuento" class="form-control form-control-sm text-end"
                       style="border-radius:8px;" min="0" max="100" step="0.01" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Recargo (%)</label>
                <input type="number" asp-for="Recargo" id="txtRecargo" class="form-control form-control-sm text-end"
                       style="border-radius:8px;" min="0" max="999" step="0.01" />
            </div>
        </div>

        @* Búsqueda por descripción (autocomplete) *@
        <div class="row g-3 mt-1">
            <div class="col-md-5" style="position:relative;">
                <label class="form-label">Búsqueda por descripción</label>
                <input type="text" id="txtDesc" class="form-control form-control-sm"
                       style="border-radius:8px;"
                       placeholder="Escribí para filtrar descripciones…"
                       oninput="filtrarDescripcion(this.value)"
                       autocomplete="off" />
                <div id="lbDesc" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@* ===== GRILLA DE PRODUCTOS ===== *@
<div class="section-card">
    <div class="section-card-header">
        <div class="section-card-header-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M3 2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v13H3V2zm3 1v2h4V3H6zM5 3H4v1h1V3zm6 0h-1v1h1V3zM4 6v1h1V6H4zm2 0v1h4V6H6zm5 0h-1v1h1V6zM4 9v1h1V9H4zm2 0v1h4V9H6zm5 0h-1v1h1V9z"/></svg>
            <span>Detalle del Pedido</span>
            <span class="cnt-badge" id="cntFilas">0 producto(s)</span>
        </div>
    </div>
    <div style="max-height:380px; overflow-y:auto;">
        <table class="oc-table" id="tablaDetalles">
            <thead>
                <tr>
                    <th>Cód. Barras</th>
                    <th>Cód. Prov.</th>
                    <th>Descripción</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">C. Mín.</th>
                    <th class="text-end">P. s/IVA</th>
                    <th class="text-end">P. c/IVA</th>
                    <th class="text-end">Pedido</th>
                    <th class="text-end">Subtotal</th>
                    <th style="width:38px;"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div id="emptyGrilla" class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#ddd" viewBox="0 0 16 16" class="mb-2"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5z"/></svg>
        <div style="font-size:.84rem;">Buscá productos para agregarlos al pedido</div>
    </div>

    @* TOTAL + GRABAR *@
    <div style="padding:.85rem 1.1rem; border-top:1px solid #e3e6f0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem; background:#f8f9fc; border-radius:0 0 11px 11px;">
        <div style="display:flex; align-items:center; gap:.5rem;">
            <span style="font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:#4a5568;">Total</span>
            <input type="text" id="txtTotal" value="0,00" readonly
                   style="width:160px; border:1px solid #ced4da; border-radius:8px; padding:.3rem .65rem; font-size:.95rem; font-weight:700; text-align:right; background:#fff; color:#1a2a4a;" />
        </div>
        <button type="button" class="btn-oc btn-oc-success" id="btnGrabar" disabled onclick="grabarOrden()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4.5a.5.5 0 0 0-.146-.354l-3-3A.5.5 0 0 0 11.5 1H2zm0 1h9.293L14 4.707V14H2V2zM5 12a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5zm1-1h4V9H6v2zM5 5a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z"/></svg>
            Grabar Orden
        </button>
    </div>
</div>
</fieldset>

@* ===== PANEL DE PROGRESO ===== *@
<div class="section-card" id="panelProgreso" style="display:none;">
    <div class="section-card-header">
        <div class="section-card-header-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/><path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.47l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"/></svg>
            <span>Proceso de Guardado</span>
        </div>
        <span id="lblEstadoGuardar" style="font-size:.78rem; font-weight:700;"></span>
    </div>
    <div class="section-card-body">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span id="lblProgresoGuardar" style="font-size:.78rem; font-weight:600; color:#6c757d;">Preparando…</span>
            <span id="lblPctGuardar" style="font-size:.78rem; font-weight:700; color:#4e73df;">0%</span>
        </div>
        <div class="progress-wrap mb-2">
            <div class="progress-bar-oc" id="progressBarGuardar" style="width:0%">0%</div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:.5rem; margin-top:.75rem;">
            <div class="oc-step" id="step1">
                <div class="oc-step-dot"></div>
                <span>Validando datos</span>
            </div>
            <div class="oc-step" id="step2">
                <div class="oc-step-dot"></div>
                <span>Enviando al servidor</span>
            </div>
            <div class="oc-step" id="step3">
                <div class="oc-step-dot"></div>
                <span>Procesando líneas</span>
            </div>
            <div class="oc-step" id="step4">
                <div class="oc-step-dot"></div>
                <span>Guardando</span>
            </div>
        </div>
    </div>
</div>

@* ===== PANEL ÉXITO POST-GUARDADO ===== *@
<div id="panelExito" style="display:none; margin-bottom:1.25rem;">
    <div class="exito-panel">
        <div style="display:flex; align-items:center; gap:.85rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#1cc88a" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <div>
                <div style="font-weight:700; font-size:.9rem; color:#0d6e4e;">Orden de Compra grabada correctamente</div>
                <div style="font-size:.8rem; color:#555; margin-top:2px;">
                    N° <strong id="lblOrdenId">00000000</strong>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
            <span style="font-size:.78rem; color:#555; font-weight:600;">Obtener reporte:</span>
            <button class="btn-oc btn-oc-danger" onclick="imprimirOrden('pdf')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z"/></svg>
                PDF
            </button>
            <button class="btn-oc btn-oc-success" onclick="imprimirOrden('excel')">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/><path d="M7.194 7.766a1.657 1.657 0 0 0-.227-.27 1.02 1.02 0 0 1 .909.538l.854 1.646.854-1.646a1.02 1.02 0 0 1 .909-.538 1.659 1.659 0 0 0-.228.27l-.914 1.76.914 1.76a1.659 1.659 0 0 0 .228.27 1.02 1.02 0 0 1-.909-.538L8.531 9.602l-.854 1.646a1.02 1.02 0 0 1-.909.538c.08-.086.16-.175.228-.27l.914-1.76-.914-1.76z"/></svg>
                Excel
            </button>
            <button class="btn-oc btn-oc-secondary" onclick="nuevaOrden()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
                Nueva Orden
            </button>
        </div>
    </div>
</div>

@* ===== MODAL STOCK PRODUCTOS ===== *@
<div class="modal fade" id="modalStockProductos" tabindex="-1" aria-labelledby="modalStockLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header-oc">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#fff" viewBox="0 0 16 16"><path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5z"/></svg>
                <h5>Productos a Pedir — Stock y Movimientos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                @* Filtros *@
                <div style="padding:1rem 1.25rem; background:#f8f9fc; border-bottom:1px solid #e3e6f0;">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Desde</label>
                            <input type="date" id="dtpDesde" class="form-control form-control-sm" style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hasta</label>
                            <input type="date" id="dtpHasta" class="form-control form-control-sm" style="border-radius:8px;" />
                        </div>
                        <div class="col-auto">
                            <button id="btnBuscarStock" type="button" class="btn-oc btn-oc-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                                Buscar
                            </button>
                        </div>
                        <div class="col-auto ms-auto d-flex gap-2">
                            <button type="button" class="btn-oc btn-oc-danger" id="btnImprimirStockPdf">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M5 4v-2a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3zm5-2H6v2h4V2zm1 10v-1H5v1a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1zM2 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
                                PDF
                            </button>
                            <button type="button" class="btn-oc btn-oc-success" id="btnImprimirStockExcel">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/></svg>
                                Excel
                            </button>
                        </div>
                    </div>
                </div>

                @* Grilla stock *@
                <div style="padding:0; overflow-y:auto; max-height:380px;">
                    <table style="width:100%;border-collapse:collapse;font-size:.81rem;" id="tablaStockProductos">
                        <thead>
                            <tr style="background:linear-gradient(90deg,#1a2a4a 0%,#2d4a7a 100%);">
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;">Cód. Prov.</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;">Descripción</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;text-align:right;">Stock</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;text-align:right;">C. Mín.</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;text-align:right;">Ingresos</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;text-align:right;">Ventas</th>
                                <th style="padding:.5rem .65rem;color:#fff;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;text-align:right;">A Pedir</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                @* Totales *@
                <div style="padding:.85rem 1.25rem; background:#f8f9fc; border-top:1px solid #e3e6f0;">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Cant. productos</label>
                            <input type="text" id="txtCantProd" class="form-control form-control-sm text-end" readonly style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Total P. Proveedor</label>
                            <input type="text" id="txtTotProv" class="form-control form-control-sm text-end" readonly style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Total P. Lista</label>
                            <input type="text" id="txtTotLista" class="form-control form-control-sm text-end" readonly style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Total P. Costo</label>
                            <input type="text" id="txtTotCosto" class="form-control form-control-sm text-end fw-bold" readonly style="border-radius:8px;" />
                        </div>
                    </div>
                </div>
            </div>

            <div style="background:#f8f9fc; border-top:1px solid #e3e6f0; padding:.85rem 1.1rem; display:flex; gap:.5rem; justify-content:flex-end; border-radius:0 0 12px 12px;">
                <button type="button" class="btn-oc btn-oc-success" id="btnAceptarStock">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/></svg>
                    Agregar al pedido
                </button>
                <button type="button" class="btn-oc btn-oc-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@* ===== SCRIPT BOOTSTRAP ===== *@
<script>
    window.OC_CANT_STEP = @Model.CantidadStep;
    window.OC_TIPO_BUSQ = @Model.TipoBusqueda;
</script>
<script src="~/js/ordenes-compra.js" asp-append-version="true"></script>

<style>
    /* Steps de progreso */
    .oc-step { display:flex; flex-direction:column; align-items:center; gap:4px; font-size:.72rem; color:#adb5bd; text-align:center; }
    .oc-step-dot { width:10px; height:10px; border-radius:50%; background:#dee2e6; transition:background .3s; }
    .oc-step.active .oc-step-dot { background:#4e73df; box-shadow:0 0 0 3px rgba(78,115,223,.2); }
    .oc-step.done .oc-step-dot { background:#1cc88a; }
    .oc-step.active span, .oc-step.done span { color:#2d3748; font-weight:600; }
</style>
