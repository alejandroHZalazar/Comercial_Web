@page
@model Comercial_Web.Pages.Facturacion.ComprobantesFiscales.IndexModel
@{
    ViewData["Title"] = "Comprobantes Fiscales Emitidos";
}

<style>
/* ── Layout general ───────────────────────────────────────────────────────── */
.cf-header {
  background: linear-gradient(135deg, #1a3a5c 0%, #2e6da4 100%);
  border-radius: 12px; padding: 1.1rem 1.5rem; margin-bottom: 1.2rem;
  color: #fff; display: flex; align-items: center; gap: .8rem;
}
.cf-header h4 { margin: 0; font-weight: 700; font-size: 1.1rem; }
.cf-header small { opacity: .75; font-size: .78rem; }
.cf-card {
  background: #fff; border: 1px solid #e3e6f0;
  border-radius: 10px; padding: 1rem 1.2rem;
  box-shadow: 0 2px 8px rgba(0,0,0,.05); margin-bottom: 1rem;
}
.cf-label { font-size: .78rem; font-weight: 600; color: #5a5c69; margin-bottom: .2rem; display: block; }

/* ── Cards de estadísticas ─────────────────────────────────────────────────── */
.stat-card {
  background: #fff; border: 1px solid #e3e6f0; border-radius: 10px;
  padding: .85rem 1rem; text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,.04);
}
.stat-card .stat-val {
  font-size: 1.35rem; font-weight: 800; color: #1a3a5c; line-height: 1.2;
}
.stat-card .stat-lbl {
  font-size: .7rem; font-weight: 700; color: #6c757d;
  text-transform: uppercase; letter-spacing: .05em; margin-top: .2rem;
}
.stat-card.letra-a { border-top: 3px solid #e74a3b; }
.stat-card.letra-b { border-top: 3px solid #1cc88a; }
.stat-card.letra-c { border-top: 3px solid #f6c23e; }
.stat-card.total   { border-top: 3px solid #1a3a5c; }

/* ── Tabla ─────────────────────────────────────────────────────────────────── */
#tblComp { font-size: .80rem; width: 100%; }
#tblComp thead tr { background: #1a3a5c; color: #fff; }
#tblComp thead th { padding: .45rem .55rem; white-space: nowrap; font-weight: 600; }
#tblComp tbody tr:nth-child(even) td { background: #f8f9fc; }
#tblComp tbody td { padding: .35rem .5rem; vertical-align: middle; }
#tblComp tbody tr:hover td { background: #eef3ff !important; }
#tblComp tfoot tr { background: #1a3a5c; color: #fff; font-weight: 700; font-size: .82rem; }
#tblComp tfoot td { padding: .45rem .55rem; }
.badge-letra {
  display: inline-block; width: 22px; height: 22px; line-height: 22px;
  text-align: center; border-radius: 4px; font-weight: 800; font-size: .82rem;
}
.badge-a { background: #fdecea; color: #c0392b; }
.badge-b { background: #eafaf1; color: #1e8449; }
.badge-c { background: #fef9e7; color: #d68910; }

/* ── Modal ─────────────────────────────────────────────────────────────────── */
.cf-modal-hdr {
  background: linear-gradient(135deg, #1a3a5c, #2e6da4);
  padding: .75rem 1rem; display: flex; align-items: center; gap: .6rem; color: #fff;
}
.cf-modal-hdr h5 { margin: 0; font-size: .92rem; font-weight: 700; }
#tblDetModal { font-size: .78rem; width: 100%; }
#tblDetModal thead tr { background: #1a3a5c; color: #fff; }
#tblDetModal thead th { padding: .4rem .5rem; white-space: nowrap; font-weight: 600; }
#tblDetModal tbody tr:nth-child(even) { background: #f8f9fc; }
#tblDetModal tbody td { padding: .3rem .45rem; vertical-align: middle; }
.cf-tot-box {
  background: #f8f9fc; border: 1px solid #e3e6f0; border-radius: 8px;
  padding: .75rem 1rem; font-size: .82rem; margin-top: .75rem;
}
.cf-tot-row { display: flex; justify-content: space-between; padding: .14rem 0; }
.cf-tot-row.total {
  font-weight: 700; font-size: .95rem; color: #1a3a5c;
  border-top: 1px solid #dee2e6; margin-top: .3rem; padding-top: .4rem;
}
.cf-fp-card {
  background: #fff8e8; border: 1px solid #f0d080; border-radius: 8px;
  padding: .65rem .9rem; margin-top: .75rem; font-size: .82rem;
}
.cf-fp-title {
  font-size: .73rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .06em; color: #856404; margin-bottom: .4rem;
  display: flex; align-items: center; gap: .3rem;
}
.cae-box {
  background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px;
  padding: .55rem .85rem; font-size: .78rem; margin-top: .65rem;
}
.cae-box label { font-size: .68rem; font-weight: 700; text-transform: uppercase; color: #4a6785; }
</style>

@* ══════════════════════════════════════════════════════════ HEADER ══ *@
<div class="cf-header">
  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="28" height="28">
    <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
    <path d="M4.5 12.5A.5.5 0 0 1 5 12h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 10h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m1.639-3.708 1.33.886 1.854-1.855a.25.25 0 0 1 .289-.047l1.888.974V7.5a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V7s1.54-1.274 1.639-1.208M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1z"/>
  </svg>
  <div>
    <h4>Comprobantes Fiscales Emitidos</h4>
    <small>Consulta, descarga y estadísticas de facturas electrónicas</small>
  </div>
</div>

@* ══════════════════════════════════════════════════════ ESTADÍSTICAS ══ *@
<div class="row g-2 mb-2" id="rowStats">
  <div class="col-6 col-md-3">
    <div class="stat-card total">
      <div class="stat-val" id="stTotalEmitidas">@Model.Estadisticas.TotalEmitidas</div>
      <div class="stat-lbl">Total Emitidas</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card total">
      <div class="stat-val" id="stTotalImporte">$@Model.Estadisticas.TotalImporte.ToString("N2")</div>
      <div class="stat-lbl">Importe Total</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card total">
      <div class="stat-val" id="stPromedio">$@Model.Estadisticas.PromedioPorFact.ToString("N2")</div>
      <div class="stat-lbl">Promedio por Factura</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="row g-1">
      <div class="col-4">
        <div class="stat-card letra-a" style="padding:.6rem .5rem;">
          <div class="stat-val" id="stCantA" style="font-size:1rem;">@Model.Estadisticas.CantidadA</div>
          <div class="stat-val" id="stTotalA" style="font-size:.75rem;color:#e74a3b;">$@Model.Estadisticas.TotalA.ToString("N0")</div>
          <div class="stat-lbl">FCTA</div>
        </div>
      </div>
      <div class="col-4">
        <div class="stat-card letra-b" style="padding:.6rem .5rem;">
          <div class="stat-val" id="stCantB" style="font-size:1rem;">@Model.Estadisticas.CantidadB</div>
          <div class="stat-val" id="stTotalB" style="font-size:.75rem;color:#1e8449;">$@Model.Estadisticas.TotalB.ToString("N0")</div>
          <div class="stat-lbl">FCTB</div>
        </div>
      </div>
      <div class="col-4">
        <div class="stat-card letra-c" style="padding:.6rem .5rem;">
          <div class="stat-val" id="stCantC" style="font-size:1rem;">@Model.Estadisticas.CantidadC</div>
          <div class="stat-val" id="stTotalC" style="font-size:.75rem;color:#d68910;">$@Model.Estadisticas.TotalC.ToString("N0")</div>
          <div class="stat-lbl">FCTC</div>
        </div>
      </div>
    </div>
  </div>
</div>

@* ══════════════════════════════════════════════════════════ FILTROS ══ *@
<div class="cf-card">
  <form method="post" asp-page-handler="Buscar" id="formFiltros">
    <div class="row g-2 align-items-end">

      <div class="col-md-2 col-sm-6">
        <label class="cf-label">Fecha desde</label>
        <input type="date" asp-for="Desde" class="form-control form-control-sm" />
      </div>
      <div class="col-md-2 col-sm-6">
        <label class="cf-label">Fecha hasta</label>
        <input type="date" asp-for="Hasta" class="form-control form-control-sm" />
      </div>
      <div class="col-md-3 col-sm-8">
        <label class="cf-label">Cliente / Razón Social / CUIT</label>
        <input type="text" asp-for="FiltroCliente" class="form-control form-control-sm"
               placeholder="Buscar..." autocomplete="off" />
      </div>
      <div class="col-md-2 col-sm-4">
        <label class="cf-label">Letra</label>
        <select asp-for="Letra" class="form-select form-select-sm">
          <option value="">Todas</option>
          <option value="A">A</option>
          <option value="B">B</option>
          <option value="C">C</option>
        </select>
      </div>
      <div class="col-md-2 col-sm-6">
        <button type="submit" class="btn btn-primary btn-sm w-100" style="font-size:.82rem;">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="13" style="margin-right:.25rem;vertical-align:-.1em;">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85-.017.016zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
          </svg>Buscar
        </button>
      </div>

    </div>
  </form>
</div>

@* ══════════════════════════════════════════════════ SIN RESULTADOS ══ *@
@if (Model.Buscado && !Model.Comprobantes.Any())
{
  <div class="alert alert-info d-flex align-items-center shadow-sm" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
    </svg>
    No se encontraron comprobantes en el período y filtros seleccionados.
  </div>
}

@* ══════════════════════════════════════════════════════════ GRILLA ══ *@
@if (Model.Comprobantes.Any())
{
  <div class="cf-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
      <span style="font-size:.75rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.06em;">
        Comprobantes encontrados
      </span>
      <span style="font-size:.75rem;color:#6c757d;">
        @Model.Comprobantes.Count resultado@(Model.Comprobantes.Count != 1 ? "s" : "")
        &nbsp;·&nbsp;
        @Model.Desde.ToString("dd/MM/yyyy") — @Model.Hasta.ToString("dd/MM/yyyy")
      </span>
    </div>

    <div class="table-responsive" style="max-height:55vh;overflow-y:auto;">
      <table id="tblComp" class="table table-bordered mb-0">
        <thead>
          <tr>
            <th style="width:50px;text-align:center;">Letra</th>
            <th style="width:140px;">N° Comprobante</th>
            <th style="width:100px;">Fecha</th>
            <th>Cliente</th>
            <th style="width:130px;">CUIT</th>
            <th style="text-align:right;width:115px;">Importe</th>
            <th style="width:150px;">CAE</th>
            <th style="width:100px;">Vto. CAE</th>
            <th style="text-align:center;width:90px;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var cf in Model.Comprobantes)
          {
            var badgeClass = cf.Letra == "A" ? "badge-a" : cf.Letra == "C" ? "badge-c" : "badge-b";
            var caeVencida = cf.FechaVtoCae.HasValue && cf.FechaVtoCae.Value < DateTime.Today;
            <tr>
              <td style="text-align:center;">
                <span class="badge-letra @badgeClass">@cf.Letra</span>
              </td>
              <td style="font-family:monospace;font-weight:600;color:#1a3a5c;font-size:.79rem;">
                @cf.NumeroFormateado
              </td>
              <td>@cf.FechaEmision.ToString("dd/MM/yyyy")</td>
              <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                  title="@(cf.NombreComercial ?? cf.RazonSocial)">
                @(cf.NombreComercial ?? cf.RazonSocial ?? "—")
              </td>
              <td style="font-family:monospace;font-size:.77rem;">@(cf.Cuit ?? "—")</td>
              <td style="text-align:right;font-weight:700;color:#1a3a5c;">
                $@cf.ImporteTotal.ToString("N2")
              </td>
              <td style="font-family:monospace;font-size:.75rem;color:#5a5c69;">
                @(cf.Cae ?? "—")
              </td>
              <td style="font-size:.77rem;@(caeVencida ? "color:#e74a3b;font-weight:700;" : "")">
                @(cf.FechaVtoCae.HasValue ? cf.FechaVtoCae.Value.ToString("dd/MM/yyyy") : "—")
                @if (caeVencida){ <span title="CAE vencido">⚠</span> }
              </td>
              <td style="text-align:center;white-space:nowrap;">
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        style="font-size:.69rem;padding:.18rem .45rem;margin-right:.2rem;"
                        onclick="verDetalle(@cf.Id)"
                        title="Ver detalle">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="11" height="11">
                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                  </svg>
                </button>
                @if (!string.IsNullOrEmpty(cf.LinkPdf))
                {
                  <a href="@cf.LinkPdf" target="_blank"
                     class="btn btn-outline-success btn-sm"
                     style="font-size:.69rem;padding:.18rem .45rem;"
                     title="Descargar PDF fiscal">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="11" height="11">
                      <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                      <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                    </svg>
                  </a>
                }
              </td>
            </tr>
          }
        </tbody>
        <tfoot>
          <tr>
            <td colspan="5" style="text-align:right;">TOTAL (@Model.Comprobantes.Count)</td>
            <td style="text-align:right;">$@Model.Comprobantes.Sum(c => c.ImporteTotal).ToString("N2")</td>
            <td colspan="3"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
}

@* ══════════════════════════════════════════════════════════ MODAL ══ *@
<div class="modal fade" id="modalDetalle" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">

      <div class="cf-modal-hdr">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="18" height="18">
          <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
          <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3z"/>
        </svg>
        <h5 id="modalTitulo">Detalle de Comprobante</h5>
        <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body" style="padding:1rem 1.25rem;">

        <!-- Spinner -->
        <div id="detLoading" style="text-align:center;padding:2rem;color:#6c757d;">
          <div class="spinner-border spinner-border-sm me-2"></div>Cargando...
        </div>

        <div id="detContenido" style="display:none;">

          <!-- Cabecera del comprobante -->
          <div class="row g-2 mb-3" style="font-size:.82rem;">
            <div class="col-sm-6 col-md-3">
              <span style="color:#6c757d;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">N° Comprobante</span>
              <div id="det-nro" style="font-family:monospace;font-weight:700;color:#1a3a5c;font-size:.95rem;"></div>
            </div>
            <div class="col-sm-6 col-md-2">
              <span style="color:#6c757d;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">Fecha</span>
              <div id="det-fecha"></div>
            </div>
            <div class="col-sm-6 col-md-4">
              <span style="color:#6c757d;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">Cliente</span>
              <div id="det-cliente" style="font-weight:700;color:#2c3e50;"></div>
              <div id="det-cuit" style="font-size:.75rem;color:#6c757d;font-family:monospace;"></div>
            </div>
            <div class="col-sm-6 col-md-3">
              <span style="color:#6c757d;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">Venta asociada</span>
              <div id="det-venta" style="font-family:monospace;"></div>
            </div>
          </div>

          <!-- CAE -->
          <div class="cae-box mb-3">
            <div class="row g-2">
              <div class="col-sm-7">
                <label>CAE</label>
                <div id="det-cae" style="font-family:monospace;font-size:.88rem;font-weight:700;color:#1a3a5c;"></div>
              </div>
              <div class="col-sm-3">
                <label>Vencimiento CAE</label>
                <div id="det-vto-cae" style="font-size:.82rem;"></div>
              </div>
              <div class="col-sm-2 d-flex align-items-end">
                <a id="det-pdf-link" href="#" target="_blank"
                   class="btn btn-success btn-sm w-100" style="font-size:.75rem;display:none;">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="11" height="11" style="margin-right:.25rem;vertical-align:-.1em;">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                  </svg>PDF Fiscal
                </a>
              </div>
            </div>
          </div>

          <!-- Detalle de productos -->
          <div class="table-responsive">
            <table id="tblDetModal" class="table table-bordered mb-0">
              <thead>
                <tr>
                  <th>Descripción</th>
                  <th style="text-align:right;width:90px;">P.S/IVA</th>
                  <th style="text-align:right;width:75px;">Desc/Rec%</th>
                  <th style="text-align:right;width:95px;">SubT.S/IVA</th>
                  <th style="text-align:right;width:85px;">P.C/IVA</th>
                  <th style="text-align:right;width:65px;">Cant.</th>
                  <th style="text-align:right;width:100px;">Total</th>
                </tr>
              </thead>
              <tbody id="tbodyDetModal"></tbody>
            </table>
          </div>

          <!-- Totales -->
          <div class="row g-2 mt-1">
            <div class="col-md-5 offset-md-7">
              <div class="cf-tot-box">
                <div class="cf-tot-row"><span>Subtotal s/IVA</span><span id="det-subtSIva"></span></div>
                <div class="cf-tot-row" id="rowDescRec" style="display:none;">
                  <span id="det-lbl-dr">Desc/Rec</span><span id="det-drAmt"></span>
                </div>
                <div class="cf-tot-row"><span id="det-lbl-iva">IVA</span><span id="det-ivaAmt"></span></div>
                <div class="cf-tot-row" id="rowIIBB" style="display:none;">
                  <span id="det-lbl-iibb">IIBB</span><span id="det-iibbAmt"></span>
                </div>
                <div class="cf-tot-row total"><span>TOTAL</span><span id="det-total"></span></div>
              </div>
            </div>
          </div>

          <!-- Formas de pago -->
          <div id="secFP" style="display:none;">
            <div class="cf-fp-card">
              <div class="cf-fp-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="12" height="12">
                  <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v1h14V4a1 1 0 0 0-1-1H2zm13 4H1v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V7z"/>
                  <path d="M2 10a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1z"/>
                </svg>
                Formas de Pago
              </div>
              <div id="listaFP"></div>
            </div>
          </div>

        </div><!-- /detContenido -->
      </div>

      <div class="modal-footer" style="background:#f8f9fc;border-top:1px solid #e3e6f0;">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
(function () {
  'use strict';

  // ── Helpers ────────────────────────────────────────────────────────────────
  function fmt(n) {
    return new Intl.NumberFormat('es-AR', {
      minimumFractionDigits: 2, maximumFractionDigits: 2
    }).format(n ?? 0);
  }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function fmtFecha(iso) {
    if (!iso) return '—';
    try {
      const d = new Date(iso);
      return d.toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' });
    } catch { return iso; }
  }

  // ── Ver detalle ────────────────────────────────────────────────────────────
  window.verDetalle = function (comprobanteId) {
    // Reset modal
    document.getElementById('detLoading').style.display   = '';
    document.getElementById('detContenido').style.display = 'none';
    document.getElementById('modalTitulo').textContent     = 'Comprobante #' + comprobanteId;

    new bootstrap.Modal(document.getElementById('modalDetalle')).show();

    fetch('?handler=Detalle&id=' + comprobanteId)
      .then(r => r.json())
      .then(res => {
        document.getElementById('detLoading').style.display = 'none';
        if (!res.ok) { alert(res.msg || 'Error al cargar el detalle.'); return; }

        const d = res.detalle;

        // Cabecera
        document.getElementById('modalTitulo').textContent = 'Factura ' + d.letra + ' ' + d.numeroFormateado;
        document.getElementById('det-nro').textContent     = 'FACTURA ' + d.letra + ' ' + d.numeroFormateado;
        document.getElementById('det-fecha').textContent   = fmtFecha(d.fechaEmision);
        document.getElementById('det-cliente').textContent = d.nombreComercial || d.razonSocial || '—';
        document.getElementById('det-cuit').textContent    = d.cuit || '';
        document.getElementById('det-venta').textContent   = d.ventaId ? '#' + d.ventaId : '—';

        // CAE
        document.getElementById('det-cae').textContent     = d.cae || '—';
        const vtoEl = document.getElementById('det-vto-cae');
        vtoEl.textContent = d.fechaVtoCae ? fmtFecha(d.fechaVtoCae) : '—';
        if (d.fechaVtoCae && new Date(d.fechaVtoCae) < new Date())
          vtoEl.style.color = '#e74a3b';
        else
          vtoEl.style.color = '';

        const pdfEl = document.getElementById('det-pdf-link');
        if (d.linkPdf) {
          pdfEl.href = d.linkPdf;
          pdfEl.style.display = '';
        } else {
          pdfEl.style.display = 'none';
        }

        // Detalle de productos
        const tbody = document.getElementById('tbodyDetModal');
        tbody.innerHTML = '';
        const iva = d.iva ?? 0;
        const imp = d.impuesto ?? 0;
        const descGlobal = d.descuento != null
          ? (d.descuento * -1 + (d.recargo ?? 0)) : null;

        let subtSIva = 0;
        (d.detalle || []).forEach(function (item) {
          const dr      = descGlobal !== null
            ? descGlobal : ((item.descuento ?? 0) * -1 + (item.recargo ?? 0));
          const pSIva   = item.precioSinIva ?? 0;
          const subSIva = item.subtotalSinIva > 0 ? item.subtotalSinIva : pSIva * item.cantidad * (1 + dr / 100);
          const pConIva = (item.precioConIva ?? 0) || pSIva * (1 + dr / 100) * (1 + iva / 100);
          const cant    = item.cantidad ?? 0;
          const totLin  = pConIva * cant;
          subtSIva += subSIva;
          const drColor = dr < 0 ? 'color:#e74a3b;' : dr > 0 ? 'color:#1cc88a;' : '';
          const tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + esc(item.descripcion || '') + '</td>' +
            '<td style="text-align:right;">$' + fmt(pSIva) + '</td>' +
            '<td style="text-align:right;' + drColor + '">' + fmt(dr) + '%</td>' +
            '<td style="text-align:right;">$' + fmt(subSIva) + '</td>' +
            '<td style="text-align:right;">$' + fmt(pConIva) + '</td>' +
            '<td style="text-align:right;">' + fmt(cant) + '</td>' +
            '<td style="text-align:right;font-weight:600;">$' + fmt(totLin) + '</td>';
          tbody.appendChild(tr);
        });

        // Totales
        const ivaAmt  = subtSIva * iva / 100;
        const iibbAmt = subtSIva * imp / 100;
        document.getElementById('det-subtSIva').textContent  = '$' + fmt(subtSIva);
        document.getElementById('det-lbl-iva').textContent   = 'IVA ' + fmt(iva) + '%';
        document.getElementById('det-ivaAmt').textContent    = '$' + fmt(ivaAmt);
        const rowIIBB = document.getElementById('rowIIBB');
        if (imp > 0) {
          document.getElementById('det-lbl-iibb').textContent = 'IIBB ' + fmt(imp) + '%';
          document.getElementById('det-iibbAmt').textContent  = '$' + fmt(iibbAmt);
          rowIIBB.style.display = '';
        } else {
          rowIIBB.style.display = 'none';
        }
        document.getElementById('det-total').textContent = '$' + fmt(d.totalVenta || subtSIva + ivaAmt + iibbAmt);

        // Desc/Rec global
        const rowDR = document.getElementById('rowDescRec');
        if (descGlobal !== null && Math.abs(descGlobal) > 0.001) {
          document.getElementById('det-lbl-dr').textContent = descGlobal < 0 ? 'Descuento' : 'Recargo';
          document.getElementById('det-drAmt').textContent  =
            (descGlobal < 0 ? '–$' : '+$') + fmt(Math.abs(subtSIva - subtSIva / (1 + descGlobal / 100)));
          rowDR.style.display = '';
        } else {
          rowDR.style.display = 'none';
        }

        // Formas de pago
        const secFP   = document.getElementById('secFP');
        const listaFP = document.getElementById('listaFP');
        listaFP.innerHTML = '';
        if (d.formasPago && d.formasPago.length > 0) {
          d.formasPago.forEach(function (fp) {
            const row = document.createElement('div');
            row.style.cssText = 'display:flex;justify-content:space-between;padding:.12rem 0;color:#5a4200;';
            row.innerHTML =
              '<span>' + esc(fp.medioPago) + '</span>' +
              '<span style="font-weight:600;">$' + fmt(fp.importe) + '</span>';
            listaFP.appendChild(row);
          });
          secFP.style.display = '';
        } else {
          secFP.style.display = 'none';
        }

        document.getElementById('detContenido').style.display = '';
      })
      .catch(() => {
        document.getElementById('detLoading').style.display = 'none';
        alert('Error de conexión al cargar el detalle.');
      });
  };

})();
</script>
}
