@page "{id:int}"
@model Comercial_Web.Pages.Ventas.ReportePedidos.ImprimirModel
@{
    Layout = null; // standalone print page — no sidebar
    ViewData["Title"] = "Imprimir Pedido";
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pedido @(Model.Cabecera?.Id.ToString() ?? "")</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #222; margin: 0; padding: 1.5cm; background: #fff; }

    /* Header empresa */
    .emp-header { display: flex; align-items: flex-start; gap: 1.2rem; border-bottom: 2px solid #1a3a5c; padding-bottom: .7rem; margin-bottom: .9rem; }
    .emp-logo   { flex-shrink: 0; }
    .emp-datos  { flex: 1; }
    .emp-nombre { font-size: 16px; font-weight: 700; color: #1a3a5c; margin: 0 0 .15rem; }
    .emp-sub    { font-size: 10px; color: #555; margin: 0; }

    /* Titulo pedido */
    .ped-titulo { background: #1a3a5c; color: #fff; padding: .4rem .8rem; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; margin-bottom: .8rem; }
    .ped-titulo span { font-size: 13px; font-weight: 700; }
    .ped-titulo small { font-size: 10px; opacity: .85; }

    /* Datos cabecera */
    .cab-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem .8rem; background: #f8f9fc; border: 1px solid #e3e6f0; border-radius: 6px; padding: .55rem .8rem; margin-bottom: .8rem; font-size: 10.5px; }
    .cab-item label { display: block; color: #6c757d; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 1px; }
    .cab-item span  { font-weight: 600; color: #2c3e50; }
    .cab-full       { grid-column: 1 / -1; }

    /* Tabla detalle */
    table.det { width: 100%; border-collapse: collapse; margin-bottom: .7rem; font-size: 10px; }
    table.det thead tr { background: #1a3a5c; color: #fff; }
    table.det thead th { padding: .3rem .4rem; text-align: left; font-weight: 600; white-space: nowrap; }
    table.det thead th.num { text-align: right; }
    table.det tbody tr:nth-child(even) { background: #f8f9fc; }
    table.det tbody td { padding: .25rem .4rem; border-bottom: 1px solid #eee; vertical-align: top; }
    table.det tbody td.num { text-align: right; white-space: nowrap; }
    table.det tfoot td { padding: .3rem .4rem; font-size: 9.5px; }
    table.det col.c-cod  { width: 72px; }
    table.det col.c-stock { width: 46px; }
    table.det col.c-cant  { width: 46px; }
    table.det col.c-sub   { width: 72px; }
    table.det col.c-tot   { width: 72px; }

    /* Totales */
    .totales { margin-left: auto; width: 240px; border: 1px solid #e3e6f0; border-radius: 6px; overflow: hidden; font-size: 10.5px; }
    .tot-row  { display: flex; justify-content: space-between; padding: .25rem .6rem; }
    .tot-row:nth-child(even) { background: #f8f9fc; }
    .tot-row.total { background: #1a3a5c; color: #fff; font-weight: 700; font-size: 12px; padding: .35rem .6rem; }

    /* Observacion */
    .observ-box { border: 1px solid #e3e6f0; border-radius: 6px; padding: .45rem .7rem; font-size: 10.5px; color: #444; margin-bottom: .8rem; }
    .observ-box label { display: block; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #6c757d; letter-spacing: .04em; margin-bottom: 2px; }

    /* Firma */
    .firma-area { display: flex; justify-content: flex-end; margin-top: 2rem; }
    .firma-box  { text-align: center; width: 180px; }
    .firma-linea { border-top: 1px solid #555; padding-top: .3rem; font-size: 9px; color: #555; margin-top: 2.5rem; }

    /* Error */
    .error-msg { color: #c0392b; background: #fdf0ed; border: 1px solid #e74a3b; border-radius: 6px; padding: .7rem 1rem; font-size: 12px; }

    @@media print {
      body { padding: .8cm; }
      .no-print { display: none !important; }
      @@page { margin: 0; }
    }
  </style>
</head>
<body>

@if (!string.IsNullOrEmpty(Model.Error))
{
  <div class="error-msg">@Model.Error</div>
}
else if (Model.Cabecera != null)
{
  var cab = Model.Cabecera;
  var fmt = (decimal v) => v.ToString("N2", new System.Globalization.CultureInfo("es-AR"));
  var textoObservacion = cab.EsEcommerce == 1
      ? "Observacion: " + (cab.Observacion ?? "")
          + ". Direccion de entrega: " + (cab.DireccionEntrega ?? "")
          + ". " + (cab.DireccionEntregaTexto ?? "")
          + ". Costo Envío: " + (cab.CostoEnvio?.ToString("N2", new System.Globalization.CultureInfo("es-AR")) ?? "0,00")
      : (cab.Observacion ?? "");

  @* ── Encabezado empresa ── *@
  <div class="emp-header">
    <div class="emp-logo">
      @if (!string.IsNullOrEmpty(Model.LogoHtml))
      {
        @Html.Raw(Model.LogoHtml)
      }
    </div>
    <div class="emp-datos">
      <p class="emp-nombre">@Model.EmpresaNombre</p>
      @if (!string.IsNullOrEmpty(Model.EmpresaDirec))
      {
        <p class="emp-sub">@Model.EmpresaDirec</p>
      }
      @if (!string.IsNullOrEmpty(Model.EmpresaTel))
      {
        <p class="emp-sub">Tel: @Model.EmpresaTel</p>
      }
    </div>
  </div>

  @* ── Titulo pedido ── *@
  <div class="ped-titulo">
    <span>PEDIDO N.° @cab.Id</span>
    <small>@(cab.Fecha.HasValue ? cab.Fecha.Value.ToString("dd/MM/yyyy") : "")</small>
  </div>

  @* ── Datos cabecera ── *@
  <div class="cab-grid">
    <div class="cab-item">
      <label>Cliente</label>
      <span>@(cab.NombreComercial ?? "")</span>
    </div>
    <div class="cab-item">
      <label>Telefono</label>
      <span>@(cab.Telefono ?? "")</span>
    </div>
    <div class="cab-item">
      <label>Contacto</label>
      <span>@(cab.Contacto ?? "")</span>
    </div>
    <div class="cab-item">
      <label>Direccion</label>
      <span>@(cab.DireccionFull ?? "")</span>
    </div>
    <div class="cab-item">
      <label>IVA</label>
      <span>@((cab.Iva ?? 0).ToString("N0"))%</span>
    </div>
    @if (cab.Descuento.HasValue || cab.Recargo.HasValue)
    {
      <div class="cab-item">
        <label>Desc / Rec global</label>
        <span>
          @if (cab.Descuento.HasValue && cab.Descuento != 0) { @($"Dto {fmt(cab.Descuento.Value)}%") }
          @if (cab.Recargo.HasValue  && cab.Recargo  != 0) { @($"  Rec {fmt(cab.Recargo.Value)}%")   }
        </span>
      </div>
    }
  </div>

  @* ── Observacion ── *@
  @if (!string.IsNullOrWhiteSpace(textoObservacion))
  {
    <div class="observ-box">
      <label>Observacion</label>
      @textoObservacion
    </div>
  }

  @* ── Tabla detalle ── *@
  <table class="det">
    <colgroup>
      <col class="c-cod" />
      <col class="c-cod" />
      <col />
      <col class="c-stock" />
      <col class="c-cant" />
      <col class="c-sub" />
      <col class="c-tot" />
    </colgroup>
    <thead>
      <tr>
        <th>Cód. Prov.</th>
        <th>Cód. Barras</th>
        <th>Descripcion</th>
        <th class="num">Stock</th>
        <th class="num">Cant.</th>
        <th class="num">Subt. s/IVA</th>
        <th class="num">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var l in Model.Detalle)
      {
        decimal ivaRate = (cab.Iva ?? 0) / 100m;
        decimal dr      = Model.GetDescRec(l);
        decimal subSIva = l.PrecioSinIva * (1m + dr / 100m);
        decimal conIva  = subSIva * (1m + ivaRate);
        decimal cant    = l.Cantidad;
        <tr>
          <td>@(l.CodProveedor ?? "")</td>
          <td>@(l.CodBarras ?? "")</td>
          <td>
            @l.Descripcion
            @if (!string.IsNullOrWhiteSpace(l.Observ))
            {
              <br /><small style="font-style:italic;color:#c0392b;">@l.Observ</small>
            }
          </td>
          <td class="num">@fmt(l.Stock)</td>
          <td class="num">@fmt(cant)</td>
          <td class="num">$@fmt(subSIva * cant)</td>
          <td class="num" style="font-weight:600;">$@fmt(conIva * cant)</td>
        </tr>
      }
    </tbody>
  </table>

  @* ── Totales ── *@
  <div class="totales">
    <div class="tot-row"><span>Precio s/IVA</span><span>$@fmt(Model.TotPrecioSIva)</span></div>
    <div class="tot-row"><span>Desc / Rec</span><span>$@fmt(Model.TotDescRec)</span></div>
    <div class="tot-row"><span>Subtotal s/IVA</span><span>$@fmt(Model.TotSubtSIva)</span></div>
    <div class="tot-row"><span>IVA @((cab.Iva ?? 0).ToString("N0"))%</span><span>$@fmt(Model.TotIva)</span></div>
    <div class="tot-row total"><span>TOTAL</span><span>$@fmt(Model.TotTotal)</span></div>
  </div>

  @* ── Firma ── *@
  <div class="firma-area">
    <div class="firma-box">
      <div class="firma-linea">Firma y aclaracion</div>
    </div>
  </div>

  @* ── Botones (solo pantalla, ocultos en impresion) ── *@
  <div class="no-print" style="margin-top:1.2rem;display:flex;gap:.5rem;justify-content:flex-end;">
    <button onclick="window.print()"
            style="background:#1a3a5c;color:#fff;border:none;border-radius:6px;padding:.4rem 1.1rem;font-size:11px;font-weight:700;cursor:pointer;">
      Imprimir
    </button>
    <button onclick="window.close()"
            style="background:#858796;color:#fff;border:none;border-radius:6px;padding:.4rem 1rem;font-size:11px;cursor:pointer;">
      Cerrar
    </button>
  </div>
}

</body>
</html>
