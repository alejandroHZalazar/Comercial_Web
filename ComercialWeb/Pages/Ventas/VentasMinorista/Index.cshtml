        <div class="progress" style="height:10px;border-radius:6px;">
          <div id="progVentaBar" class="progress-bar progress-bar-striped progress-bar-animated"
               role="progressbar" style="width:0%;background:linear-gradient(90deg,#1cc88a,#2e6da4);border-radius:6px;"
               aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div id="progVentaDetalle" style="font-size:.74rem;color:#6c757d;margin-top:.5rem;min-height:1em;"></div>
