@page
@model Comercial_Web.Pages.Ventas.VentasMinorista.IndexModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Venta Rápida";
    var p = Model.Params;
}

<style>
/* ── Layout general ───────────────────────────────────────────────── */
.vt-header{background:linear-gradient(135deg,#1a3a5c 0%,#2e6da4 100%);border-radius:12px;padding:1rem 1.5rem;margin-bottom:1.1rem;color:#fff;display:flex;align-items:center;gap:.8rem;}
.vt-header h4{margin:0;font-weight:700;font-size:1.05rem;}
.vt-card{background:#fff;border:1px solid #e3e6f0;border-radius:10px;padding:.85rem 1.1rem;box-shadow:0 2px 8px rgba(0,0,0,.05);margin-bottom:.85rem;}
.vt-label{font-size:.76rem;font-weight:600;color:#5a5c69;margin-bottom:.18rem;display:block;}
.vt-input{font-size:.82rem;}
/* ── Sección cliente ──────────────────────────────────────────────── */
.cli-info{background:#f0f4ff;border:1px solid #b8caff;border-radius:6px;padding:.3rem .7rem;font-size:.78rem;color:#1a3a5c;font-weight:600;min-width:120px;}
/* ── Grilla detalle ──────────────────────────────────────────────── */
#tblDetalle{font-size:.78rem;width:100%;}
#tblDetalle thead tr{background:#1a3a5c;color:#fff;}
#tblDetalle thead th{padding:.38rem .45rem;white-space:nowrap;font-weight:600;}
#tblDetalle tbody tr td{padding:.25rem .4rem;vertical-align:middle;}
#tblDetalle tbody tr:nth-child(even){background:#f8f9fc;}
#tblDetalle tbody tr:hover{background:#eef3ff;}
#tblDetalle input[type=number]{width:80px;font-size:.78rem;padding:.15rem .3rem;border:1px solid #d1d3e2;border-radius:4px;text-align:right;}
/* ── Total ───────────────────────────────────────────────────────── */
.mn-total-panel{background:#1a3a5c;color:#fff;border-radius:10px;padding:.8rem 1.2rem;display:flex;align-items:center;justify-content:space-between;margin-bottom:.85rem;}
.mn-total-lbl{font-size:1rem;font-weight:700;opacity:.85;}
.mn-total-val{font-size:2rem;font-weight:800;letter-spacing:-.02em;}
/* ── Desc/Rec global inline ──────────────────────────────────────── */
.mn-dr-bar{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;background:#fff7e6;border:1px solid #ffc107;border-radius:8px;padding:.4rem .7rem;margin-bottom:.7rem;font-size:.78rem;}
/* ── Autocomplete ────────────────────────────────────────────────── */
.ac-wrap{position:relative;}
.ac-drop{display:none;position:absolute;top:100%;left:0;right:0;z-index:2000;background:#fff;border:1px solid #d1d3e2;border-radius:0 0 8px 8px;max-height:220px;overflow-y:auto;box-shadow:0 6px 18px rgba(0,0,0,.12);}
.ac-drop.open{display:block;}
.ac-item{padding:.3rem .6rem;font-size:.78rem;cursor:pointer;border-bottom:1px solid #f5f5f5;}
.ac-item:hover,.ac-item.active{background:#f0f4ff;}
.ac-item small{display:block;color:#888;font-size:.72rem;}
/* ── Info cliente seleccionado ───────────────────────────────────── */
.cliente-info-vt{background:#f8f9fc;border:1px solid #e3e6f0;border-radius:8px;padding:.55rem .8rem;font-size:.8rem;margin-top:.4rem;}
.ci-row{display:flex;gap:.5rem;margin-bottom:.18rem;align-items:flex-start;}
.ci-lbl{color:#6c757d;min-width:70px;font-size:.74rem;font-weight:600;}
/* ── Botones acción ──────────────────────────────────────────────── */
.btn-vender-mn{background:linear-gradient(135deg,#1cc88a,#13855c);color:#fff;border:none;border-radius:8px;padding:.65rem 2rem;font-size:1.1rem;font-weight:700;cursor:pointer;min-height:52px;transition:opacity .15s;}
.btn-vender-mn:hover{opacity:.88;}
/* ── Alertas ─────────────────────────────────────────────────────── */
#alertDiv{display:none;font-size:.8rem;}
/* ── Modales ─────────────────────────────────────────────────────── */
.modal-header-cli{background:linear-gradient(135deg,#1a3a5c,#2e6da4);padding:.65rem 1rem;}
.modal-section-title{font-size:.72rem;font-weight:700;text-transform:uppercase;color:#6c757d;letter-spacing:.06em;border-bottom:1px solid #e3e6f0;padding-bottom:.2rem;margin-bottom:.5rem;}
/* ── Modal Formas de Pago ─────────────────────────────────────────── */
#modalPagos .modal-header{background:linear-gradient(135deg,#1a3a5c,#2e6da4);color:#fff;padding:.7rem 1rem;}
#modalPagos .modal-body{padding:.9rem 1rem;background:#f8f9fc;}
#modalPagos .modal-footer{background:#f0f2f5;padding:.5rem .8rem;}
.mp-planes-grid{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.8rem;}
.mp-btn-plan{padding:.45rem .9rem;font-size:.82rem;font-weight:600;border-radius:6px;border:2px solid #2e6da4;background:#fff;color:#1a3a5c;cursor:pointer;transition:all .15s;white-space:nowrap;}
.mp-btn-plan:hover{background:#2e6da4;color:#fff;}
.mp-btn-plan.mp-activo{background:#1a3a5c;color:#fff;border-color:#1a3a5c;}
.mp-btn-cc{padding:.45rem .9rem;font-size:.82rem;font-weight:600;border-radius:6px;border:2px solid #6c757d;background:#fff;color:#6c757d;cursor:pointer;transition:all .15s;}
.mp-btn-cc:hover,.mp-btn-cc.mp-activo{background:#6c757d;color:#fff;}
.mp-lista{max-height:180px;overflow-y:auto;margin-top:.4rem;}
.mp-item{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:.35rem .7rem;margin-bottom:.3rem;font-size:.82rem;}
.mp-item-nom{flex:1;font-weight:600;color:#1a3a5c;}
.mp-item-imp{width:90px;text-align:right;color:#2e6da4;font-weight:700;}
.mp-item-del{background:none;border:none;color:#e74a3b;cursor:pointer;font-size:1rem;padding:0 .2rem;line-height:1;}
.mp-refs{display:flex;gap:.4rem;margin-top:.5rem;flex-wrap:wrap;}
.mp-refs input{flex:1;min-width:90px;}
.mp-saldo-bar{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #dee2e6;border-radius:6px;padding:.3rem .7rem;font-size:.82rem;margin-bottom:.6rem;}
.mp-saldo-bar .mp-saldo-val{font-weight:700;font-size:.95rem;}
</style>

@* ══ HEADER ══════════════════════════════════════════════════════════════ *@
<div class="vt-header">
  <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="26" height="26">
    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
  </svg>
  <h4>Venta Rápida</h4>
</div>

@* ══ ALERTA ════════════════════════════════════════════════════════════════ *@
<div id="alertDiv" class="alert alert-danger alert-dismissible" role="alert">
  <span id="alertMsg"></span>
  <button type="button" class="btn-close" onclick="document.getElementById('alertDiv').style.display='none'"></button>
</div>

@* ══ CLIENTE ═══════════════════════════════════════════════════════════════ *@
<div class="vt-card">
  <div class="row g-2">
    <div class="col-12">
      <label class="vt-label">Buscar Cliente</label>
      <div class="ac-wrap mb-2">
        <input type="text" id="txtBuscarCliente" class="form-control form-control-sm vt-input"
               placeholder="Buscar cliente por nombre..." autocomplete="off"
               oninput="onClienteInput(this.value)" onkeydown="onClienteKeydown(event)" />
        <div id="dropClientes" class="ac-drop"></div>
      </div>
      <div style="display:flex;gap:.4rem;margin-bottom:.5rem;">
        <button type="button" class="btn btn-sm btn-outline-success" style="font-size:.78rem;" onclick="abrirModalCli()">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="12" height="12" style="vertical-align:-.1em;margin-right:.25rem;"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664h10z"/></svg>
          Nuevo Cliente
        </button>
      </div>
      <div id="clienteInfo" style="display:none;">
        <div class="cliente-info-vt">
          <div class="ci-row"><span class="ci-lbl">Nombre</span><strong id="ci-nombre"></strong></div>
          <div class="ci-row"><span class="ci-lbl">Teléfono</span><span id="ci-telefono"></span></div>
          <div class="ci-row"><span class="ci-lbl">Dirección</span><span id="ci-direccion"></span></div>
          <div class="ci-row"><span class="ci-lbl">Cond. IVA</span><span id="ci-condiva"></span></div>
        </div>
      </div>
      <div id="clienteVacio" style="@(p.TieneConsumidorFinal == 1 ? "display:none;" : "")color:#aaa;font-size:.78rem;padding:.4rem 0;">
        Busque o cree un cliente para comenzar.
      </div>
    </div>
  </div>
</div>
<input type="hidden" id="hClienteId" value="@(p.TieneConsumidorFinal == 1 ? p.ClienteConsumidorFinal.ToString() : "0")" />

@* ══ BÚSQUEDA POR CÓDIGO DE BARRAS ════════════════════════════════════════ *@
<div class="vt-card">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="vt-label">Cód. Barras / Descripción</label>
      <input type="text" id="txtBusqCB" class="form-control form-control-sm vt-input"
             placeholder="@(p.TieneLectoraCB == 1 ? "Lector de cód. barras…" : "Código de barras o descripción…")" autocomplete="off"
             onkeydown="onBusqCBKeydown(event)" />
    </div>
    <div class="col-md-4">
      <label class="vt-label">Descripción</label>
      <div class="ac-wrap">
        <input type="text" id="txtBusqDesc" class="form-control form-control-sm vt-input"
               placeholder="Buscar por descripción…" autocomplete="off"
               oninput="buscarProductoDesc()"
               onkeydown="onBusqDescKeydown(event)" />
        <div class="ac-list" id="acDesc" style="position:absolute;top:100%;left:0;right:0;z-index:1200;background:#fff;border:1px solid #d1d3e2;border-radius:0 0 8px 8px;box-shadow:0 4px 12px rgba(0,0,0,.1);max-height:180px;overflow-y:auto;display:none;"></div>
      </div>
    </div>
  </div>
</div>

@* ══ GRILLA DETALLE ════════════════════════════════════════════════════════ *@
<div class="vt-card" style="padding:.6rem .8rem;">
  <div class="table-responsive">
    <table id="tblDetalle" class="table table-bordered table-sm mb-0">
      <thead>
        <tr>
          <th style="width:120px;">Cód. Barras</th>
          <th>Descripción</th>
          <th style="text-align:right;width:95px;">Cant.</th>
          <th style="text-align:right;width:100px;">Precio unit.</th>
          <th style="text-align:right;width:100px;">Precio c/desc</th>
          <th style="text-align:right;width:100px;">Subtotal</th>
          <th style="text-align:center;width:36px;"></th>
        </tr>
      </thead>
      <tbody id="tbodyDetalle">
        <tr id="rowVacio">
          <td colspan="7" style="text-align:center;padding:1.2rem;color:#aaa;font-size:.8rem;">
            Escanee o busque un producto para comenzar.
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

@* ══ DESC/REC GLOBAL ════════════════════════════════════════════════════════ *@
<div class="mn-dr-bar" id="mnDrBar">
  <span style="font-size:.75rem;font-weight:700;color:#856404;">Desc/Rec global:</span>
  <select id="mnDrMode" class="form-select form-select-sm" style="width:110px;font-size:.76rem;">
    <option value="desc">▼ Descuento</option>
    <option value="rec">▲ Recargo</option>
  </select>
  <input type="number" id="mnDrPct" class="form-control form-control-sm" style="width:75px;font-size:.82rem;" value="0" min="0" max="100" step="0.01" />
  <span style="font-size:.73rem;color:#856404;">%</span>
  <button type="button" class="btn btn-sm btn-warning" style="font-size:.75rem;" onclick="mnAplicarDr()">Aplicar</button>
  <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.75rem;" onclick="mnLimpiarDr()">Limpiar</button>
</div>

@* ══ FORMAS DE PAGO — datos JSON para JS ════════════════════════════════ *@
@if (p.TieneMediosPagos == 1 || p.LlevaCC == 1)
{
  <script id="jsPlanesPago" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanesPago, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
  </script>
}

@* ══ TOTAL + BOTONES ════════════════════════════════════════════════════ *@
<div class="mn-total-panel">
  <span class="mn-total-lbl">TOTAL</span>
  <span class="mn-total-val" id="tot-total">$0,00</span>
</div>
<div style="display:flex;gap:.6rem;justify-content:flex-end;margin-bottom:1.5rem;">
  <button type="button" onclick="vender()" class="btn-vender-mn">
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" style="margin-right:.4rem;vertical-align:-.1em;"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/></svg>
    Confirmar Venta (F5)
  </button>
  <button type="button" onclick="limpiarFormulario()" class="btn btn-sm" style="font-size:.82rem;background:#6c757d;color:#fff;border:none;">
    Limpiar
  </button>
</div>

@* ══ MODAL: FORMAS DE PAGO ════════════════════════════════════════════════ *@
<div class="modal fade" id="modalPagos" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">
      <div class="modal-header">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="17" height="17" class="me-2"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2.5 1a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-2z"/></svg>
        <h5 class="modal-title mb-0">Formas de Pago</h5>
        <button type="button" class="btn-close btn-close-white ms-auto" onclick="mpCancelar()"></button>
      </div>
      <div class="modal-body">
        <div class="mp-saldo-bar">
          <span>Total: <strong id="mpTotal">$0,00</strong></span>
          <span>Pagado: <strong id="mpPagado" style="color:#1cc88a;">$0,00</strong></span>
          <span>Saldo: <strong id="mpSaldoVal" class="mp-saldo-val" style="color:#e74a3b;">$0,00</strong></span>
        </div>
        <div id="mpListaFps" class="mp-lista"></div>
        @* ── Sección de vuelto ── *@
        <div id="mpVueltoWrap" style="display:none;background:#fff3cd;border-radius:6px;padding:.4rem .7rem;margin-bottom:.5rem;">
          <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;">
            <span style="font-size:.82rem;font-weight:700;">Monto recibido:</span>
            <input type="number" id="txtMontoRecibido" class="form-control form-control-sm"
                   style="width:130px;" min="0" step="0.01" placeholder="0,00" />
            <span style="font-size:.82rem;margin-left:.2rem;">Vuelto:
              <strong id="lblVuelto" style="font-size:1rem;color:#1cc88a;">$0,00</strong>
            </span>
          </div>
        </div>
        <hr style="margin:.5rem 0;">
        <div style="font-size:.78rem;font-weight:700;color:#5a5c69;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem;">Seleccionar forma de pago</div>
        <div id="mpPlanesGrid" class="mp-planes-grid"></div>
        <div id="mpCCRow" style="display:none;margin-bottom:.5rem;">
          <button class="mp-btn-cc" id="mpBtnCC" onclick="mpAgregarCC()">Cuenta Corriente</button>
        </div>
        <div id="mpDetalleForm" style="display:none;">
          <div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:.4rem;">
            <div id="mpImporteWrap" style="display:none;">
              <label class="vt-label">Importe</label>
              <input type="number" id="mpImporte" class="form-control form-control-sm" style="width:120px;" min="0" step="0.01" placeholder="0.00" />
            </div>
            <div id="mpRef1Wrap" style="display:none;">
              <label class="vt-label">Ref. 1</label>
              <input type="text" id="mpRef1" class="form-control form-control-sm" style="width:130px;" />
            </div>
            <div id="mpRef2Wrap" style="display:none;">
              <label class="vt-label">Ref. 2</label>
              <input type="text" id="mpRef2" class="form-control form-control-sm" style="width:130px;" />
            </div>
            <div id="mpRef3Wrap" style="display:none;">
              <label class="vt-label">Ref. 3</label>
              <input type="text" id="mpRef3" class="form-control form-control-sm" style="width:130px;" />
            </div>
            <button class="btn btn-sm btn-primary" onclick="mpConfirmarItem()">+ Agregar</button>
          </div>
        </div>
        <div style="font-size:.74rem;color:#888;margin-top:.2rem;" id="mpShortcutsHint"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" onclick="mpCancelar()">Cancelar</button>
        <button type="button" class="btn btn-primary btn-sm" id="mpBtnConfirmar" onclick="mpConfirmarVenta()">Confirmar venta (Enter)</button>
      </div>
    </div>
  </div>
</div>

@* ══ MODAL: NUEVO CLIENTE ════════════════════════════════════════════════ *@
<div class="modal fade" id="modalNuevoCli" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">
      <div class="modal-header modal-header-cli">
        <span style="color:#fff;font-weight:700;font-size:.95rem;">Agregar Nuevo Cliente</span>
        <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="padding:1rem 1.25rem;">
        <div id="cliAlertDiv" class="alert alert-danger" style="display:none;font-size:.8rem;"></div>
        <p class="modal-section-title">Datos Generales</p>
        <div class="row g-2">
          <div class="col-md-6"><label class="vt-label">Nombre Comercial *</label><input type="text" id="cliNombreComercial" class="form-control form-control-sm" /></div>
          <div class="col-md-6"><label class="vt-label">Razón Social</label><input type="text" id="cliRazonSocial" class="form-control form-control-sm" /></div>
          <div class="col-md-4"><label class="vt-label">CUIL</label><input type="text" id="cliCuil" class="form-control form-control-sm" /></div>
          <div class="col-md-8"><label class="vt-label">Dirección</label><input type="text" id="cliDireccion" class="form-control form-control-sm" /></div>
        </div>
        <p class="modal-section-title mt-3">Contacto</p>
        <div class="row g-2">
          <div class="col-md-4"><label class="vt-label">Email</label><input type="email" id="cliEmail" class="form-control form-control-sm" /></div>
          <div class="col-md-4"><label class="vt-label">Teléfono</label><input type="text" id="cliTelefono" class="form-control form-control-sm" /></div>
          <div class="col-md-4"><label class="vt-label">Celular</label><input type="text" id="cliCelular" class="form-control form-control-sm" /></div>
        </div>
        <p class="modal-section-title mt-3">Clasificación</p>
        <div class="row g-2">
          <div class="col-md-4">
            <label class="vt-label">Condición IVA</label>
            <select id="cliCondIva" class="form-select form-select-sm">
              @foreach (var ci in Model.ListaCondIvas) { <option value="@ci.Value">@ci.Text</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="vt-label">Vendedor</label>
            <select id="cliVendedor" class="form-select form-select-sm">
              @foreach (var v3 in Model.ListaVendedores) { <option value="@v3.Value">@v3.Text</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="vt-label">Localidad</label>
            <select id="cliLocalidad" class="form-select form-select-sm">
              @foreach (var loc in Model.ListaLocalidades) { <option value="@loc.Value">@loc.Text</option> }
            </select>
          </div>
          <div class="col-md-4">
            <label class="vt-label">Zona</label>
            <select id="cliZona" class="form-select form-select-sm">
              @foreach (var z in Model.ListaZonas) { <option value="@z.Value">@z.Text</option> }
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="background:#f8f9fc;border-top:1px solid #e3e6f0;">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-sm btn-success" onclick="guardarNuevoCliente()">Guardar Cliente</button>
      </div>
    </div>
  </div>
</div>

@* ══ MODAL: PROGRESO VENTA ════════════════════════════════════════════════ *@
<div class="modal fade" id="modalProgresoVenta" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content" style="border-radius:12px;overflow:hidden;">
      <div style="background:linear-gradient(135deg,#1a3a5c,#2e6da4);padding:.7rem 1rem;display:flex;align-items:center;gap:.6rem;color:#fff;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="18" height="18"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/></svg>
        <span style="font-weight:700;font-size:.9rem;">Registrando Venta</span>
