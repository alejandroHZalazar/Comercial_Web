};

window.mpCancelar = function(){
  _formasPago=[];
  _mpPlanActual=null;
  bootstrap.Modal.getInstance(document.getElementById('modalPagos'))?.hide();
};

window.mpConfirmarVenta = function(){
  if (IMPUTA_VENTA===1){
    if (!_formasPago.length){ showAlert('Agregue al menos una forma de pago.'); return; }
    var saldo=_mpCalcSaldo();
    if (saldo>0.02){ showAlert('Saldo pendiente: $'+fmt(saldo)+'. Complete el pago antes de confirmar.'); return; }
  } else {
    if (!_formasPago.length){ showAlert('Seleccione una forma de pago.'); return; }
  }
  bootstrap.Modal.getInstance(document.getElementById('modalPagos'))?.hide();
  if (IMPUTA_VENTA!==1 && _formasPago.length>0){
    var total=_mpCalcTotal();
    var share=total/_formasPago.length;
    _formasPago.forEach(function(fp){ fp.importe=share; });
  }
  grabarVenta();
};

function _mpAbrirModal(){
  _formasPago=[];
  _mpPlanActual=null;
  _mpRenderLista();
  _mpActualizarBarra();
  _mpRenderBotones();
  document.getElementById('mpCCRow').style.display=LLEVA_CC===1?'':'none';
  document.getElementById('mpDetalleForm').style.display='none';
  // Mostrar sección de vuelto
  document.getElementById('mpVueltoWrap').style.display='';
  document.getElementById('txtMontoRecibido').value='';
  document.getElementById('lblVuelto').textContent='$0,00';
  new bootstrap.Modal(document.getElementById('modalPagos')).show();
  if (_planesPago.length===1){ _mpSeleccionarPlan(_planesPago[0]); }
}

// ── Cálculo de vuelto ──────────────────────────────────────────────────────
function _mnActualizarVuelto(){
  var el = document.getElementById('txtMontoRecibido');
  if (!el || document.getElementById('mpVueltoWrap').style.display === 'none') return;
  var recibido = parseFloat(el.value.replace(',','.')) || 0;
  var total    = _mpCalcTotal();
  var vuelto   = recibido - total;
  var lblVuelto = document.getElementById('lblVuelto');
  lblVuelto.textContent = '$' + fmt(Math.max(0, vuelto));
  lblVuelto.style.color = vuelto >= 0 ? '#1cc88a' : '#e74a3b';
}

// Listener del campo vuelto (se adjunta una vez)
document.getElementById('txtMontoRecibido').addEventListener('input', function(){
  _mnActualizarVuelto();
});

// Keyboard shortcuts dentro del modal pagos
document.getElementById('modalPagos').addEventListener('keydown', function(e){
  if (!document.getElementById('modalPagos').classList.contains('show')) return;

  var activeEl = document.activeElement;
  var enInput  = activeEl &&
                 (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA') &&
                 activeEl.offsetParent !== null;
  if (enInput){
    if (e.key === 'Enter'){  e.preventDefault(); mpConfirmarItem(); }
    if (e.key === 'Escape'){ e.preventDefault(); activeEl.blur(); document.getElementById('modalPagos').focus(); }
    return;
  }

  var num = parseInt(e.key);
  if (num >= 1 && num <= 9 && num <= _planesPago.length){
    e.preventDefault();
    _mpSeleccionarPlan(_planesPago[num-1]);
  }
  if ((e.key === 'c' || e.key === 'C') && LLEVA_CC===1){ e.preventDefault(); mpAgregarCC(); }
  if (e.key === 'Enter') { e.preventDefault(); mpConfirmarVenta(); }
  if (e.key === 'Escape'){ e.preventDefault(); mpCancelar(); }
});

