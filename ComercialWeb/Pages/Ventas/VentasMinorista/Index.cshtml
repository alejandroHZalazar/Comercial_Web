  document.querySelectorAll('.mp-btn-cc').forEach(function(b){ b.classList.add('mp-activo'); });
  document.querySelectorAll('.mp-btn-plan').forEach(function(b){ b.classList.remove('mp-activo'); });
  _mpPlanActual = pl;
  var df = document.getElementById('mpDetalleForm');
  df.style.display='';
  var iw=document.getElementById('mpImporteWrap');
  iw.style.display=IMPUTA_VENTA===1?'':'none';
  if (IMPUTA_VENTA===1){
    var impEl=document.getElementById('mpImporte');
    var saldo=_mpCalcSaldo();
    impEl.value=saldo>0.005?saldo.toFixed(2):'';
    impEl.focus();
    impEl.select();
  }
  document.getElementById('mpRef1Wrap').style.display='none';
  document.getElementById('mpRef2Wrap').style.display='none';
