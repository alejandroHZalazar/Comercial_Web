@section Scripts {
<script>
(function(){
'use strict';

// ── Estado global ──────────────────────────────────────────────────────────
var _rows          = [];
var _clienteId     = @(p.TieneConsumidorFinal == 1 ? p.ClienteConsumidorFinal : 0);
var _drGlobal      = 0;           // desc/rec global (negativo=desc, positivo=rec)

// ── Constantes del modelo ──────────────────────────────────────────────────
var TIENE_CB       = @p.TieneLectoraCB;
var TIENE_MEDPAG   = @p.TieneMediosPagos;
var IMPUTA_VENTA   = @p.ImputaEnVenta;
var LLEVA_CC       = @p.LlevaCC;
var ID_PLAN_EFEC   = @p.IdPlanEfectivo;
var DEC            = @p.Decimales;
var DEC_CANT       = @p.DecimalesCant;
var TIENE_PRODUCTOS_BALANZA = @p.TieneProductosBalanza;
var PREFIJO_BALANZA         = '@Html.Raw(p.PrefijoBalanza.Replace("'", "\\'"))';
var POSICION_PRODUCTO       = '@Html.Raw(p.PosicionProducto.Replace("'", "\\'"))';
var POSICION_PRECIO         = '@Html.Raw(p.PosicionPrecio.Replace("'", "\\'"))';
var DIVISOR_PRECIO          = @(decimal.TryParse(p.DivisorPrecio, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var dpv2) && dpv2 > 0 ? dpv2.ToString(System.Globalization.CultureInfo.InvariantCulture) : "1");
var VENDEDOR_ID    = @Model.VendedorAdminId;
var HACE_NOTA_VENTA_TK = @p.HaceNotaVentaTK;

// ── Formateadores ──────────────────────────────────────────────────────────
function fmt(n){ return new Intl.NumberFormat('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2}).format(n??0); }
function fmtN(n,d){ return new Intl.NumberFormat('es-AR',{minimumFractionDigits:d,maximumFractionDigits:d}).format(n??0); }
function fmtInp(n,d){ return (+(n||0)).toFixed(d); }
function escHtml(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── Cliente ────────────────────────────────────────────────────────────────
var _cliTimer = null;
var _cliSelIdx = -1;
var _cliResults = [];

window.onClienteInput = function(val){
  clearTimeout(_cliTimer);
  _cliSelIdx = -1;
  if (val.length < 2){ cerrarDropCli(); return; }
  _cliTimer = setTimeout(function(){ fetchClientes(val); }, 300);
};

window.onClienteKeydown = function(e){
  var drop  = document.getElementById('dropClientes');
  var items = drop.querySelectorAll('.ac-item');
  if (e.key === 'ArrowDown'){ e.preventDefault(); _cliSelIdx = Math.min(_cliSelIdx+1, items.length-1); highlightCli(items); }
  else if (e.key === 'ArrowUp'){ e.preventDefault(); _cliSelIdx = Math.max(_cliSelIdx-1, 0); highlightCli(items); }
  else if (e.key === 'Enter'){ e.preventDefault(); if (_cliSelIdx >= 0 && _cliResults[_cliSelIdx]) seleccionarCliente(_cliResults[_cliSelIdx]); }
  else if (e.key === 'Escape') cerrarDropCli();
};

function highlightCli(items){
  items.forEach(function(it,i){ it.classList.toggle('active', i === _cliSelIdx); });
  if (items[_cliSelIdx]) items[_cliSelIdx].scrollIntoView({block:'nearest'});
}

async function fetchClientes(q){
  var resp = await fetch('?handler=BuscarClientes&q=' + encodeURIComponent(q));
  _cliResults = await resp.json();
  var drop = document.getElementById('dropClientes');
  if (!_cliResults.length){ cerrarDropCli(); return; }
  drop.innerHTML = _cliResults.map(function(c,i){
    return '<div class="ac-item" data-idx="' + i + '">'
      + '<strong>' + escHtml(c.nombreComercial||'') + '</strong>'
      + '<small>' + escHtml(c.direccionFull||'') + '</small>'
      + '</div>';
  }).join('');
  drop.querySelectorAll('.ac-item').forEach(function(el){
    el.addEventListener('click', function(){ seleccionarCliente(_cliResults[parseInt(el.dataset.idx)]); });
  });
  drop.classList.add('open');
}

window.seleccionarCliente = function(c){
  if (typeof c === 'string') c = JSON.parse(c);
  _clienteId = c.clienteId;
  document.getElementById('hClienteId').value = c.clienteId;
  document.getElementById('txtBuscarCliente').value = '';
  cerrarDropCli();
  document.getElementById('ci-nombre').textContent    = c.nombreComercial || '';
  document.getElementById('ci-telefono').textContent  = c.telefono        || '--';
  document.getElementById('ci-direccion').textContent = c.direccionFull   || '--';
  document.getElementById('ci-condiva').textContent   = c.condIvaDescripcion || c.condIvaAbrev || '';
  document.getElementById('clienteInfo').style.display  = 'block';
  document.getElementById('clienteVacio').style.display = 'none';
};

function cerrarDropCli(){
  var drop = document.getElementById('dropClientes');
  drop.classList.remove('open');
  drop.innerHTML = '';
}

async function cargarClientePorId(id){
  var resp = await fetch('?handler=ClienteData&id=' + id);
  var r    = await resp.json();
  if (!r.ok) return;
  var d = r.data;
  _clienteId = d.id;
  document.getElementById('hClienteId').value = d.id;
  document.getElementById('ci-nombre').textContent    = d.nombreComercial || '';
  document.getElementById('ci-telefono').textContent  = d.telefono        || '--';
  document.getElementById('ci-direccion').textContent = d.direccionFull   || '--';
  document.getElementById('ci-condiva').textContent   = d.condIvaDescripcion || d.condIvaAbrev || '';
  document.getElementById('clienteInfo').style.display  = 'block';
  document.getElementById('clienteVacio').style.display = 'none';
}

// ── Nuevo Cliente ──────────────────────────────────────────────────────────
window.abrirModalCli = function(){
  document.querySelectorAll('#modalNuevoCli input, #modalNuevoCli select').forEach(el=>{
    if(el.tagName==='INPUT') el.value='';
  });
  document.getElementById('cliAlertDiv').style.display='none';
  new bootstrap.Modal(document.getElementById('modalNuevoCli')).show();
};

window.guardarNuevoCliente = async function(){
  var nom = document.getElementById('cliNombreComercial').value.trim();
  if (!nom){ showCliError('El nombre comercial es obligatorio.'); return; }
  var dto = {
    nombreComercial: nom,
    razonSocial: document.getElementById('cliRazonSocial').value.trim(),
    cuil: document.getElementById('cliCuil').value.trim(),
    direccion: document.getElementById('cliDireccion').value.trim(),
    email: document.getElementById('cliEmail').value.trim(),
    telefono: document.getElementById('cliTelefono').value.trim(),
    celular: document.getElementById('cliCelular').value.trim(),
    fkCondIva: parseInt(document.getElementById('cliCondIva').value)||0,
    fkVendedor: parseInt(document.getElementById('cliVendedor').value)||0,
    fkLocalidad: parseInt(document.getElementById('cliLocalidad').value)||0,
    fkZona: parseInt(document.getElementById('cliZona').value)||0
  };
  try{
    var resp = await fetch('?handler=CrearClienteRapido', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dto) });
    var ct = resp.headers.get('Content-Type')||'';
    if (!ct.includes('json')){ showCliError('Error del servidor: '+(await resp.text()).substring(0,300)); return; }
    var r = await resp.json();
    if (!r.ok){ showCliError(r.msg||'Error al guardar.'); return; }
    bootstrap.Modal.getInstance(document.getElementById('modalNuevoCli'))?.hide();
    seleccionarCliente({ clienteId: r.clienteId, nombreComercial: r.nombreComercial, telefono: r.telefono||'', direccionFull: '', condIvaAbrev: '' });
  } catch(ex){ showCliError('Error: '+ex.message); }
};
function showCliError(msg){ var el=document.getElementById('cliAlertDiv'); el.textContent=msg; el.style.display=''; }

// ── Búsqueda de productos ──────────────────────────────────────────────────
async function _buscarProducto(q, tipo){
  if (!q) return [];
  var url = '?handler=BuscarProductos&q='+encodeURIComponent(q)+'&tipo='+tipo+'&proveedores=';
  try {
    return await (await fetch(url)).json();
  } catch (ex){
    return [];
  }
}

function _agregarOSumar(prod, cantidad){
  var existente = _rows.find(r=>r.fkProducto===prod.productoId);
  if (existente){
    existente.cantidad = (+existente.cantidad||0) + (+cantidad||0);
    recalcularFila(existente);
  } else {
    var row = {
      fkProducto  : prod.productoId,
      codBarras   : prod.codBarras   || '',
      codProveedor: prod.codProveedor|| '',
      descripcion : prod.descripcion || '',
      precioSinIva: prod.precioSinIva|| 0,
      descRec     : _drGlobal,
      cantidad    : +cantidad || 0,
      stock       : prod.stock       || 0,
      fraccionado : prod.fraccionado || false,
      costo       : prod.costo       || 0,
      dolarizado  : prod.dolarizado  || false,
      sel         : false
    };
    recalcularFila(row);
    _rows.push(row);
  }
  renderGrilla();
}

// ── Balanza: helpers ────────────────────────────────────────────────────────
function esCodigoBalanza(codigo, prefijo){
  if (!codigo || !prefijo) return false;
  return codigo.length === 13 && codigo.startsWith(prefijo);
}

function extraerPorPosicion(codigo, posicion){
  if (!posicion) return '';
  var partes = posicion.split(',');
  if (partes.length < 2) return '';
  var ini = parseInt(partes[0].trim(), 10) - 1;
  var fin = parseInt(partes[1].trim(), 10);
  if (isNaN(ini) || isNaN(fin) || ini < 0 || fin <= ini) return '';
  return codigo.substring(ini, fin);
}

// ── Cód. Barras ────────────────────────────────────────────────────────────
window.onBusqCBKeydown = async function(e){
  if (e.key === 'Escape'){ e.target.value=''; return; }
  if (e.key !== 'Enter') return;
  e.preventDefault();
  var inp = document.getElementById('txtBusqCB');
  var raw = inp.value.trim();
  if (!raw) return;

  // ── Balanza: prioridad máxima ────────────────────────────────────────────
  if (TIENE_CB === 1 && TIENE_PRODUCTOS_BALANZA === 1 && esCodigoBalanza(raw, PREFIJO_BALANZA)){
    if (!PREFIJO_BALANZA || !POSICION_PRODUCTO || !POSICION_PRECIO || DIVISOR_PRECIO <= 0){
      showAlert('Para operar con productos de balanza debe parametrizar: Prefijo, Posición de Producto, Posición de Importe y Divisor de Importe.');
      return;
    }
    var codProdBal = extraerPorPosicion(raw, POSICION_PRODUCTO);
    if (!codProdBal){ showAlert('No se pudo extraer el código de producto del código de balanza.'); return; }

    var listaBal = await _buscarProducto(codProdBal.trim(), 'codBarras');
    if (!listaBal.length){ showAlert('Producto de balanza no encontrado: ' + codProdBal.trim()); inp.select(); return; }
    var prodBal = listaBal[0];

    var precioStrBal  = extraerPorPosicion(raw, POSICION_PRECIO);
    var precioBalanza = precioStrBal ? parseFloat(precioStrBal) / DIVISOR_PRECIO : 0;

    var cantBal;
    if (precioBalanza > 0){
      var precioConIvaBal = prodBal.precioSinIva || 0;   // IVA=0 en minorista
      cantBal = precioConIvaBal > 0 ? precioBalanza / precioConIvaBal : 1;
    } else {
      cantBal = 1;
    }

    _agregarOSumar(prodBal, cantBal);
    inp.value = '';
    inp.focus();
    return;
  }

  // ── Soporte "<cantidad|importe>*<codigo>" ────────────────────────────────
  var q = raw;
  var cantPrefijo = null;
  var idxAst = raw.indexOf('*');
  if (idxAst >= 0){
    var pref  = raw.substring(0, idxAst).trim().replace(',', '.');
    var resto = raw.substring(idxAst + 1).trim();
    if (!resto){ showAlert('Ingrese un código de barras después del asterisco.'); inp.select(); return; }
    var n = parseFloat(pref);
    cantPrefijo = (isFinite(n) && n > 0) ? n : 1;
    q = resto;
  }

  var lista = await _buscarProducto(q, 'codBarras');
  if (!lista.length){ showAlert('Producto no encontrado por código de barras.'); inp.select(); return; }
  var prod = lista[0];

  if (cantPrefijo !== null){
    var cantEfectiva;
    if (prod.fraccionado){
      var precioConIvaFrac = prod.precioSinIva || 0;  // IVA=0
      cantEfectiva = precioConIvaFrac > 0 ? cantPrefijo / precioConIvaFrac : 1;
    } else {
      cantEfectiva = cantPrefijo;
    }
    _agregarOSumar(prod, cantEfectiva);
  } else {
    // En modo kiosco siempre sumamos 1 (sin importar TIENE_CB)
    _agregarOSumar(prod, 1);
  }
  inp.value = '';
  inp.focus();
};

// ── Descripción (autocomplete) ─────────────────────────────────────────────
var _descTimer   = null;
var _descResults = [];
var _descSelIdx  = -1;

window.buscarProductoDesc = function(){
  clearTimeout(_descTimer);
  var q = document.getElementById('txtBusqDesc').value.trim();
  var ac = document.getElementById('acDesc');
  if (q.length < 2){
    ac.style.display='none'; ac.innerHTML='';
    _descResults=[]; _descSelIdx=-1;
    return;
  }
  _descTimer = setTimeout(async()=>{
    var lista = await _buscarProducto(q, 'descripcion');
    _descResults = lista;
    _descSelIdx  = -1;
    ac.innerHTML = '';
    if (!lista.length){ ac.style.display='none'; return; }
    lista.forEach((prod, idx)=>{
      var d = document.createElement('div');
      d.className='ac-item';
      d.innerHTML =
        '<strong>'+escHtml(prod.descripcion||'')+'</strong>'+
        '<small>'+
          'Cód.Barras: '+escHtml(prod.codBarras||'-')+
          ' | P.Unit: $'+fmt(prod.precioSinIva)+
        '</small>';
      d.onclick    = ()=>{ _descSelIdx=idx; _seleccionarProdDesc(); };
      ac.appendChild(d);
    });
    ac.style.display='block';
  }, 280);
};

function _seleccionarProdDesc(){
  if (_descSelIdx < 0 || _descSelIdx >= _descResults.length) return;
  var prod = _descResults[_descSelIdx];
  document.getElementById('txtBusqDesc').value = '';
  var ac = document.getElementById('acDesc');
  ac.style.display='none'; ac.innerHTML='';
  _descResults = []; _descSelIdx = -1;
  _agregarOSumar(prod, 1);
}

window.onBusqDescKeydown = function(e){
  var ac = document.getElementById('acDesc');
  var items = ac.querySelectorAll('.ac-item');
  if (e.key === 'ArrowDown'){
    if (!items.length) return;
    e.preventDefault();
    _descSelIdx = Math.min(_descSelIdx+1, items.length-1);
    items.forEach(it=>it.classList.remove('active'));
    items[_descSelIdx].classList.add('active');
    items[_descSelIdx].scrollIntoView({block:'nearest'});
  } else if (e.key === 'ArrowUp'){
    if (!items.length) return;
    e.preventDefault();
    _descSelIdx = Math.max(_descSelIdx-1, 0);
    items.forEach(it=>it.classList.remove('active'));
    items[_descSelIdx].classList.add('active');
    items[_descSelIdx].scrollIntoView({block:'nearest'});
  } else if (e.key === 'Enter'){
    e.preventDefault();
    if (_descSelIdx >= 0){ _seleccionarProdDesc(); return; }
    if (_descResults.length === 1){ _descSelIdx = 0; _seleccionarProdDesc(); return; }
  } else if (e.key === 'Escape'){
    ac.style.display='none'; ac.innerHTML='';
    _descResults=[]; _descSelIdx=-1;
  }
};

// ── Recalcular fila (IVA=0 siempre) ───────────────────────────────────────
function recalcularFila(row){
  var dr = row.descRec || 0;
  row.subtotalSIva = row.precioSinIva * (1 + dr / 100);
  row.precioConIva = row.subtotalSIva;   // IVA = 0
  row.subtotal     = row.precioConIva * row.cantidad;
}

// ── Render grilla ─────────────────────────────────────────────────────────
function renderGrilla(){
  var tbody = document.getElementById('tbodyDetalle');
  var vacio = document.getElementById('rowVacio');
  tbody.querySelectorAll('tr.data-row').forEach(r=>r.remove());

  if (!_rows.length){ vacio.style.display=''; recalcularTotales(); return; }
  vacio.style.display='none';

  _rows.forEach((row, idx)=>{
    var tr = document.createElement('tr');
    tr.className='data-row';
    tr.innerHTML =
      '<td style="font-size:.75rem;">'+escHtml(row.codBarras||'')+'</td>'+
      '<td>'+escHtml(row.descripcion||'')+'</td>'+
      '<td style="text-align:right;">'+
        '<input type="number" class="inp-cant" style="width:80px;font-size:.76rem;text-align:right;" value="'+fmtInp(row.cantidad,DEC_CANT)+'" step="any" onchange="onChangeCant('+idx+',this.value)" onkeydown="onCantKeydown(event,'+idx+')" />'+
      '</td>'+
      '<td style="text-align:right;">$'+fmt(row.precioSinIva)+'</td>'+
      '<td style="text-align:right;'+(row.descRec<0?'color:#c0392b;':row.descRec>0?'color:#1a7a45;':'')+'">$'+fmt(row.precioConIva)+'</td>'+
      '<td style="text-align:right;font-weight:600;">$'+fmt(row.subtotal)+'</td>'+
      '<td style="text-align:center;">'+
        '<button type="button" onclick="eliminarFila('+idx+')" style="background:none;border:none;color:#e74a3b;font-size:.9rem;cursor:pointer;padding:0 .2rem;" title="Eliminar">✕</button>'+
      '</td>';
    tbody.appendChild(tr);
  });
  recalcularTotales();
}

// ── Eventos de fila ────────────────────────────────────────────────────────
window.onChangeCant = function(idx,val){
  _rows[idx].cantidad = parseFloat(val)||0;
  recalcularFila(_rows[idx]);
  renderGrilla();
};
window.onCantKeydown = function(e, idx){
  if (e.key!=='Enter') return;
  e.preventDefault();
  setTimeout(()=>{ var el=document.getElementById('txtBusqCB'); if(el) el.focus(); }, 30);
};
window.eliminarFila = function(idx){ _rows.splice(idx,1); renderGrilla(); };

// ── Desc/Rec global ────────────────────────────────────────────────────────
window.mnAplicarDr = function(){
  var pct  = parseFloat(document.getElementById('mnDrPct').value)||0;
  var mode = document.getElementById('mnDrMode').value;
  _drGlobal = mode === 'desc' ? -Math.abs(pct) : Math.abs(pct);
  _rows.forEach(r=>{ r.descRec = _drGlobal; recalcularFila(r); });
  renderGrilla();
};
window.mnLimpiarDr = function(){
  _drGlobal = 0;
  document.getElementById('mnDrPct').value = '0';
  _rows.forEach(r=>{ r.descRec = 0; recalcularFila(r); });
  renderGrilla();
};

// ── Totales ────────────────────────────────────────────────────────────────
function recalcularTotales(){
  var total = _rows.reduce(function(a,r){ return a + (r.subtotal||0); }, 0);
  document.getElementById('tot-total').textContent = '$' + fmt(total);
  actualizarResumenPago(total);
}

// ── Formas de pago — Modal ─────────────────────────────────────────────────
var _planesPago = (TIENE_MEDPAG===1||LLEVA_CC===1)
  ? JSON.parse(document.getElementById('jsPlanesPago')?.textContent || '[]')
  : [];
var _formasPago = [];
var _mpPlanActual = null;

function _mpCalcTotal(){
  return _rows.reduce(function(a,r){ return a + (r.subtotal||0); }, 0);
}

function _mpCalcSaldo(){
  var total  = _mpCalcTotal();
  var pagado = _formasPago.reduce(function(a,fp){ return a+fp.importe; }, 0);
  return Math.max(0, total - pagado);
}

function _mpActualizarBarra(){
  var total  = _mpCalcTotal();
  var pagado = _formasPago.reduce(function(a,fp){ return a+fp.importe; }, 0);
  var saldo  = total - pagado;
  document.getElementById('mpTotal').textContent   = '$'+fmt(total);
  document.getElementById('mpPagado').textContent  = '$'+fmt(pagado);
  var sEl = document.getElementById('mpSaldoVal');
  sEl.textContent   = '$'+fmt(Math.abs(saldo));
  sEl.style.color   = saldo<=0.005 ? '#1cc88a' : '#e74a3b';
  // Recalcular vuelto si hay monto recibido
  _mnActualizarVuelto();
}

function _mpRenderLista(){
  var el = document.getElementById('mpListaFps');
  if (!_formasPago.length){ el.innerHTML=''; return; }
  el.innerHTML = _formasPago.map(function(fp,i){
    return '<div class="mp-item">'
      +'<span class="mp-item-nom">'+escHtml(fp.medioNombre)+' — '+escHtml(fp.planNombre)+'</span>'
      +(IMPUTA_VENTA===1?'<span class="mp-item-imp">$'+fmt(fp.importe)+'</span>':'')
      +'<button class="mp-item-del" onclick="mpEliminarFp('+i+')" title="Quitar">×</button>'
      +'</div>';
  }).join('');
}

function _mpRenderBotones(){
  var grid = document.getElementById('mpPlanesGrid');
  grid.innerHTML = '';
  var idx = 0;
  _planesPago.forEach(function(pl){
    var btn = document.createElement('button');
    btn.className = 'mp-btn-plan'+((_mpPlanActual&&_mpPlanActual.planId===pl.planId)?' mp-activo':'');
    var numKey = idx+1;
    btn.textContent = pl.planNombre + (numKey<=9?' ('+numKey+')':'');
    btn.dataset.planId = pl.planId;
    btn.onclick = (function(p){ return function(){ _mpSeleccionarPlan(p); }; })(pl);
    grid.appendChild(btn);
    idx++;
  });
  var sh = document.getElementById('mpShortcutsHint');
  if (_planesPago.length>0){
    var hints = _planesPago.slice(0,9).map(function(pl,i){ return (i+1)+': '+pl.planNombre; });
    sh.textContent = 'Teclas: '+hints.join(' | ')+(LLEVA_CC===1?' | C: Cta. Cte.':'')+' | Enter: Confirmar | Esc: Cancelar';
  }
}

function _mpSeleccionarPlan(pl){
  _mpPlanActual = pl;
  document.querySelectorAll('.mp-btn-plan').forEach(function(b){
    b.classList.toggle('mp-activo', parseInt(b.dataset.planId)===pl.planId);
  });
  document.querySelectorAll('.mp-btn-cc').forEach(function(b){ b.classList.remove('mp-activo'); });
  var df = document.getElementById('mpDetalleForm');
  df.style.display = '';
  var iw = document.getElementById('mpImporteWrap');
  iw.style.display = IMPUTA_VENTA===1 ? '' : 'none';
  if (IMPUTA_VENTA===1){
    var impEl = document.getElementById('mpImporte');
    var saldo = _mpCalcSaldo();
    impEl.value = saldo>0.005 ? saldo.toFixed(2) : '';
    impEl.focus();
    impEl.select();
  }
  var r1=document.getElementById('mpRef1Wrap'),r2=document.getElementById('mpRef2Wrap'),r3=document.getElementById('mpRef3Wrap');
  r1.style.display = r2.style.display = r3.style.display = pl.conDatos ? '' : 'none';
  document.getElementById('mpRef1').value='';
  document.getElementById('mpRef2').value='';
  document.getElementById('mpRef3').value='';
}

window.mpConfirmarItem = function(){
  if (!_mpPlanActual){ return; }
  var importe = IMPUTA_VENTA===1 ? (parseFloat(document.getElementById('mpImporte').value)||0) : 0;
  var ref1 = document.getElementById('mpRef1').value;
  var ref2 = document.getElementById('mpRef2').value;
  var ref3 = document.getElementById('mpRef3').value;
  if (IMPUTA_VENTA===1 && importe<=0){ document.getElementById('mpImporte').focus(); return; }
  _formasPago.push({
    medioId: _mpPlanActual.medioId,
    planId : _mpPlanActual.planId,
    medioNombre: _mpPlanActual.medioNombre,
    planNombre : _mpPlanActual.planNombre,
    importe: importe,
    ref1: ref1, ref2: ref2, ref3: ref3
  });
  _mpPlanActual = null;
  document.getElementById('mpDetalleForm').style.display='none';
  document.getElementById('modalPagos').focus();
  _mpRenderLista();
  _mpActualizarBarra();
  _mpRenderBotones();
};

window.mpEliminarFp = function(idx){
  _formasPago.splice(idx,1);
  _mpRenderLista();
  _mpActualizarBarra();
};

window.mpAgregarCC = function(){
