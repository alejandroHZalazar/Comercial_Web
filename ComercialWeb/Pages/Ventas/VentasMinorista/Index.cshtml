// ── MÓDULO PROMOCIONES ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

var _resultadoPromo = null;

async function _verificarPromociones(){
  if (!_rows.length) return false;

  var carrito = _rows.map(function(r){ return { fkProducto: r.fkProducto, cantidad: r.cantidad }; });

  var resp, data;
  try {
    resp = await fetch('?handler=CalcularPromociones', {
      method : 'POST',
      headers: { 'Content-Type':'application/json' },
      body   : JSON.stringify(carrito)
    });
    if (!resp.ok){ console.error('CalcularPromociones HTTP', resp.status); return false; }
    data = await resp.json();
  } catch(err){
    console.error('CalcularPromociones error:', err);
    return false;
  }

  var tieneFormadas = data && data.formadas && data.formadas.length > 0;
  var tieneCasi     = data && data.casiCompletas && data.casiCompletas.length > 0;
  if (!data || !data.hayPromociones || (!tieneFormadas && !tieneCasi)) return false;

  _resultadoPromo = data;
  _renderModalPromo(data);
  var modalEl = document.getElementById('modalConfirmarPromo');
  if (!modalEl){ console.error('Modal promo no encontrado'); return false; }
  bootstrap.Modal.getOrCreateInstance(modalEl).show();
  return true;
}

function _renderModalPromo(data){
  var html = '';

  if (data.formadas && data.formadas.length){
    html += '<h6 class="fw-bold" style="color:#1cc88a;">✔ Promociones a formar:</h6><ul class="mb-2">';
    data.formadas.forEach(function(f){
      html += '<li><strong>'+escHtml(f.nombrePromo)+'</strong> &times; '+f.cantidad;
      if (f.componentesUsados && f.componentesUsados.length){
        html += '<ul class="text-muted" style="font-size:.76rem;">';
        f.componentesUsados.forEach(function(c){
          html += '<li>'+escHtml(c.descripcion)+' &mdash; '+fmtN(c.cantidadUsada, DEC_CANT)+' u.</li>';
        });
        html += '</ul>';
      }
      html += '</li>';
    });
    html += '</ul>';
  }

  if (data.casiCompletas && data.casiCompletas.length){
    html += '<hr><h6 class="fw-bold" style="color:#e67e22;">⚠ Casi completas (falta 1 unidad):</h6><ul class="mb-1">';
    data.casiCompletas.forEach(function(c){
      var cod = c.codBarrasFaltante ? ' ['+escHtml(c.codBarrasFaltante)+']' : '';
      html += '<li><strong>'+escHtml(c.nombrePromo)+'</strong>: agregar <em>'+escHtml(c.productoFaltante)+cod+'</em></li>';
    });
    html += '</ul>';
    html += '<p class="text-muted" style="font-size:.76rem;">Puede cerrar este aviso y agregar el producto faltante para completar la promoción.</p>';
  }

  document.getElementById('cuerpoModalPromo').innerHTML = html;
}

window.volverAgregarPromo = function(){
  bootstrap.Modal.getInstance(document.getElementById('modalConfirmarPromo'))?.hide();
  _resultadoPromo = null;
};

window.confirmarYVender = function(){
  bootstrap.Modal.getInstance(document.getElementById('modalConfirmarPromo'))?.hide();
  _aplicarPromociones(_resultadoPromo);
  // Abrir modal pagos si corresponde, o grabar directamente
  if (TIENE_MEDPAG===1 || LLEVA_CC===1){
    _mpAbrirModal();
  } else {
    grabarVenta();
  }
};

function _aplicarPromociones(data){
  if (!data || !data.formadas) return;

  data.formadas.forEach(function(f){
    f.componentesUsados.forEach(function(c){
      var idx = _rows.findIndex(function(r){ return r.fkProducto === c.fkProducto; });
      if (idx === -1) return;
      _rows[idx].cantidad = (_rows[idx].cantidad || 0) - (c.cantidadUsada || 0);
      if (_rows[idx].cantidad <= 0) _rows.splice(idx, 1);
    });

    for (var i = 0; i < f.cantidad; i++){
      _rows.push({
        fkProducto  : f.fkProductoPromo,
        codBarras   : '',
        codProveedor: '',
        descripcion : f.nombrePromo,
        precioSinIva: 0,
        descRec     : 0,
        cantidad    : 1,
        stock       : 0,
        fraccionado : false,
        costo       : 0,
        dolarizado  : false,
        sel         : false
      });
    }
  });

  renderGrilla();
  recalcularTotales();
}

document.addEventListener('ventaGrabada', async function(e){
  var ventaId = e.detail?.ventaId;
  if (!ventaId || !_resultadoPromo || !_resultadoPromo.formadas.length){
    _resultadoPromo = null;
    return;
  }

  var grupos = _resultadoPromo.formadas.map(function(f){
    return {
      fkProductoPromo: f.fkProductoPromo,
      componentes    : f.componentesUsados.map(function(c){
        return { fkSlot: c.fkSlot, fkProducto: c.fkProducto, cantidad: c.cantidadUsada };
      })
    };
  });

  var token = (document.querySelector('[name=__RequestVerificationToken]') || {}).value || '';
  await fetch('?handler=GuardarComponentes', {
    method : 'POST',
    headers: { 'Content-Type':'application/json', 'RequestVerificationToken': token },
    body   : JSON.stringify({ ventaId: ventaId, grupos: grupos })
  });

  _resultadoPromo = null;
});

