var _detPedId = 0;
window.verDetallePedido = function(id){
  _detPedId = id;
  document.getElementById('detPedTitulo').textContent = 'Pedido #' + id;
  document.getElementById('tbodyDetallePed').innerHTML =
    '<tr><td colspan="7" style="text-align:center;padding:1rem;"><div class="spinner-border spinner-border-sm"></div></td></tr>';
  document.getElementById('pdTotales').style.display = 'none';

  fetch('?handler=Pedido&id=' + id)
    .then(r => r.json())
    .then(res => {
      if (!res.ok){ alert('No se pudo cargar el pedido.'); return; }
      var cab = res.cab;
      var ivaVal = cab.iva ?? 0;
      // Modo por línea: cab.descuento es un descuento general sobre el Total S/IVA (no reemplaza líneas)
      var descGlobalDet = (BONIF !== 1 && cab.descuento != null) ? (cab.descuento * -1 + (cab.recargo ?? 0)) : null;
      var descGeneralDet = (BONIF === 1 && cab.descuento != null && cab.descuento > 0) ? cab.descuento : 0;

      document.getElementById('detPed-cliente').textContent = cab.nombreComercial ?? '';
      document.getElementById('detPed-fecha').textContent   = fmtDate(cab.fecha);
      document.getElementById('detPed-iva').textContent     = ivaVal + '%';
      document.getElementById('pd-lbl-iva-pct').textContent = 'IVA ' + ivaVal + '%';

      var tbody = document.getElementById('tbodyDetallePed');
      tbody.innerHTML = '';
      var totPrecSIva=0, totDesc=0, totSub=0, totIvaAmt=0, totTotal=0;
      var ivaRate = ivaVal / 100;

      res.detalle.forEach(function(l){
        var dr      = descGlobalDet !== null ? descGlobalDet : (l.descuento * -1 + (l.recargo||0));
        var pSIva   = l.precioSinIva;
        var sub     = pSIva * (1 + dr / 100);
        var pConIva = sub * (1 + ivaRate);
        var cant    = l.cantidad;

        totPrecSIva += pSIva * cant;
        totDesc     += (sub - pSIva) * cant;
        totSub      += sub * cant;
        totIvaAmt   += (pConIva - sub) * cant;
        totTotal    += pConIva * cant;

        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td>' + escHtml(l.descripcion||'') + '</td>'+
          '<td style="text-align:right;">' + fmt(cant) + '</td>'+
          '<td style="text-align:right;">$' + fmt(pSIva) + '</td>'+
          '<td style="text-align:right;' + (dr < 0 ? 'color:#e74a3b;' : dr > 0 ? 'color:#1cc88a;' : '') + '">' + fmt(dr) + '%</td>'+
          '<td style="text-align:right;">$' + fmt(sub * cant) + '</td>'+
          '<td style="text-align:right;">$' + fmt((pConIva - sub) * cant) + '</td>'+
          '<td style="text-align:right;font-weight:600;">$' + fmt(pConIva * cant) + '</td>';
        tbody.appendChild(tr);
      });

      // Descuento general: netea Subtotal s/IVA, IVA y Total (no altera las líneas)
      var pdRowDG = document.getElementById('pd-rowDescGeneral');
      if (descGeneralDet > 0){
        var f = 1 - descGeneralDet / 100;
        var descGeneralImp = totSub * descGeneralDet / 100;
        totSub    *= f;
        totIvaAmt *= f;
        totTotal  *= f;
        document.getElementById('pd-lbl-descGeneral').textContent = 'Desc. General ' + descGeneralDet + '%';
        document.getElementById('pd-tot-descGeneral').textContent = '-$' + fmt(descGeneralImp);
        pdRowDG.style.display = '';
      } else if (pdRowDG){
        pdRowDG.style.display = 'none';
      }

      document.getElementById('pd-tot-precioSIva').textContent = '$' + fmt(totPrecSIva);
      document.getElementById('pd-tot-descRec').textContent    = '$' + fmt(totDesc);
      document.getElementById('pd-tot-subtSIva').textContent   = '$' + fmt(totSub);
      document.getElementById('pd-tot-iva').textContent        = '$' + fmt(totIvaAmt);
      document.getElementById('pd-tot-total').textContent      = '$' + fmt(totTotal);
      document.getElementById('pdTotales').style.display       = '';

      new bootstrap.Modal(document.getElementById('modalDetallePed')).show();
    })
    .catch(function(){ alert('Error al cargar el detalle.'); });
};

