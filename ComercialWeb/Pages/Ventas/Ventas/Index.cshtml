// ── Validar y vender ───────────────────────────────────────────────────────
window.vender = async function(ordenFacturar){
  _ordenFacturar = ordenFacturar;
  if (!formularioValido()) return;

  // ── Verificar promociones antes de grabar ────────────────────────────────
  var promoIntercept = await _verificarPromociones();
  if (promoIntercept) return;   // modal abierto, esperar confirmación del usuario
  // ─────────────────────────────────────────────────────────────────────────

  // ── Modal de formas de pago (si aplica) ──────────────────────────────────
  if (TIENE_MEDPAG===1 || LLEVA_CC===1){
    _mpAbrirModal();
    return;   // grabarVenta() se llama desde mpConfirmarVenta()
  }
  // ─────────────────────────────────────────────────────────────────────────

  await grabarVenta();
};

function formularioValido(){
  if (_clienteId <= 0){ showAlert('Seleccione un cliente.'); return false; }
  if (!_rows.length)  { showAlert('Agregue al menos un producto.'); return false; }
  if (COMISIONA===1){
    var vend=parseInt(document.getElementById('cboVendedor')?.value)||0;
    if (vend<=0){ showAlert('Seleccione un vendedor.'); return false; }
  }
  return true;
}

async function grabarVenta(){
  var iva     = parseFloat(document.getElementById('txtIva').value)||0;
  var impPct  = parseFloat(document.getElementById('cboIngBrutos').value)||0;
  // Descuento general (%) sobre Total S/IVA — netea el total (solo modo por línea)
  var dGralPct = getDescGeneralPct();
  var factor   = 1 - dGralPct/100;
  var sub     = _rows.reduce((a,r)=>a+(r.subtotalSIva||0)*r.cantidad,0) * factor;
  var totIva  = sub*iva/100;
  var totImp  = sub*impPct/100;
  var total   = sub+totIva+totImp;
  var costo   = _rows.reduce((a,r)=>a+(r.costo*r.cantidad),0);

  var detalle = _rows.map(r=>({
    fkProducto    : r.fkProducto,
    precioSinIva  : r.precioSinIva,
    precioConIva  : r.precioConIva,
    cantidad      : r.cantidad,
    costo         : r.costo,
    subtotal      : r.subtotal,
    fraccionado   : r.fraccionado||false,
    descRec       : r.descRec||0,
    subtotalSinIva: r.subtotalSIva||0,
    fkPedido      : _pedidoCargado||0
  }));

  var fps = (TIENE_MEDPAG===1||LLEVA_CC===1) ? (_formasPago||[]) : [];
  var importeCobro = fps.reduce((a,fp)=>a+fp.importe,0);

  var formasPago = fps.map ? fps.map(fp=>({
    fkMedioPago: fp.medioId,
    fkPlanPago : fp.planId,
    importe    : fp.importe,
    referencia1: fp.ref1||null,
    referencia2: fp.ref2||null,
    referencia3: fp.ref3||null
  })) : [];

  // Desc/Rec globales si aplica
  var dr = _rows.length ? _rows[0].descRec : 0;
  var mismoDr = _rows.every(r=>r.descRec===dr);
  var descGlobal = (BONIF===0 && mismoDr && dr!==0) ? (dr<0?Math.abs(dr):null) : null;
  var recGlobal  = (BONIF===0 && mismoDr && dr!==0) ? (dr>0?Math.abs(dr):null) : null;
  // Modo por línea: el descuento general (%) se guarda en el campo descuento de cabecera
  if (BONIF===1){
    descGlobal = dGralPct > 0 ? dGralPct : null;
    recGlobal  = null;
  }

  var dto = {
    total          : total,
    costo          : costo,
    fkCliente      : _clienteId,
    fkCajero       : 0,
    iva            : iva,
    descuento      : descGlobal,
    recargo        : recGlobal,
    fkVendedor     : parseInt(document.getElementById('cboVendedor')?.value||0)||0,
    comision       : (parseFloat(document.getElementById('txtComision')?.value||0)||0)/100,
    impuesto       : impPct,
    llevaCC        : @(p.LlevaCC == 1 ? "true" : "false"),
    imputaEnVenta  : @(p.ImputaEnVenta == 1 ? "true" : "false"),
    tieneMediosPagos:@(p.TieneMediosPagos == 1 ? "true" : "false"),
    importeCobro   : importeCobro,
    haceCaja       : @(p.TieneCaja == 1 ? "true" : "false"),
    cajaId         : 0,
    pedidoCargado  : _pedidoCargado||0,
    detalle        : detalle,
    formasPago     : formasPago
  };

  // Pre-abrir popup del comprobante para NO perder el contexto del click (evita popup blocker).
  // Cuando tengamos el ventaId, le cambiamos la URL. Si se bloquea, queda null y usamos fallback.
  // F6 = vender + facturar (no abre comprobante X, irá directo a la factura)
  // F5 / botón = solo vender (abre comprobante X)
  var popupComprobante = null;
  var abreComprobante  = !(_ordenFacturar && FACTURA_ELEC===1);
  if (abreComprobante){
    try { popupComprobante = window.open('about:blank', '_blank'); } catch(e){ popupComprobante = null; }
  }

  // Deshabilitar botones y abrir progreso
  toggleBtns(true);
  progAbrir();
  try{
    var nItems = dto.detalle.length;
    progActualizar('Enviando venta al servidor...', 20,
      nItems+' producto'+(nItems!==1?'s':'')+' — total $'+fmt(dto.total));

    // Mientras el servidor procesa, animamos suavemente la barra hasta 55%
    progAutoAvanzar(55, 120);

    var resp = await fetch('?handler=GrabarVenta', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(dto)
    });

    progAutoDetener();
    progActualizar('Procesando respuesta...', 65, '');
    var r = await resp.json();
    if (!r.ok){
      progCerrar();
      if (popupComprobante){ try{ popupComprobante.close(); }catch(e){} }
      showAlert('Error al guardar venta: '+(r.msg||'Error desconocido.'));
      toggleBtns(false);
      return;
    }

    var ventaId = r.ventaId;

    // ── Disparar evento para guardar componentes de promos ─────────────────
    document.dispatchEvent(new CustomEvent('ventaGrabada', { detail: { ventaId: ventaId } }));

    // Post-venta: F6 = grabar + facturar electrónica / F5 o botón = solo grabar + comprobante X
    if (_ordenFacturar && FACTURA_ELEC===1){
      // ── Facturación electrónica (F6) ──────────────────────────────────────
      progActualizar('Emitiendo factura electrónica...', 80, 'Comunicando con AFIP...');
      progAutoAvanzar(92, 200);
      var fResp = await fetch('?handler=Facturar',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ventaId:ventaId})
      });
      progAutoDetener();
      var fR = await fResp.json();
      progCerrar();
      if (fR.ok){
        if (fR.pdfUrl) window.open(fR.pdfUrl,'_blank');
        showInfo('Factura electrónica emitida. CAE: '+(fR.cae||'')
          +(fR.pdfUrl?' — <a href="'+fR.pdfUrl+'" target="_blank">Ver PDF</a>':''));
      } else {
        showAlert('Error en factura electrónica: '+((fR.errores||[]).join(', ')||fR.msg||'Error'));
      }
      limpiarFormulario();
      toggleBtns(false);
      return;
    } else if (_ordenFacturar && FACTURA_ELEC!==1){
      // ── F6 sin factura electrónica configurada ────────────────────────────
      progCerrar();
      showAlert('La facturación electrónica no está habilitada en los parámetros del sistema. La venta fue registrada correctamente.');
      toggleBtns(false);
      limpiarFormulario();
      return;
    } else {
      // Navegamos el popup previamente abierto al comprobante
      // Si el parámetro ventas/notaVentaTK==1, usa ticket X (térmico) con auto-print.
      // Si es 0, usa comprobante X en A4.
      var urlComp = (HACE_NOTA_VENTA_TK===1)
                     ? '/Ventas/Ventas/TicketX/'+ventaId
                     : '/Ventas/Ventas/ComprobanteX/'+ventaId;
      progActualizar('Abriendo comprobante...', 90, 'Venta N° '+ventaId);
      if (popupComprobante && !popupComprobante.closed){
        try { popupComprobante.location.href = urlComp; popupComprobante.focus(); }
        catch(e){ popupComprobante = null; }
      }
      // Si no se pudo abrir o fue bloqueado: mostrar link visible
      if (!popupComprobante || popupComprobante.closed){
        showInfo('Venta N° '+ventaId+' registrada. '+
          '<a href="'+urlComp+'" target="_blank" style="font-weight:700;">Abrir comprobante</a> '+
          '(tu navegador bloqueó la apertura automática).');
      }
    }

    progActualizar('¡Venta registrada!', 100, 'N° '+ventaId);
    setTimeout(progCerrar, 900);
    limpiarFormulario();
    if (!popupComprobante || popupComprobante.closed){
      // si ya mostramos el info con el link, no pisar
    } else {
      showInfo('Venta N° '+ventaId+' registrada correctamente.');
    }
  } catch(ex){
    progCerrar();
    if (popupComprobante){ try{ popupComprobante.close(); }catch(e){} }
    showAlert('Error técnico: '+ex.message);
  }
  toggleBtns(false);
};

function toggleBtns(disabled){
  document.querySelectorAll('.btn-vender').forEach(b=>b.disabled=disabled);
}

