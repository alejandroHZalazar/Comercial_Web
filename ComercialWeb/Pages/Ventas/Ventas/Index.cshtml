// Keyboard shortcuts dentro del modal
document.getElementById('modalPagos').addEventListener('keydown', function(e){
  if (!document.getElementById('modalPagos').classList.contains('show')) return;

  // Si el foco está en un <input> o <textarea>, no disparar shortcuts numéricos/letras.
  // Enter en ese contexto = agregar el ítem; Escape = quitar el foco del campo.
  var activeEl = document.activeElement;
  // enInput: el foco está en un input VISIBLE (offsetParent===null indica display:none en él o sus padres)
  var enInput  = activeEl &&
                 (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA') &&
                 activeEl.offsetParent !== null;
  if (enInput){
    if (e.key === 'Enter'){  e.preventDefault(); mpConfirmarItem(); }
    if (e.key === 'Escape'){ e.preventDefault(); activeEl.blur(); document.getElementById('modalPagos').focus(); }
    return;   // resto de teclas (números, letras, punto, etc.) pasan sin interferir
  }

  // Foco fuera de inputs → shortcuts normales
  var num = parseInt(e.key);
  if (num >= 1 && num <= 9 && num <= _planesPago.length){
    e.preventDefault();
    _mpSeleccionarPlan(_planesPago[num-1]);
  }
  if ((e.key === 'c' || e.key === 'C') && LLEVA_CC===1){ e.preventDefault(); mpAgregarCC(); }
  if (e.key === 'Enter') { e.preventDefault(); mpConfirmarVenta(); }
  if (e.key === 'Escape'){ e.preventDefault(); mpCancelar(); }
});

