  var dr  = _drMode==='desc' ? -Math.abs(pct) : Math.abs(pct);
  if (BONIF===1){
    var sel = _rows.filter(r=>r.sel);
    if (!sel.length){ showAlert('Seleccione al menos una fila para aplicar desc/rec.'); return; }
    sel.forEach(r=>{ r.descRec=dr; recalcularFila(r); });
  } else {
    _rows.forEach(r=>{ r.descRec=dr; recalcularFila(r); });
