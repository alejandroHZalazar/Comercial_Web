// ── Descuento general (%) sobre Total S/IVA — solo modo por línea (BONIF===1) ──
function getDescGeneralPct(){
  if (BONIF !== 1) return 0;
  var el = document.getElementById('txtDescGeneralPct');
  var v = el ? (parseFloat(el.value)||0) : 0;
  if (v < 0)   v = 0;
  if (v > 100) v = 100;
  return v;
}
window.onChangeDescuentoGeneral = function(){ recalcularTotales(); };

// ── Totales ────────────────────────────────────────────────────────────────
function recalcularTotales(){
  var iva    = parseFloat(document.getElementById('txtIva').value)||0;
  var impPct = parseFloat(document.getElementById('cboIngBrutos').value)||0;

  // Totales por fila:
  //   P.S/IVA * Cantidad         → Subtotal Bruto
  //   (SubT.S/IVA - P.S/IVA) * C → Desc/Rec nominal
  //   SubT.S/IVA * Cantidad      → Subtotal s/IVA
  var subtBruto = 0, totDescRec = 0, subtSIvaBruto = 0;
  _rows.forEach(function(r){
    var c      = +r.cantidad     || 0;
    var pSIva  = +r.precioSinIva || 0;
    var sSIva  = +r.subtotalSIva || 0;
    subtBruto     += pSIva * c;
    totDescRec    += (sSIva - pSIva) * c;
    subtSIvaBruto += sSIva * c;
  });

  // Descuento general: netea el Total S/IVA (no altera las líneas)
  var dGralPct = getDescGeneralPct();
  var factor   = 1 - dGralPct / 100;
  var descGeneralImporte = subtSIvaBruto * dGralPct / 100;
  var subtSIva = subtSIvaBruto * factor;

  var totIva = subtSIva * iva / 100;
  var totImp = subtSIva * impPct / 100;
  var total  = subtSIva + totIva + totImp;

  // Render
  document.getElementById('tot-subtBruto').textContent = '$' + fmt(subtBruto);
  document.getElementById('tot-subtSIva').textContent  = '$' + fmt(subtSIva);
  document.getElementById('tot-iva').textContent       = '$' + fmt(totIva);
  document.getElementById('lbl-iva').textContent       = 'IVA ' + fmt(iva) + '%';
  document.getElementById('tot-total').textContent     = '$' + fmt(total);

  // Fila del descuento general (solo modo por línea)
  var rowDG = document.getElementById('rowDescGeneral');
  if (rowDG){
    if (dGralPct > 0){
      document.getElementById('tot-descGeneral').textContent = '-$' + fmt(descGeneralImporte);
      rowDG.style.display = '';
    } else {
      rowDG.style.display = 'none';
    }
  }

  // Desc/Rec: mostrar sólo si hay algo
  var rowDR = document.getElementById('rowTotDescRec');
  if (Math.abs(totDescRec) >= 0.005){
    document.getElementById('lbl-descRec').textContent =
      (totDescRec < 0 ? 'Descuentos' : 'Recargos');
    document.getElementById('tot-descRec').textContent = '$' + fmt(totDescRec);
    rowDR.style.display = '';
  } else {
    rowDR.style.display = 'none';
  }

  // Ing. Brutos: mostrar sólo si hay %
  var rowImp = document.getElementById('rowTotImpuesto');
  if (impPct > 0){
    document.getElementById('lbl-impuesto').textContent = 'Ing. Brutos ' + fmt(impPct) + '%';
    document.getElementById('tot-impuesto').textContent = '$' + fmt(totImp);
    rowImp.style.display = '';
  } else {
    rowImp.style.display = 'none';
  }

  actualizarResumenPago(total);
}
