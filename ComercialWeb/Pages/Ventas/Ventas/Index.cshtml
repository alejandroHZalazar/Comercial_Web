  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow" style="border-radius:.65rem;overflow:hidden;">
      <div class="modal-header py-2" style="background:linear-gradient(135deg,#1a3a5c,#2e6da4);color:#fff;">
