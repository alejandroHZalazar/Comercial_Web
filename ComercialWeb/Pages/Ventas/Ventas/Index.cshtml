// ── Progreso venta ─────────────────────────────────────────────────────────
var _progModal = null;
var _progAutoTimer = null;
var _progCurrent = 0;
function progAbrir(){
  _progModal = new bootstrap.Modal(document.getElementById('modalProgresoVenta'));
  progActualizar('Preparando datos...', 10, '');
  _progModal.show();
}
function progActualizar(msg, pct, detalle){
  _progCurrent = pct;
  document.getElementById('progVentaMsg').textContent    = msg;
  document.getElementById('progVentaDetalle').textContent= detalle||'';
  var bar = document.getElementById('progVentaBar');
  bar.style.width       = pct+'%';
  bar.setAttribute('aria-valuenow', pct);
}
// Avanza lentamente la barra hasta un tope mientras esperamos una operación larga
function progAutoAvanzar(tope, pasoMs){
  progAutoDetener();
  _progAutoTimer = setInterval(function(){
    if (_progCurrent >= tope){ progAutoDetener(); return; }
    _progCurrent = Math.min(tope, _progCurrent + 1);
    var bar = document.getElementById('progVentaBar');
    bar.style.width = _progCurrent+'%';
    bar.setAttribute('aria-valuenow', _progCurrent);
  }, pasoMs||150);
}
function progAutoDetener(){
  if (_progAutoTimer){ clearInterval(_progAutoTimer); _progAutoTimer=null; }
}
function progCerrar(){
  progAutoDetener();
  if (_progModal){ _progModal.hide(); _progModal=null; }
}

// ── Alertas ────────────────────────────────────────────────────────────────
function showAlert(msg){
  var d=document.getElementById('alertDiv');
  document.getElementById('alertMsg').textContent=msg;
  d.className='alert alert-danger alert-dismissible';
  d.style.display='block';
  d.scrollIntoView({behavior:'smooth',block:'start'});
}
function showInfo(msg){
  var d=document.getElementById('alertDiv');
  document.getElementById('alertMsg').innerHTML=msg;
  d.className='alert alert-success alert-dismissible';
  d.style.display='block';
  setTimeout(()=>d.style.display='none', 6000);
}

// ═══════════════════════════════════════════════════════════════════════════
// ── MÓDULO PROMOCIONES ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

var _resultadoPromo = null;   // último resultado de CalcularPromociones

// Llama al servidor para saber si hay promos formables con los productos en grilla.
// Devuelve true si hay promos (modal abierto), false si puede continuar con vender.
async function _verificarPromociones(){
  if (!_rows.length) return false;

  var carrito = _rows.map(function(r){ return { fkProducto: r.fkProducto, cantidad: r.cantidad }; });

  var resp, data;
  try {
    resp = await fetch('?handler=CalcularPromociones', {
      method : 'POST',
      headers: { 'Content-Type':'application/json' },
      body   : JSON.stringify(carrito)
    });
    if (!resp.ok){ console.error('CalcularPromociones HTTP', resp.status); return false; }
    data = await resp.json();
  } catch(err){
    console.error('CalcularPromociones error:', err);
    return false;
  }

  var tieneFormadas    = data && data.formadas && data.formadas.length > 0;
  var tieneCasi        = data && data.casiCompletas && data.casiCompletas.length > 0;
  if (!data || !data.hayPromociones || (!tieneFormadas && !tieneCasi)) return false;

  _resultadoPromo = data;
  _renderModalPromo(data);
  var modalEl = document.getElementById('modalConfirmarPromo');
  if (!modalEl){ console.error('Modal no encontrado'); return false; }
  bootstrap.Modal.getOrCreateInstance(modalEl).show();
  return true;
}

function _renderModalPromo(data){
  var html = '';

  if (data.formadas && data.formadas.length){
    html += '<h6 class="fw-bold" style="color:#1cc88a;">✔ Promociones a formar:</h6><ul class="mb-2">';
    data.formadas.forEach(function(f){
      html += '<li><strong>'+escHtml(f.nombrePromo)+'</strong> &times; '+f.cantidad;
      if (f.componentesUsados && f.componentesUsados.length){
        html += '<ul class="text-muted" style="font-size:.76rem;">';
        f.componentesUsados.forEach(function(c){
          html += '<li>'+escHtml(c.descripcion)+' &mdash; '+fmtN(c.cantidadUsada, DEC_CANT)+' u.</li>';
        });
        html += '</ul>';
      }
      html += '</li>';
    });
    html += '</ul>';
  }

  if (data.casiCompletas && data.casiCompletas.length){
    html += '<hr><h6 class="fw-bold" style="color:#e67e22;">⚠ Casi completas (falta 1 unidad):</h6><ul class="mb-1">';
    data.casiCompletas.forEach(function(c){
      var cod = c.codBarrasFaltante ? ' ['+escHtml(c.codBarrasFaltante)+']' : '';
      html += '<li><strong>'+escHtml(c.nombrePromo)+'</strong>: agregar <em>'+escHtml(c.productoFaltante)+cod+'</em></li>';
    });
    html += '</ul>';
    html += '<p class="text-muted" style="font-size:.76rem;">Puede cerrar este aviso y agregar el producto faltante para completar la promoción.</p>';
  }

  document.getElementById('cuerpoModalPromo').innerHTML = html;
}

window.volverAgregarPromo = function(){
  bootstrap.Modal.getInstance(document.getElementById('modalConfirmarPromo'))?.hide();
  _resultadoPromo = null;
  // El usuario regresa a la grilla para seguir editando
};

window.confirmarYVender = function(){
  bootstrap.Modal.getInstance(document.getElementById('modalConfirmarPromo'))?.hide();
  _aplicarPromociones(_resultadoPromo);
  grabarVenta();
};

function _aplicarPromociones(data){
  if (!data || !data.formadas) return;

  data.formadas.forEach(function(f){
    // Descontar cantidades usadas de los componentes en _rows
    f.componentesUsados.forEach(function(c){
      var idx = _rows.findIndex(function(r){ return r.fkProducto === c.fkProducto; });
      if (idx === -1) return;
      _rows[idx].cantidad = (_rows[idx].cantidad || 0) - (c.cantidadUsada || 0);
      if (_rows[idx].cantidad <= 0) _rows.splice(idx, 1);
    });

    // Agregar línea de producto-promo (una por cada cantidad formada)
    for (var i = 0; i < f.cantidad; i++){
      _rows.push({
        fkProducto  : f.fkProductoPromo,
        codBarras   : '',
        codProveedor: '',
        descripcion : f.nombrePromo,
        precioSinIva: 0,
        descRec     : 0,
        cantidad    : 1,
        stock       : 0,
        fraccionado : false,
        costo       : 0,
        dolarizado  : false,
        sel         : false
      });
    }
  });

  renderGrilla();
  recalcularTotales();
}

// Escuchar evento 'ventaGrabada' → guardar componentes usados y descontar stock
document.addEventListener('ventaGrabada', async function(e){
  var ventaId = e.detail?.ventaId;
  if (!ventaId || !_resultadoPromo || !_resultadoPromo.formadas.length){
    _resultadoPromo = null;
    return;
  }

  var grupos = _resultadoPromo.formadas.map(function(f){
    return {
      fkProductoPromo: f.fkProductoPromo,
      componentes    : f.componentesUsados.map(function(c){
        return { fkSlot: c.fkSlot, fkProducto: c.fkProducto, cantidad: c.cantidadUsada };
      })
    };
  });

  var token = (document.querySelector('[name=__RequestVerificationToken]') || {}).value || '';
  await fetch('?handler=GuardarComponentes', {
    method : 'POST',
    headers: { 'Content-Type':'application/json', 'RequestVerificationToken': token },
    body   : JSON.stringify({ ventaId: ventaId, grupos: grupos })
  });

  _resultadoPromo = null;
});

// ── Fin MÓDULO PROMOCIONES ─────────────────────────────────────────────────

// ── Inicialización (todas las funciones ya están definidas) ────────────────
(function init(){
  // Limpieza defensiva: remover backdrops de modal colgados de navegación previa
  document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
  document.body.classList.remove('modal-open');
  document.body.style.removeProperty('overflow');
  document.body.style.removeProperty('padding-right');

  // Asegurar que ningún input/select del panel quede deshabilitado por estado cacheado
  document.querySelectorAll('#txtBusqCB, #txtBusqCP, #txtBusqDesc, #txtBusqCant').forEach(el => {
    el.disabled = false;
    el.readOnly = false;
  });

  // Cargar cliente consumidor final si corresponde
  if (_clienteId > 0){ cargarClientePorId(_clienteId); }

  // El placeholder de la caja de CB ya se setea desde el Razor según TIENE_CB

  // Columna Sel visible si bonif=1
  if (BONIF === 0){
    document.querySelectorAll('#thSel,[data-sel-col]').forEach(el=>el.style.display='none');
  }

  setDrMode('desc');
})();

})();
</script>
}
