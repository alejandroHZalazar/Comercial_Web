window.cargarPedido = async function(pedidoId){
  var resp = await fetch('?handler=Pedido&id='+pedidoId);
  var r    = await resp.json();
  if (!r.ok){ showAlert('No se pudo cargar el pedido.'); return; }
  var cab = r.cab;
  var det = r.detalle;

  // Cerrar modal
  bootstrap.Modal.getInstance(document.getElementById('modalBuscarPedido'))?.hide();

  // Seteamos cliente
  await cargarClientePorId(cab.fkCliente||cab.clienteId||0);

  // IVA del pedido
  if (cab.iva != null) {
    var selIva = document.getElementById('txtIva');
    for (var i=0; i<selIva.options.length; i++) {
      if (parseFloat(selIva.options[i].value) === parseFloat(cab.iva)) {
        selIva.selectedIndex = i;
        break;
      }
    }
  }

  // Regla global desc/rec del pedido.
  // En modo por línea (BONIF===1) cab.descuento es un descuento general sobre el Total S/IVA:
  // NO se explota a las líneas; se precarga en el control de descuento general.
  var descGlobal = null;
  if (BONIF !== 1 && cab.descuento != null) descGlobal = cab.descuento * -1 + (cab.recargo||0);
  if (BONIF === 1){
    var dgEl = document.getElementById('txtDescGeneralPct');
    if (dgEl) dgEl.value = (cab.descuento != null && cab.descuento > 0) ? cab.descuento : 0;
  }

  // Limpiar grilla
  _rows = [];
  _pedidoCargado = pedidoId;
  document.getElementById('hPedidoCargado').value = pedidoId;
  var iva = parseFloat(document.getElementById('txtIva').value)||0;

  det.forEach(d=>{
    var dr = descGlobal !== null ? descGlobal : (d.descuento * -1 + (d.recargo||0));
    var row={
      fkProducto  : d.fkProducto,
      codBarras   : d.codBarras||'',
      codProveedor: d.codProveedor||'',
      descripcion : d.descripcion,
      precioSinIva: d.precioSinIva,
      descRec     : dr,
      cantidad    : d.cantidad,
      stock       : 0,
      fraccionado : d.fraccionado || false,
      costo       : d.costo||0,
      sel         : false
    };
    recalcularFila(row);
    // Para productos fraccionados restaurar el subtotal exacto almacenado en BD.
    if (row.fraccionado && d.subtotal > 0) {
      row.subtotal = d.subtotal;
    }
    _rows.push(row);
  });
  renderGrilla();
  _fetchStockRows();
};

