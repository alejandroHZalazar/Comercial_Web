@section Scripts {
<script>
(function(){
  'use strict';

  // ── Constantes desde servidor ──────────────────────────────────────────────
  var FACT_ELEC   = @p.FacturaElectronica;
  var DEC         = @p.Decimales;
  var DEC_CANT    = @p.DecimalesCant;
  var BONIF       = @p.BonificacionPorLinea;
  var FILTRA_PROV = @p.FiltraPorProveedor;
  var TIENE_CB    = @p.TieneLectoraCB;
  var INDICE_BUSQ = @p.IndiceBusqueda;
  var COMISIONA   = @p.Comisiona;
  var HACE_TK     = @p.HaceNotaVentaTK;

  // ── Estado ─────────────────────────────────────────────────────────────────
  var _rows          = [];
  var _clienteId     = @(p.TieneConsumidorFinal == 1 ? p.ClienteConsumidorFinal : 0);
  var _ventaId       = 0;
  var _drMode        = 'desc';
  var _prodPending   = null;
  var _lastProdInput = 'txtBusqCB';
  var _bvResultados  = [];   // cache de la última búsqueda en el modal
  var _dvVentaActual = 0;    // ventaId actualmente en el modal detalle
  var _dvFkCliente   = 0;    // fkCliente del registro en detalle
  var _ventaFactura  = '';   // factura de la venta cargada (para pre-fill NC)
  var _ventaFechaISO = '';   // fecha ISO de la venta cargada

  // ── Autocomplete descripción: estado ───────────────────────────────────────
  var _descResults = [];
  var _descSelIdx  = -1;
  var _descTimer   = null;

  // ── Formato ────────────────────────────────────────────────────────────────
  function fmt(n){
    return new Intl.NumberFormat('es-AR',{minimumFractionDigits:2,maximumFractionDigits:2}).format(n??0);
  }
  function fmtInp(n, dec){
    if (n == null || isNaN(n)) return '0';
    return (+n).toFixed(dec ?? DEC);
  }
  function fmtDate(iso){
    if (!iso) return '';
    return new Date(iso).toLocaleDateString('es-AR');
  }
  function escHtml(s){
    return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Alerta ─────────────────────────────────────────────────────────────────
  function showAlert(msg){
    var el = document.getElementById('alertDiv');
    document.getElementById('alertMsg').textContent = msg;
    el.style.display = 'flex';
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    setTimeout(function(){ el.style.display='none'; }, 5000);
  }

  // ── Multi-select proveedores ───────────────────────────────────────────────
  window.bpToggle = function(dropId){
    var drop   = document.getElementById(dropId);
    var isOpen = drop.classList.contains('open');
    document.querySelectorAll('.bp-multisel-drop.open').forEach(el=>el.classList.remove('open'));
    if (!isOpen) drop.classList.add('open');
  };
  document.addEventListener('click', function(e){
    if (!e.target.closest('.bp-multisel-wrap'))
      document.querySelectorAll('.bp-multisel-drop.open').forEach(el=>el.classList.remove('open'));
  });
  window.bpUpdateLabel = function(cls, lblId, plural){
    var checked = [...document.querySelectorAll('.'+cls+':checked')];
    document.getElementById(lblId).textContent =
      checked.length===0 ? 'Todos' :
      checked.length===1 ? checked[0].closest('label').textContent.trim() :
      checked.length + ' ' + plural;
  };
  window.bpSelAll = function(cls, lblId, plural){
    document.querySelectorAll('.'+cls).forEach(c=>{ if(c.closest('label').style.display!=='none') c.checked=true; });
    bpUpdateLabel(cls, lblId, plural);
  };
  window.bpSelNone = function(cls, lblId){
    document.querySelectorAll('.'+cls).forEach(c=>c.checked=false);
    document.getElementById(lblId).textContent='Todos';
  };

  // ── Cliente: autocomplete ──────────────────────────────────────────────────
  var _cliTimer = null;
  var _cliResults = [];
  var _cliSelIdx  = -1;

  window.onClienteInput = function(val){
    clearTimeout(_cliTimer);
    _cliSelIdx = -1;
    if (val.length < 2){ cerrarDropCli(); return; }
    _cliTimer = setTimeout(function(){ fetchClientes(val); }, 300);
  };
  window.onClienteKeydown = function(e){
    var drop  = document.getElementById('dropClientes');
    var items = drop.querySelectorAll('.ac-item');
    if (e.key==='ArrowDown'){ e.preventDefault(); _cliSelIdx=Math.min(_cliSelIdx+1,items.length-1); highlightCli(items); }
    else if (e.key==='ArrowUp'){ e.preventDefault(); _cliSelIdx=Math.max(_cliSelIdx-1,0); highlightCli(items); }
    else if (e.key==='Enter'){ e.preventDefault(); if(_cliSelIdx>=0&&_cliResults[_cliSelIdx]) seleccionarCliente(_cliResults[_cliSelIdx]); }
    else if (e.key==='Escape') cerrarDropCli();
  };
  function highlightCli(items){
    items.forEach(function(it,i){ it.classList.toggle('active', i===_cliSelIdx); });
    if (items[_cliSelIdx]) items[_cliSelIdx].scrollIntoView({block:'nearest'});
  }
  async function fetchClientes(q){
    var resp = await fetch('?handler=BuscarClientes&q='+encodeURIComponent(q));
    _cliResults = await resp.json();
    var drop = document.getElementById('dropClientes');
    if (!_cliResults.length){ cerrarDropCli(); return; }
    drop.innerHTML = _cliResults.map(function(c,i){
      return '<div class="ac-item" data-idx="'+i+'"><strong>'+escHtml(c.nombreComercial||'')+'</strong>'
             +'<small>'+escHtml(c.direccionFull||'')+'</small></div>';
    }).join('');
    drop.querySelectorAll('.ac-item').forEach(function(el){
      el.addEventListener('click', function(){ seleccionarCliente(_cliResults[parseInt(el.dataset.idx)]); });
    });
    drop.classList.add('open');
  }
  window.seleccionarCliente = function(c){
    if (typeof c==='string') c=JSON.parse(c);
    _clienteId = c.clienteId || c.id;
    document.getElementById('hClienteId').value = _clienteId;
    document.getElementById('txtBuscarCliente').value = '';
    cerrarDropCli();
    document.getElementById('ci-nombre').textContent    = c.nombreComercial || '';
    document.getElementById('ci-telefono').textContent  = c.telefono        || '--';
    document.getElementById('ci-direccion').textContent = c.direccionFull   || '--';
    document.getElementById('ci-condiva').textContent   = c.condIvaDescripcion || c.condIvaAbrev || '';
    document.getElementById('clienteInfo').style.display  = 'block';
    document.getElementById('clienteVacio').style.display = 'none';
  };
  function cerrarDropCli(){
    var drop = document.getElementById('dropClientes');
    drop.classList.remove('open');
    drop.innerHTML='';
  }
  async function cargarClientePorId(id){
    if (!id) return;
    var resp = await fetch('?handler=ClienteData&id='+id);
    var r    = await resp.json();
    if (!r.ok) return;
    var d = r.data;
    _clienteId = d.id;
    document.getElementById('hClienteId').value = d.id;
    document.getElementById('ci-nombre').textContent    = d.nombreComercial || '';
    document.getElementById('ci-telefono').textContent  = d.telefono        || '--';
    document.getElementById('ci-direccion').textContent = d.direccionFull   || '--';
    document.getElementById('ci-condiva').textContent   = d.condIvaDescripcion || d.condIvaAbrev || '';
    document.getElementById('clienteInfo').style.display  = 'block';
    document.getElementById('clienteVacio').style.display = 'none';
  }

  // ── Grilla: recalcular fila ────────────────────────────────────────────────
  function recalcularFila(row){
    var iva  = parseFloat(document.getElementById('txtIva').value)||0;
    var dr   = row.descRec||0;
    row.subtotalSIva = row.precioSinIva*(1+dr/100);
    row.precioConIva = row.subtotalSIva*(1+iva/100);
    row.subtotal     = row.precioConIva*row.cantidad;
  }

  // ── Grilla: render ─────────────────────────────────────────────────────────
  function renderGrilla(){
    var tbody = document.getElementById('tbodyDetalle');
    var vacio = document.getElementById('rowVacio');
    tbody.querySelectorAll('tr.data-row').forEach(r=>r.remove());
    if (!_rows.length){ vacio.style.display=''; recalcularTotales(); return; }
    vacio.style.display='none';
    _rows.forEach(function(row,idx){
      var tr=document.createElement('tr');
      tr.className='data-row';
      var drColor=row.descRec<0?'color:#c0392b;':row.descRec>0?'color:#1a7a45;':'';
      tr.innerHTML=
        '<td style="text-align:center;'+(BONIF===0?'display:none;':'')+'" data-sel-col>'+
          '<input type="checkbox" class="chk-sel" '+(row.sel?'checked':'')+' onchange="rowSelChange('+idx+',this.checked)" />'+
        '</td>'+
        '<td style="font-size:.75rem;">'+escHtml(row.codBarras||'')+'</td>'+
        '<td style="font-size:.75rem;">'+escHtml(row.codProveedor||'')+'</td>'+
        '<td>'+escHtml(row.descripcion||'')+'</td>'+
        '<td style="text-align:right;font-size:.78rem;">'+fmtInp(row.stock,DEC_CANT)+'</td>'+
        '<td style="text-align:right;">$'+fmt(row.precioSinIva)+'</td>'+
        '<td style="text-align:right;'+drColor+'">'+
          '<input type="number" style="width:65px;font-size:.76rem;text-align:right;" value="'+fmtInp(row.descRec,2)+'" step="0.01" onchange="onChangeDr('+idx+',this.value)" />'+
        '</td>'+
        '<td style="text-align:right;">$'+fmt(row.subtotalSIva)+'</td>'+
        '<td style="text-align:right;">$'+fmt(row.precioConIva)+'</td>'+
        '<td style="text-align:right;">'+
          '<input type="number" style="width:80px;font-size:.76rem;text-align:right;" value="'+fmtInp(row.cantidad,DEC_CANT)+'" step="any" onchange="onChangeCant('+idx+',this.value)" onkeydown="onCantKeydown(event,'+idx+')" />'+
        '</td>'+
        '<td style="text-align:right;font-weight:600;">$'+fmt(row.subtotal)+'</td>'+
        '<td style="text-align:center;">'+
          '<button type="button" onclick="eliminarFila('+idx+')" style="background:none;border:none;color:#e74a3b;font-size:.9rem;cursor:pointer;padding:0 .2rem;" title="Quitar">✕</button>'+
        '</td>';
      tbody.appendChild(tr);
    });
    recalcularTotales();
  }

  window.onChangeCant    = function(idx,val){ _rows[idx].cantidad=parseFloat(val)||0; recalcularFila(_rows[idx]); renderGrilla(); };
  window.onChangeDr      = function(idx,val){ var dr=parseFloat(val)||0; _rows[idx].descRec=_drMode==='desc'?-Math.abs(dr):Math.abs(dr); recalcularFila(_rows[idx]); renderGrilla(); };
  window.rowSelChange    = function(idx,v){ _rows[idx].sel=v; };
  window.seleccionarTodas= function(v){ _rows.forEach(r=>r.sel=v); renderGrilla(); };
  window.onCantKeydown= function(e,idx){
    if(e.key!=='Enter') return;
    e.preventDefault();
    setTimeout(function(){ var el=document.getElementById(_lastProdInput); if(el) el.focus(); }, 30);
  };
  window.eliminarFila = function(idx){ _rows.splice(idx,1); renderGrilla(); };

  // ── Descuento general (%) sobre Total S/IVA — solo modo por línea (BONIF===1) ──
  function getDescGeneralPct(){
    if (BONIF !== 1) return 0;
    var el = document.getElementById('txtDescGeneralPct');
    var v = el ? (parseFloat(el.value)||0) : 0;
    if (v < 0)   v = 0;
    if (v > 100) v = 100;
    return v;
  }
  window.onChangeDescuentoGeneral = function(){ recalcularTotales(); };

  // ── Totales ────────────────────────────────────────────────────────────────
  function recalcularTotales(){
    var iva    = parseFloat(document.getElementById('txtIva').value)||0;
    var impPct = parseFloat(document.getElementById('cboIngBrutos').value)||0;
    var subtBruto=0, totDescRec=0, subtSIvaBruto=0;
    _rows.forEach(function(r){
      var c=+r.cantidad||0; var pSIva=+r.precioSinIva||0; var sSIva=+r.subtotalSIva||0;
      subtBruto     += pSIva*c;
      totDescRec    += (sSIva-pSIva)*c;
      subtSIvaBruto += sSIva*c;
    });

    // Descuento general: netea el Total S/IVA (no altera las líneas)
    var dGralPct = getDescGeneralPct();
    var factor   = 1 - dGralPct/100;
    var descGeneralImporte = subtSIvaBruto * dGralPct/100;
    var subtSIva = subtSIvaBruto * factor;

    var totIva=subtSIva*iva/100;
    var totImp=subtSIva*impPct/100;
    var total =subtSIva+totIva+totImp;

    document.getElementById('tot-subtBruto').textContent='$'+fmt(subtBruto);
    document.getElementById('tot-subtSIva').textContent ='$'+fmt(subtSIva);
    document.getElementById('tot-iva').textContent      ='$'+fmt(totIva);
    document.getElementById('lbl-iva').textContent      ='IVA '+fmt(iva)+'%';
    document.getElementById('tot-total').textContent    ='$'+fmt(total);

    var rowDG=document.getElementById('rowDescGeneral');
    if (rowDG){
      if (dGralPct>0){
        document.getElementById('tot-descGeneral').textContent='-$'+fmt(descGeneralImporte);
        rowDG.style.display='';
      } else { rowDG.style.display='none'; }
    }

    var rowDR=document.getElementById('rowTotDescRec');
    if (Math.abs(totDescRec)>=0.005){
      document.getElementById('lbl-descRec').textContent=(totDescRec<0?'Descuentos':'Recargos');
      document.getElementById('tot-descRec').textContent='$'+fmt(totDescRec);
      rowDR.style.display='';
    } else { rowDR.style.display='none'; }

    var rowImp=document.getElementById('rowTotImpuesto');
    if (impPct>0){
      document.getElementById('lbl-impuesto').textContent='Ing. Brutos '+fmt(impPct)+'%';
      document.getElementById('tot-impuesto').textContent='$'+fmt(totImp);
      rowImp.style.display='';
    } else { rowImp.style.display='none'; }
  }
  window.recalcularTodo=function(){ _rows.forEach(r=>recalcularFila(r)); renderGrilla(); };

  // ── Desc/Rec ───────────────────────────────────────────────────────────────
  window.setDrMode=function(mode){
    _drMode=mode;
    document.getElementById('btnDesc').classList.toggle('active',mode==='desc');
    document.getElementById('btnRec').classList.toggle('active',mode==='rec');
  };
  window.aplicarDescRec=function(){
    var pct=parseFloat(document.getElementById('txtDrPct').value)||0;
    var dr=_drMode==='desc'?-Math.abs(pct):Math.abs(pct);
    if (BONIF===1){
      var sel=_rows.filter(r=>r.sel);
      if (!sel.length){ showAlert('Seleccione al menos una fila para aplicar desc/rec.'); return; }
      sel.forEach(r=>{ r.descRec=dr; recalcularFila(r); });
    } else {
      _rows.forEach(r=>{ r.descRec=dr; recalcularFila(r); });
    }
    renderGrilla();
  };
  window.limpiarDescRec=function(){
    _rows.forEach(r=>{ r.descRec=0; recalcularFila(r); });
    document.getElementById('txtDrPct').value='0';
    renderGrilla();
  };

  // ── Búsqueda de productos ──────────────────────────────────────────────────
  async function _buscarProducto(q, tipo){
    if (!q) return [];
    var provs='';
    if (FILTRA_PROV===1) provs=[...document.querySelectorAll('.chk-prov:checked')].map(c=>c.value).join(',');
    var url='?handler=BuscarProductos&q='+encodeURIComponent(q)+'&tipo='+tipo+'&proveedores='+encodeURIComponent(provs);
    try { return await (await fetch(url)).json(); } catch(ex){ return []; }
  }

  function _agregarOSumar(prod, cantidad){
    var existente=_rows.find(r=>r.fkProducto===prod.productoId);
    if (existente){
      existente.cantidad=(+existente.cantidad||0)+(+cantidad||0);
      recalcularFila(existente);
    } else {
      var row={
        fkProducto  : prod.productoId,
        codBarras   : prod.codBarras   ||'',
        codProveedor: prod.codProveedor||'',
        descripcion : prod.descripcion ||'',
        precioSinIva: prod.precioSinIva||0,
        descRec     : 0,
        cantidad    : +cantidad||0,
        stock       : prod.stock       ||0,
        fraccionado : prod.fraccionado ||false,
        costo       : prod.costo       ||0,
        dolarizado  : prod.dolarizado  ||false,
        sel         : false
      };
      recalcularFila(row);
      _rows.push(row);
    }
    renderGrilla();
  }

  async function _fetchStockRows(){
    var ids=_rows.map(r=>r.fkProducto).filter(id=>id>0);
    if (!ids.length) return;
    try {
      var stocks=await (await fetch('?handler=StockProductos&ids='+ids.join(','))).json();
      _rows.forEach(r=>{ if(stocks[r.fkProducto]!==undefined) r.stock=stocks[r.fkProducto]; });
      renderGrilla();
    } catch(e){}
  }

  function _enviarACantidad(prod, origenId){
    _prodPending=prod;
    _lastProdInput=origenId;
    var lbl=document.getElementById('lblProdPend');
    if (lbl){ lbl.textContent='→ '+(prod.descripcion||''); lbl.style.display=''; }
    var c=document.getElementById('txtBusqCant');
    c.value='1';
    setTimeout(()=>{ c.focus(); c.select(); },0);
  }
  function _limpiarPendiente(){
    _prodPending=null;
    var lbl=document.getElementById('lblProdPend');
    if (lbl){ lbl.textContent=''; lbl.style.display='none'; }
  }

  // ── Cód. Barras ────────────────────────────────────────────────────────────
  window.onBusqCBKeydown=async function(e){
    if (e.key==='Escape'){ e.target.value=''; return; }
    if (e.key!=='Enter') return;
    e.preventDefault();
    var inp=document.getElementById('txtBusqCB');
    var q=inp.value.trim(); if (!q) return;
    var lista=await _buscarProducto(q,'codBarras');
    if (!lista.length){ showAlert('Producto no encontrado.'); inp.select(); return; }
    var prod=lista[0];
    if (TIENE_CB===1){ _agregarOSumar(prod,1); inp.value=''; inp.focus(); }
    else { inp.value=''; _enviarACantidad(prod,'txtBusqCB'); }
  };

  // ── Cód. Proveedor ─────────────────────────────────────────────────────────
  window.onBusqCPKeydown=async function(e){
    if (e.key==='Escape'){ e.target.value=''; return; }
    if (e.key!=='Enter') return;
    e.preventDefault();
    var inp=document.getElementById('txtBusqCP');
    var q=inp.value.trim(); if (!q) return;
    var lista=await _buscarProducto(q,'codProveedor');
    if (!lista.length){ showAlert('Producto no encontrado por cód. proveedor.'); inp.select(); return; }
    var prod=lista[0];
    inp.value='';
    _enviarACantidad(prod,'txtBusqCP');
  };

  // ── Descripción (autocomplete) ─────────────────────────────────────────────
  window.buscarProductoDesc=function(){
    clearTimeout(_descTimer);
    var q=document.getElementById('txtBusqDesc').value.trim();
    var ac=document.getElementById('acDesc');
    if (q.length<(INDICE_BUSQ||2)){ ac.style.display='none'; ac.innerHTML=''; _descResults=[]; return; }
    _descTimer=setTimeout(async function(){
      var lista=await _buscarProducto(q,'descripcion');
      _descResults=lista;
      _descSelIdx=-1;
      ac.innerHTML='';
      if (!lista.length){ ac.style.display='none'; return; }
      lista.forEach(function(prod,i){
        var div=document.createElement('div');
        div.className='ac-item';
        div.innerHTML='<strong>'+escHtml(prod.descripcion||'')+'</strong>'
          +' | P.S/IVA: $'+fmt(prod.precioSinIva);
        div.addEventListener('click',function(){ _seleccionarProdDesc(i); });
        ac.appendChild(div);
      });
      ac.style.display='block';
    },250);
  };
  function _seleccionarProdDesc(idx){
    if (idx===undefined) idx=_descSelIdx>=0?_descSelIdx:0;
    var prod=_descResults[idx];
    if (!prod) return;
    var ac=document.getElementById('acDesc');
    ac.style.display='none'; ac.innerHTML='';
    _descResults=[]; _descSelIdx=-1;
    document.getElementById('txtBusqDesc').value='';
    _enviarACantidad(prod,'txtBusqDesc');
  }
  window.onBusqDescKeydown=function(e){
    var ac=document.getElementById('acDesc');
    var items=ac.querySelectorAll('.ac-item');
    if (e.key==='ArrowDown'){ e.preventDefault(); _descSelIdx=Math.min(_descSelIdx+1,items.length-1); items.forEach(function(it,i){it.classList.toggle('active',i===_descSelIdx);}); if(items[_descSelIdx]) items[_descSelIdx].scrollIntoView({block:'nearest'}); }
    else if (e.key==='ArrowUp'){ e.preventDefault(); _descSelIdx=Math.max(_descSelIdx-1,0); items.forEach(function(it,i){it.classList.toggle('active',i===_descSelIdx);}); if(items[_descSelIdx]) items[_descSelIdx].scrollIntoView({block:'nearest'}); }
    else if (e.key==='Enter'){ e.preventDefault(); if(_descSelIdx>=0){ _seleccionarProdDesc(); return; } if(_descResults.length===1){ _descSelIdx=0; _seleccionarProdDesc(); return; } }
    else if (e.key==='Escape'){ ac.style.display='none'; ac.innerHTML=''; _descResults=[]; _descSelIdx=-1; }
  };

  // ── Cantidad pendiente ─────────────────────────────────────────────────────
  window.onBusqCantKeydown=function(e){
    if (e.key!=='Enter') return;
    e.preventDefault();
    if (!_prodPending){ var b=document.getElementById(_lastProdInput); if(b) b.focus(); return; }
    var cant=parseFloat(document.getElementById('txtBusqCant').value)||0;
    if (cant<=0){ showAlert('Cantidad inválida.'); return; }
    _agregarOSumar(_prodPending,cant);
    _limpiarPendiente();
    document.getElementById('txtBusqCant').value='1';
    var b=document.getElementById(_lastProdInput); if(b) b.focus();
  };

  // ── Modal buscar venta ─────────────────────────────────────────────────────
  window.abrirBuscarVenta=function(){
    new bootstrap.Modal(document.getElementById('modalBuscarVenta')).show();
  };

  window.buscarVentasModal=async function(){
