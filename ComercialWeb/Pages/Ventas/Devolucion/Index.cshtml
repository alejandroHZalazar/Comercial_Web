  window.cargarVenta=async function(ventaId, fkCliente){
    bootstrap.Modal.getInstance(document.getElementById('modalBuscarVenta'))?.hide();

    // Cargar cliente
    await cargarClientePorId(fkCliente||0);

    // Cargar detalle de la venta
    var resp=await fetch('?handler=VentaDetalle&id='+ventaId);
    var r   =await resp.json();
    if (!r.ok){ showAlert('No se pudo cargar la venta.'); return; }
    var v=r.venta;

    // Setear IVA
    var selIva=document.getElementById('txtIva');
    for (var i=0;i<selIva.options.length;i++){
      if (Math.abs(parseFloat(selIva.options[i].value)-(v.iva??0))<0.001){ selIva.selectedIndex=i; break; }
    }

    // Setear IIBB
    var selIibb=document.getElementById('cboIngBrutos');
    for (var j=0;j<selIibb.options.length;j++){
      if (Math.abs(parseFloat(selIibb.options[j].value)-(v.impuesto??0))<0.001){ selIibb.selectedIndex=j; break; }
    }

    // Desc/Rec global de la venta.
    // En modo por línea (BONIF===1) v.descuento es el descuento general sobre el Total S/IVA:
    // NO se explota a las líneas; se precarga (heredado, editable) en el control.
    var descGlobal = (BONIF !== 1 && v.descuento != null) ? (v.descuento*-1+(v.recargo??0)) : null;
    if (BONIF === 1){
      var dgEl = document.getElementById('txtDescGeneralPct');
      if (dgEl) dgEl.value = (v.descuento != null && v.descuento > 0) ? v.descuento : 0;
    }

    // Armar filas
    _rows=[];
    _ventaId=ventaId;
    document.getElementById('hVentaId').value=ventaId;

    (v.detalle||[]).forEach(function(d){
      var dr=descGlobal!==null?descGlobal:((d.descuento??0)*-1+(d.recargo??0));
      var row={
        fkProducto  : d.fkProducto,
        codBarras   : d.codBarras   ||'',
        codProveedor: d.codProveedor||'',
        descripcion : d.descripcion ||'',
        precioSinIva: d.precioSinIva||0,
        descRec     : dr,
        cantidad    : d.cantidad    ||0,
        stock       : 0,
        fraccionado : false,
        costo       : 0,
        sel         : false
      };
      recalcularFila(row);
      _rows.push(row);
    });
    renderGrilla();
    _fetchStockRows();

    // Guardar datos de la venta para el modal NC
    var bvItem = _bvResultados.find(function(r){ return r.ventaId===ventaId; });
    _ventaFactura  = bvItem ? (bvItem.factura  || '') : '';
    _ventaFechaISO = bvItem ? (bvItem.fecha    || '') : '';

    // Badge en header
    document.getElementById('badgeVentaId').textContent=ventaId;
    document.getElementById('ventaCargadaBadge').style.display='';
  };

  // ── Ver detalle de venta (desde modal de búsqueda) ────────────────────────
  window.verDetalleVenta=function(idx, ventaId, fkCliente){
    _dvVentaActual = ventaId;
    _dvFkCliente   = fkCliente;
    var item = _bvResultados[idx] || null;
    var fp   = item ? (item.formasPago || []) : [];

    document.getElementById('dvDetTitulo').textContent  = 'Venta #' + ventaId;
    document.getElementById('dvDet-fecha').textContent  = item ? fmtDate(item.fecha) : '';
    document.getElementById('dvDet-factura').textContent= (item && item.factura) ? item.factura : '—';
    document.getElementById('dvDet-cliente').textContent= '';
    document.getElementById('dvDet-condiva').textContent= '';

    document.getElementById('dvDetLoadingRow').style.display = '';
    document.getElementById('dvDetContenido').style.display  = 'none';

    // Abrir modal detalle (mantener el de búsqueda abierto debajo)
    new bootstrap.Modal(document.getElementById('modalDetalleVenta')).show();

    fetch('?handler=VentaDetalle&id=' + ventaId)
      .then(function(r){ return r.json(); })
      .then(function(res){
        document.getElementById('dvDetLoadingRow').style.display = 'none';
        if (!res.ok){ alert('No se pudo cargar el detalle de la venta.'); return; }

        var v   = res.venta;
        var iva = v.iva      || 0;
        var imp = v.impuesto || 0;

        document.getElementById('dvDet-cliente').textContent = v.nombreCliente          || '—';
        document.getElementById('dvDet-condiva').textContent = v.condIvaDescripcion     || '—';

        // Desc/Rec global o por línea.
        // En modo por línea (BONIF===1) v.descuento es un descuento general sobre el Total S/IVA.
        var descGlobal = (BONIF !== 1 && v.descuento != null)
          ? (v.descuento * -1 + (v.recargo || 0))
          : null;
        var descGeneralVis = (BONIF === 1 && v.descuento != null && v.descuento > 0) ? v.descuento : 0;

        // Llenar tabla
        var tbody = document.getElementById('dvDetTbody');
        tbody.innerHTML = '';
        var subtBruto = 0, subtSIvaT = 0;

        (v.detalle || []).forEach(function(d){
          var dr      = descGlobal !== null
            ? descGlobal
            : ((d.descuento || 0) * -1 + (d.recargo || 0));
          var pSIva   = d.precioSinIva || 0;
          var subSIva = pSIva * (1 + dr / 100);
          var pConIva = subSIva * (1 + iva / 100);
          var cant    = d.cantidad || 0;
          var totLin  = pConIva * cant;

          subtBruto += pSIva   * cant;
          subtSIvaT += subSIva * cant;

          var drColor = dr < 0 ? 'color:#e74a3b;' : dr > 0 ? 'color:#1cc88a;' : '';
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + escHtml(d.descripcion || '') + '</td>' +
            '<td style="text-align:right;">$' + fmt(pSIva) + '</td>' +
            '<td style="text-align:right;' + drColor + '">' + fmt(dr) + '%</td>' +
            '<td style="text-align:right;">$' + fmt(subSIva) + '</td>' +
            '<td style="text-align:right;">$' + fmt(pConIva) + '</td>' +
            '<td style="text-align:right;">'  + fmt(cant)    + '</td>' +
            '<td style="text-align:right;font-weight:600;">$' + fmt(totLin) + '</td>';
          tbody.appendChild(tr);
        });

        // Totales
        var descRecNom = subtSIvaT - subtBruto;   // desc/rec por línea (nominal)

        // Descuento general: netea Subtotal s/IVA, IVA e IIBB (no altera las líneas)
        var factorDG       = 1 - descGeneralVis / 100;
        var descGeneralImp = subtSIvaT * descGeneralVis / 100;
        var subtSIvaNeto   = subtSIvaT * factorDG;
        var ivaAmt     = subtSIvaNeto * iva / 100;
        var iibbAmt    = subtSIvaNeto * imp / 100;

        document.getElementById('dvDet-subtBruto').textContent = '$' + fmt(subtBruto);

        var rowDR = document.getElementById('dvRowDescRec');
        if (Math.abs(descRecNom) > 0.001){
          document.getElementById('dvDet-lbl-descRec').textContent =
            descRecNom < 0 ? 'Descuento' : 'Recargo';
          document.getElementById('dvDet-descRecAmt').textContent =
            (descRecNom < 0 ? '–$' : '+$') + fmt(Math.abs(descRecNom));
          document.getElementById('dvDet-descRecAmt').style.color = descRecNom < 0 ? '#e74a3b' : '#1cc88a';
          rowDR.style.display = '';
        } else {
          rowDR.style.display = 'none';
        }

        var rowDG = document.getElementById('dvRowDescGeneral');
        if (descGeneralVis > 0){
          document.getElementById('dvDet-lbl-descGeneral').textContent = 'Desc. General ' + fmt(descGeneralVis) + '%';
          document.getElementById('dvDet-descGeneralAmt').textContent  = '–$' + fmt(descGeneralImp);
          document.getElementById('dvDet-descGeneralAmt').style.color  = '#e74a3b';
          rowDG.style.display = '';
        } else {
          rowDG.style.display = 'none';
        }

        document.getElementById('dvDet-subtSIva').textContent = '$' + fmt(subtSIvaNeto);
        document.getElementById('dvDet-lbl-iva').textContent  = 'IVA ' + fmt(iva) + '%';
        document.getElementById('dvDet-ivaAmt').textContent   = '$' + fmt(ivaAmt);
        document.getElementById('dvDet-lbl-iibb').textContent = 'IIBB ' + fmt(imp) + '%';
        document.getElementById('dvDet-iibbAmt').textContent  = iibbAmt > 0 ? '$' + fmt(iibbAmt) : '—';
        document.getElementById('dvDet-total').textContent    = '$' + fmt(subtSIvaNeto + ivaAmt + iibbAmt);

        // Formas de pago
        var secFP   = document.getElementById('dvSeccionFormasPago');
        var listaFP = document.getElementById('dvListaFormasPago');
        listaFP.innerHTML = '';
        if (fp.length > 0){
          fp.forEach(function(fpItem){
            var row = document.createElement('div');
            row.className = 'dv-fp-row';
            row.innerHTML = '<span>' + escHtml(fpItem.medioPago || 'Efectivo') + '</span>';
            listaFP.appendChild(row);
          });
          secFP.style.display = '';
        } else {
          secFP.style.display = 'none';
        }

        document.getElementById('dvDetContenido').style.display = '';
      })
      .catch(function(){
        document.getElementById('dvDetLoadingRow').style.display = 'none';
        alert('Error al cargar el detalle.');
      });
  };

  window.usarVentaDesdeDetalle=function(){
    bootstrap.Modal.getInstance(document.getElementById('modalDetalleVenta'))?.hide();
    // Cerrar también el modal de búsqueda si estaba abierto
    var mbv = bootstrap.Modal.getInstance(document.getElementById('modalBuscarVenta'));
    if (mbv) mbv.hide();
    cargarVenta(_dvVentaActual, _dvFkCliente);
  };

  // ── Devolver ───────────────────────────────────────────────────────────────
  window.devolver=function(){
    if (_clienteId<=0){ showAlert('Debe seleccionar un cliente.'); return; }
    if (!_rows.length){ showAlert('Debe agregar al menos un producto.'); return; }
    if (COMISIONA===1){
      var elVend=document.getElementById('cboVendedor');
      if (!elVend||!(parseInt(elVend.value)||0)){ showAlert('Debe seleccionar un vendedor.'); return; }
    }

    if (FACT_ELEC===1){
      // Pre-llenar modal NC
      var iva  = parseFloat(document.getElementById('txtIva').value)       || 0;
      var imp  = parseFloat(document.getElementById('cboIngBrutos').value) || 0;
      var tot  = _calcTotal();

      document.getElementById('ncImporte').value = tot.toFixed(2).replace('.',',');
      document.getElementById('ncIva').value     = iva;
      document.getElementById('ncIibb').value    = imp;

      // Nro de factura asociada: tomar el numero del string (parte después del último guion)
      var nroFac = 0;
      if (_ventaFactura){
        var partes = _ventaFactura.split('-');
        nroFac = parseInt(partes[partes.length-1]) || 0;
      }
      document.getElementById('ncNroFactura').value = nroFac || '';

      // Fecha: convertir ISO a yyyy-mm-dd para input[type=date]
      if (_ventaFechaISO){
        try {
          var d = new Date(_ventaFechaISO);
          var yyyy = d.getFullYear();
          var mm   = String(d.getMonth()+1).padStart(2,'0');
          var dd   = String(d.getDate()).padStart(2,'0');
          document.getElementById('ncFechaFactura').value = yyyy+'-'+mm+'-'+dd;
        } catch(e){ document.getElementById('ncFechaFactura').value=''; }
      } else {
        document.getElementById('ncFechaFactura').value='';
      }

      document.getElementById('ncError').style.display = 'none';
      new bootstrap.Modal(document.getElementById('modalNC')).show();
    } else {
      procesarDevolucion(false);
    }
  };

  // Calcula el total desde los totales visuales (ya calculado en DOM)
  function _calcTotal(){
    var txt = document.getElementById('tot-total').textContent || '$0,00';
    return parseFloat(txt.replace('$','').replace(/\./g,'').replace(',','.')) || 0;
  }

  window.aceptarNC=function(){
    var errEl = document.getElementById('ncError');
    errEl.style.display = 'none';
    var nroFacVal=(document.getElementById('ncNroFactura').value||'').trim();
    if (!nroFacVal||nroFacVal==='0'||nroFacVal===''){ procesarDevolucion(false); return; }
    var nroFac=parseInt(nroFacVal,10);
    if (isNaN(nroFac)||nroFac<=0){
      errEl.textContent = 'El número de factura debe ser un valor numérico positivo.';
      errEl.style.display = 'block';
      return;
    }
    procesarDevolucion(true);
  };

  window.procesarDevolucion=async function(conNC){
    // Cerrar modal NC si estaba abierto
    var modalNC = document.getElementById('modalNC');
    if (modalNC){
      var bsNC = bootstrap.Modal.getInstance(modalNC);
      if (bsNC) bsNC.hide();
    }

    var iva  = parseFloat(document.getElementById('txtIva').value)       || 0;
    var imp  = parseFloat(document.getElementById('cboIngBrutos').value) || 0;
    var fkVend = 0, comision = 0;
    var elVend = document.getElementById('cboVendedor');
    if (elVend) fkVend = parseInt(elVend.value) || 0;
    var elCom = document.getElementById('txtComision');
    if (elCom) comision = parseFloat(elCom.value) || 0;

    // Construir filas para el request
    var filas = _rows.map(function(r){
      return {
        fkProducto    : r.fkProducto,
        precioSinIva  : r.precioSinIva  || 0,
        precioConIva  : r.precioConIva  || 0,
        cantidad      : r.cantidad      || 0,
        descRec       : r.descRec       || 0,
        subtotalSinIva: r.subtotalSIva  || 0,
        costo         : r.costo         || 0
      };
    });

    var dGralPct = getDescGeneralPct();
    var request = {
      fkCliente : _clienteId,
      iva       : iva,
      impuesto  : imp,
      fkVendedor: fkVend,
      comision  : comision / 100,
      total     : _calcTotal(),                       // ya neteado por el descuento general
      descuento : dGralPct > 0 ? dGralPct : null,      // % descuento general (modo por línea)
      filas     : filas,
      nroFacturaAsociada: null,
      fechaFacturaAsoc  : null
    };

    // NC fiscal
    if (conNC){
      var nroFac = parseInt(document.getElementById('ncNroFactura').value) || 0;
      if (nroFac > 0){
        request.nroFacturaAsociada = nroFac;
        // Convertir fecha yyyy-mm-dd → dd/MM/yyyy
        var fechaVal = document.getElementById('ncFechaFactura').value;
        if (fechaVal){
          var partes = fechaVal.split('-');
          if (partes.length===3)
            request.fechaFacturaAsoc = partes[2]+'/'+partes[1]+'/'+partes[0];
        }
      }
    }

    // Deshabilitar botón mientras procesa
    var btn = document.getElementById('btnDevolver');
    if (btn){ btn.disabled=true; btn.textContent='Procesando...'; }

    try {
      var resp = await fetch('?handler=Devolver', {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify(request)
      });
      var res = await resp.json();

      if (!res.ok){
        showAlert(res.error || 'Error al procesar la devolución.');
        return;
      }

      // Si la devolución superó 130 ítems, se emitió más de una NC electrónica.
      var comprobantesNC = (res.comprobantes && res.comprobantes.length) ? res.comprobantes : [];

      if (res.warning){
        // Devolución OK pero error FE
        alert('Devolución N° ' + res.devolucionId + ' registrada.\n\n⚠ ' + res.warning);
      } else if (comprobantesNC.length > 1){
        var detalleNC = comprobantesNC.map(function(c){
          return 'Parte ' + c.parte + '/' + c.totalPartes + ' — CAE: ' + (c.cae || '');
        }).join('\n');
        alert('Devolución N° ' + res.devolucionId + ' registrada correctamente.\n\nSe emitieron ' +
          comprobantesNC.length + ' notas de crédito:\n' + detalleNC);
      } else {
        alert('Devolución N° ' + res.devolucionId + ' registrada correctamente.');
      }

      // Si se generaron comprobantes fiscales (NC electrónica), abrir todos los PDFs fiscales.
      // Si no, abrir el comprobante interno (X).
      if (comprobantesNC.length > 1){
        comprobantesNC.forEach(function(c){ if (c.pdfUrl) window.open(c.pdfUrl, '_blank'); });
      } else if (res.pdfUrl){
        window.open(res.pdfUrl, '_blank');
      } else {
        var printUrl = HACE_TK===1
          ? '/Ventas/Devolucion/TicketX/' + res.devolucionId
          : '/Ventas/Devolucion/ComprobanteX/' + res.devolucionId;
        window.open(printUrl, '_blank');
      }

      // Reiniciar formulario
      _rows=[]; _clienteId=@(p.TieneConsumidorFinal==1?p.ClienteConsumidorFinal:0);
      _ventaId=0; _ventaFactura=''; _ventaFechaISO='';
      document.getElementById('hVentaId').value='0';
      document.getElementById('hClienteId').value='@(p.TieneConsumidorFinal==1?p.ClienteConsumidorFinal.ToString():"0")';
      document.getElementById('ventaCargadaBadge').style.display='none';
      @if (p.TieneConsumidorFinal==1){
        <text>cargarClientePorId(@p.ClienteConsumidorFinal);</text>
      } else {
        <text>
      document.getElementById('clienteInfo').style.display='none';
      document.getElementById('clienteVacio').style.display='';
        </text>
      }
      renderGrilla();

    } catch(ex){
      showAlert('Error de conexión al procesar la devolución.');
    } finally {
      if (btn){ btn.disabled=false; btn.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" style="vertical-align:-.2em;margin-right:.4rem;"><path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4h-3.5zM8.5 8.5a.5.5 0 0 0-1 0v1.793L6.354 9.146a.5.5 0 1 0-.708.708l2 2a.5.5 0 0 0 .708 0l2-2a.5.5 0 0 0-.708-.708L8.5 10.293V8.5z"/></svg>Devolver'; }
    }
  };

  // ── Inicializar fechas del modal ───────────────────────────────────────────
  (function initFechas(){
    var hoy  =new Date();
    var anio =hoy.getFullYear();
    var mes  =String(hoy.getMonth()+1).padStart(2,'0');
    var dia  =String(hoy.getDate()).padStart(2,'0');
    document.getElementById('bvDesde').value=anio+'-'+mes+'-01';
    document.getElementById('bvHasta').value=anio+'-'+mes+'-'+dia;
  })();

  // ── Columna Sel: visible solo si BonificacionPorLinea = 1 ─────────────────
  if (BONIF===0){
    document.querySelectorAll('#thSel,[data-sel-col]').forEach(function(el){ el.style.display='none'; });
  }

  // ── Consumidor final: cargar cliente por defecto si corresponde ───────────
  @if (p.TieneConsumidorFinal == 1)
  {
    <text>
  cargarClientePorId(@p.ClienteConsumidorFinal);
    </text>
  }

})();
</script>
}
