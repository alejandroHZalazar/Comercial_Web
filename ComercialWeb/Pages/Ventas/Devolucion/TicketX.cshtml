@page "{id:long}"
@model Comercial_Web.Pages.Ventas.Devolucion.TicketXModel
@{
    Layout = null;
    ViewData["Title"] = "Ticket X - Devolución";
    var fmt  = (decimal v) => v.ToString("N2", new System.Globalization.CultureInfo("es-AR"));
    var fmtC = (decimal v, int dec) => v.ToString("N" + dec, new System.Globalization.CultureInfo("es-AR"));

    // Escalas en función del ancho (mm). Mínimo razonable 48mm.
    int anchoMm = Model.AnchoMm <= 0 ? 80 : Model.AnchoMm;
    // Fuentes dinámicas
    double fBase  = anchoMm <= 58 ? 10.0 : anchoMm <= 72 ? 11.0 : 12.0;
    double fChica = fBase - 1.5;
    double fTit   = fBase + 3.0;
    double fX     = anchoMm <= 58 ? 38.0 : 52.0;
    double fTotal = fBase + 4.0;
    string pad    = anchoMm <= 58 ? "2mm" : "3mm";
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <title>Ticket X - Devolución N° @(Model.Devolucion?.DevolucionId)</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    @@page { size: @(anchoMm)mm auto; margin: 0; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body { font-family: "Consolas","Courier New",monospace; font-size: @(fBase.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; color: #000; }
    .ticket { width: @(anchoMm)mm; padding: @pad; }
    .center { text-align: center; }
    .bold   { font-weight: 700; }
    .sep    { border-top: 1px dashed #000; margin: 2mm 0; }
    .sep-d  { border-top: 2px solid #000; margin: 2mm 0; }
    .xbig   { font-size: @(fX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; font-weight: 900; line-height: 1; letter-spacing: 4px; }
    .tit    { font-size: @(fTit.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; font-weight: 700; }
    .small  { font-size: @(fChica.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; }
    .row    { display: flex; justify-content: space-between; gap: 2mm; }
    .leyenda{ border: 1px solid #000; padding: 1mm 2mm; display: inline-block; margin-top: 1mm; text-transform: uppercase; font-weight: 700; font-size: @(fChica.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; }
    .devol  { border: 1px solid #000; padding: 1mm 2mm; display: inline-block; margin-top: 1mm; text-transform: uppercase; font-weight: 700; font-size: @(fChica.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; }
    .item   { margin-bottom: 1.2mm; }
    .item .desc { word-wrap: break-word; }
    .item .cb   { font-size: @(fChica.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; color: #000; }
    .total  { font-size: @(fTotal.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))pt; font-weight: 900; }

    .error  { padding: 4mm; color: #a00; font-weight: 700; }
    .no-print { text-align: center; margin: 4mm 0; }
    .no-print button { padding: 2mm 4mm; font-size: 10pt; cursor: pointer; }
    @@media print { .no-print { display: none !important; } }
  </style>
</head>
<body>

@if (!string.IsNullOrEmpty(Model.Error))
{
  <div class="error">@Model.Error</div>
}
else if (Model.Devolucion != null)
{
  var d = Model.Devolucion;

  <div class="ticket">

    @* ── Letra X y leyenda ─────────────────────────────── *@
    <div class="center">
      <div class="xbig">X</div>
      <div class="leyenda">No válido como Documento Fiscal</div>
      <div class="devol">Nota de Devolución</div>
    </div>

    <div class="sep"></div>

    @* ── Datos empresa ──────────────────────────────────── *@
    <div class="center">
      @if (!string.IsNullOrWhiteSpace(Model.EmpresaNombre))
      { <div class="tit">@Model.EmpresaNombre</div> }
      @if (!string.IsNullOrWhiteSpace(Model.EmpresaRazon))
      { <div class="small">@Model.EmpresaRazon</div> }
      @if (!string.IsNullOrWhiteSpace(Model.EmpresaDirec))
      { <div class="small">@Model.EmpresaDirec</div> }
      @if (!string.IsNullOrWhiteSpace(Model.EmpresaTel))
      { <div class="small">Tel: @Model.EmpresaTel</div> }
    </div>

    <div class="sep"></div>

    @* ── Datos devolución / cliente ─────────────────────── *@
    <div class="row small">
      <span>N° @d.DevolucionId.ToString("D8")</span>
      <span>@(d.Fecha.HasValue ? d.Fecha.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(d.NombreCliente))
    {
      <div class="small"><span class="bold">Cliente:</span> @d.NombreCliente</div>
    }
    @if (!string.IsNullOrWhiteSpace(d.DireccionCliente))
    {
      <div class="small"><span class="bold">Dirección:</span> @d.DireccionCliente</div>
    }

    <div class="sep"></div>

    @* ── Detalle ────────────────────────────────────────── *@
    @{
      decimal ivaRate = d.Iva / 100m;
      // En modo descuento general (por línea) NO se usa la regla global: cada línea muestra su desc/rec propio
      bool tieneGlobalDR = !Model.EsDescuentoGeneral && d.Descuento.HasValue;
      decimal globalDR = tieneGlobalDR ? (d.Descuento ?? 0m) * -1m + (d.Recargo ?? 0m) : 0m;
    }
    @foreach (var det in d.Detalle)
    {
      decimal drPct   = tieneGlobalDR ? globalDR
                      : (det.Recargo.HasValue && det.Recargo > 0   ?  det.Recargo.Value
                       : det.Descuento.HasValue && det.Descuento > 0 ? -det.Descuento.Value
                       : 0m);
      decimal subSIva = det.PrecioSinIva * (1m + drPct / 100m);
      decimal precCIva= subSIva * (1m + ivaRate);
      decimal subt    = precCIva * det.Cantidad;

      <div class="item">
        @if (!string.IsNullOrWhiteSpace(det.CodBarras))
        {
          <div class="cb">@det.CodBarras</div>
        }
        <div class="desc">@(det.Descripcion ?? "")</div>
        <div class="row">
          <span class="small">@fmtC(det.Cantidad, 2) x $@fmt(precCIva)</span>
          <span class="bold">$@fmt(subt)</span>
        </div>
      </div>
    }

    <div class="sep-d"></div>

    @* ── Descuento general (modo por línea) ───────────────── *@
    @if (Model.EsDescuentoGeneral && Model.DescGeneralPct > 0)
    {
      <div class="row">
        <span>Desc. Gral @fmt(Model.DescGeneralPct)%</span>
        <span>-$@fmt(Model.TotDescGeneralImporte)</span>
      </div>
    }

    @* ── Total general ──────────────────────────────────── *@
    <div class="row total">
      <span>TOTAL DEV.</span>
      <span>$@fmt(Model.TotTotal)</span>
    </div>

    <div class="sep"></div>
    <div class="center small">Devolución registrada. ¡Gracias!</div>

    <div class="no-print">
      <button onclick="window.print()">Imprimir</button>
      <button onclick="window.close()">Cerrar</button>
    </div>
  </div>
}

<script>
  // Auto-print al cargar — sale a la impresora por defecto del navegador.
  window.addEventListener('load', function(){
    setTimeout(function(){ try { window.print(); } catch(e){} }, 150);
  });
</script>
</body>
</html>
