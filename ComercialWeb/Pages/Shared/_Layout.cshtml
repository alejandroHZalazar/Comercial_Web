@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Gestión Comercial")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Comercial_Web.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --sb-bg-1: #0d1b2a;
            --sb-bg-2: #15314f;
            --sb-text: #c8d3e3;
            --sb-text-dim: #8696b0;
            --sb-hover: rgba(92,179,255,.10);
            --sb-active-bar: #5cb3ff;
            --brand-1: #1a3a5c;
            --brand-2: #2e6da4;
            --content-bg: #f5f7fa;
            --topbar-bg: #ffffff;
            --border: #e3e6f0;
        }

        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            font-family: 'Inter', system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: var(--content-bg);
            color: #2c3e50;
            font-size: 14px;
        }

        /* ── SIDEBAR ──────────────────────────────────────────────────────── */
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            width: 240px;
            height: 100vh;
            background: linear-gradient(180deg, var(--sb-bg-1) 0%, var(--sb-bg-2) 100%);
            border-right: 1px solid rgba(255,255,255,.06);
            display: flex;
            flex-direction: column;
            z-index: 1030;
            box-shadow: 2px 0 12px rgba(0,0,0,.08);
        }

        .sb-header {
            padding: 1.1rem 1.15rem;
            border-bottom: 1px solid rgba(255,255,255,.07);
            display: flex; align-items: center; gap: .65rem;
            color: #fff;
        }
        .sb-header svg.logo {
            width: 34px; height: 34px;
            background: rgba(92,179,255,.15);
            border: 1px solid rgba(92,179,255,.3);
            padding: 6px; border-radius: 9px;
            color: #5cb3ff;
            flex-shrink: 0;
        }
        .sb-header .sb-title {
            font-size: .85rem; font-weight: 800;
            letter-spacing: .04em; text-transform: uppercase;
            line-height: 1.2;
        }
        .sb-header .sb-title small {
            display: block;
            font-size: .65rem; font-weight: 500;
            color: var(--sb-text-dim);
            text-transform: none; letter-spacing: 0;
            margin-top: .15rem;
        }

        /* Accordion del menú */
        .accordion {
            flex: 1;
            overflow-y: auto;
            padding: .75rem .55rem .5rem;
            background: transparent;
            border-radius: 0;
        }
        .accordion::-webkit-scrollbar { width: 6px; }
        .accordion::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.1); border-radius: 3px;
        }
        .accordion::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,.2); }

        .accordion-item {
            background: transparent !important;
            border: 0 !important;
            margin-bottom: .15rem;
            border-radius: 8px;
        }
        .accordion-header { margin: 0; }
        .accordion-button {
            background: transparent !important;
            color: var(--sb-text) !important;
            font-size: .82rem;
            font-weight: 600;
            padding: .65rem .85rem;
            border-radius: 8px !important;
            box-shadow: none !important;
            transition: background .18s, color .18s;
            letter-spacing: .015em;
        }
        .accordion-button:hover {
            background: var(--sb-hover) !important;
            color: #fff !important;
        }
        .accordion-button:not(.collapsed) {
            background: rgba(92,179,255,.10) !important;
            color: #fff !important;
        }
        .accordion-button::after {
            filter: invert(75%) sepia(20%) saturate(400%) hue-rotate(180deg) brightness(95%);
            width: .9rem; height: .9rem;
            background-size: .9rem;
        }
        .accordion-button:focus { box-shadow: none !important; }

        .accordion-body {
            padding: .25rem .35rem .55rem .35rem;
        }
        .accordion-body ul {
            list-style: none;
            padding: 0; margin: 0;
        }
        .accordion-body ul li {
            display: block;
            padding: 0;
            margin: .12rem 0;
            background: transparent !important;
            border-radius: 6px;
            transition: background .15s;
        }
        .accordion-body ul li:hover {
            background: var(--sb-hover) !important;
        }
        .accordion-body ul li a {
            display: flex !important;
            align-items: center;
            gap: .55rem;
            padding: .5rem .7rem .5rem .85rem;
            color: var(--sb-text) !important;
            font-size: .8rem;
            font-weight: 500;
            text-decoration: none !important;
            border-radius: 6px;
            transition: color .15s, transform .12s;
        }
        .accordion-body ul li a:hover {
            color: #fff !important;
            transform: translateX(2px);
        }
        .accordion-body ul li a::before {
            content: '';
            width: 5px; height: 5px;
            border-radius: 50%;
            background: rgba(200,211,227,.35);
            flex-shrink: 0;
            transition: background .15s, transform .15s;
        }
        .accordion-body ul li a:hover::before {
            background: var(--sb-active-bar);
            transform: scale(1.4);
        }
        /* Ocultar los iconos PNG viejos */
        .accordion-body ul li img.icono { display: none !important; }

        /* Footer del sidebar (usuario + logout) */
        .sb-footer {
            padding: .85rem 1rem;
            border-top: 1px solid rgba(255,255,255,.07);
            background: rgba(0,0,0,.18);
            display: flex; align-items: center; gap: .7rem;
        }
        .sb-avatar {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2e6da4, #5cb3ff);
            color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: .85rem;
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(92,179,255,.2);
        }
        .sb-userinfo {
            flex: 1; min-width: 0;
            color: #fff;
        }
        .sb-userinfo .sb-name {
            font-size: .8rem; font-weight: 600;
            white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis;
        }
        .sb-userinfo .sb-role {
            font-size: .68rem;
            color: var(--sb-text-dim);
            text-transform: uppercase; letter-spacing: .04em;
        }
        .sb-logout {
            background: transparent;
            border: 1px solid rgba(255,255,255,.12);
            color: var(--sb-text);
            border-radius: 7px;
            padding: .35rem .45rem;
            cursor: pointer;
            display: flex; align-items: center;
            transition: background .15s, color .15s, border-color .15s;
            text-decoration: none;
        }
        .sb-logout:hover {
            background: rgba(231,74,59,.18);
            border-color: rgba(231,74,59,.45);
            color: #ff8b80;
        }
        .sb-logout svg { width: 14px; height: 14px; }

        /* ── ÁREA DE CONTENIDO ──────────────────────────────────────────── */
        .content {
            margin-left: 240px;
            min-height: 100vh;
            background: var(--content-bg);
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--border);
            padding: .85rem 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 100;
            box-shadow: 0 1px 3px rgba(0,0,0,.025);
        }
        .topbar .tb-title {
            font-size: 1.05rem; font-weight: 700;
            color: var(--brand-1);
            margin: 0;
            letter-spacing: -.01em;
            display: flex; align-items: center; gap: .55rem;
        }
        .topbar .tb-title .tb-crumb {
            font-size: .72rem; font-weight: 500;
            color: #8696b0;
            text-transform: uppercase; letter-spacing: .06em;
            border-left: 1px solid #d6dfee;
            padding-left: .65rem; margin-left: .15rem;
        }
        .topbar .tb-meta {
            display: flex; align-items: center; gap: 1.1rem;
            color: #5a6b85; font-size: .82rem;
        }
        .topbar .tb-meta .tb-date {
            display: flex; align-items: center; gap: .4rem;
            text-transform: capitalize;
        }
        .topbar .tb-meta svg { width: 14px; height: 14px; opacity: .7; }
        .topbar .tb-logout {
            color: #5a6b85; text-decoration: none;
            display: flex; align-items: center; gap: .35rem;
            padding: .35rem .65rem;
            border-radius: 7px;
            font-size: .8rem; font-weight: 500;
            transition: all .15s;
            border: 1px solid transparent;
        }
        .topbar .tb-logout:hover {
            color: #b13428;
            background: #fff1ee;
            border-color: #f5b8b1;
        }

        main[role="main"] {
            padding: 1.5rem 1.75rem;
            flex: 1;
        }

        /* ── MOBILE ─────────────────────────────────────────────────────── */
        .btn-menu-toggle {
            position: fixed;
            top: 12px; left: 12px;
            z-index: 1060;
            background: var(--brand-1);
            border: 0;
            color: #fff;
            border-radius: 8px;
            padding: .45rem .65rem;
            font-size: 1.1rem;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(0,0,0,.2);
        }

        @@media (max-width: 767.98px) {
            .content { margin-left: 0; }
            .topbar { padding-left: 4rem; }
            .sidebar {
                transform: translateX(-100%);
                transition: transform .3s ease;
            }
            .sidebar.show { transform: translateX(0); }
            .sidebar-overlay {
                display: none;
                position: fixed; inset: 0;
                background: rgba(0,0,0,.5);
                z-index: 1020;
                backdrop-filter: blur(2px);
            }
            .sidebar-overlay.show { display: block; }
            main[role="main"] { padding: 1rem; }
            .topbar .tb-meta .tb-date { display: none; }
        }
    </style>
</head>
<body>
    <button class="btn-menu-toggle d-md-none" id="menuToggle" aria-label="Abrir menú">&#9776;</button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    @{
        var userName = User?.Identity?.Name ?? "Usuario";
        var userRole = User?.FindFirst("TipoUsuario")?.Value ?? "—";
        var initials = !string.IsNullOrWhiteSpace(userName)
            ? userName.Trim().Substring(0, 1).ToUpperInvariant()
            : "U";
    }

    <aside class="sidebar d-md-flex" id="sidebarMenu">
        <div class="sb-header">
            <svg class="logo" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 1.5A6.5 6.5 0 1 0 14.5 8 6.51 6.51 0 0 0 8 1.5zM6.5 12V4l5 4z"/>
            </svg>
            <div class="sb-title">
                Comercial
                <small>Sistema de Gestión</small>
            </div>
        </div>

        <div class="accordion" id="menuAccordion">
            @await Component.InvokeAsync("MainMenu")
        </div>

        <div class="sb-footer">
            <div class="sb-avatar" title="@userName">@initials</div>
            <div class="sb-userinfo">
                <div class="sb-name">@userName</div>
                <div class="sb-role">@userRole</div>
            </div>
            <a class="sb-logout" href="/Logout" title="Cerrar sesión">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                    <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                </svg>
            </a>
        </div>
    </aside>

    <div class="content">
        <header class="topbar">
            <h1 class="tb-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" style="color:#5cb3ff;">
                    <path d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5H3z"/>
                    <path d="M8.354 10.354 15.5 3.207 14.293 2 7.146 9.146a.5.5 0 0 0-.146.354v1.5a.5.5 0 0 0 .5.5H9a.5.5 0 0 0 .354-.146z"/>
                </svg>
                @(ViewData["Title"] ?? "Inicio")
                <span class="tb-crumb">Gestión Comercial</span>
            </h1>
            <div class="tb-meta">
                <span class="tb-date">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                    </svg>
                    @DateTime.Now.ToString("dddd dd 'de' MMMM, yyyy", new System.Globalization.CultureInfo("es-AR"))
                </span>
                <a class="tb-logout" href="/Logout" title="Cerrar sesión">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="14" height="14">
                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                    </svg>
                    Salir
                </a>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
    // ── Facturación Lotes: ítem oculto, se revela con F6 ─────────────────────
    (function () {
        var FL_HREF = '/Facturacion/FacturacionLotes';
        function getMenuLis() {
            var result = [];
            document.querySelectorAll('a[href="' + FL_HREF + '"]').forEach(function (a) {
                var li = a.closest('li');
                if (li) result.push(li);
            });
            return result;
        }
        document.addEventListener('DOMContentLoaded', function () {
            getMenuLis().forEach(function (li) { li.style.display = 'none'; });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'F6') return;
            e.preventDefault();
            getMenuLis().forEach(function (li) {
                li.style.display = '';
                var collapse = li.closest('.accordion-collapse');
                if (collapse && !collapse.classList.contains('show')) {
                    var inst = bootstrap.Collapse.getOrCreateInstance(collapse);
                    inst.show();
                }
            });
        });
    })();
    </script>
    <script>
        (function () {
            var toggle  = document.getElementById('menuToggle');
            var sidebar = document.getElementById('sidebarMenu');
            var overlay = document.getElementById('sidebarOverlay');
            function openMenu()  { sidebar.classList.add('show');    overlay.classList.add('show');    }
            function closeMenu() { sidebar.classList.remove('show'); overlay.classList.remove('show'); }
            if (toggle)  toggle.addEventListener('click',  function () {
                sidebar.classList.contains('show') ? closeMenu() : openMenu();
            });
            if (overlay) overlay.addEventListener('click', closeMenu);
        })();
    </script>
</body>
</html>
