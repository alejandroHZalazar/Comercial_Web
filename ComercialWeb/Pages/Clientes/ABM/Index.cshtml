@page
@model Comercial_Web.Pages.Clientes.ABM.IndexModel
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<style>
    /* ===== PAGE HEADER ===== */
    .page-header {
        background: linear-gradient(135deg, #1a2a4a 0%, #2d4a7a 100%);
        border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; color: #fff;
    }
    .page-header h4 { margin: 0; font-weight: 700; letter-spacing: .3px; }

    /* ===== SECTION CARDS ===== */
    .section-card {
        background: #fff; border: 1px solid #e3e6f0; border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 1.25rem;
    }
    .section-card-header {
        background: linear-gradient(90deg, #f0f4ff 0%, #f8f9fc 100%);
        border-bottom: 1px solid #e3e6f0; padding: .65rem 1.1rem;
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: .5rem;
    }
    .sch-left  { display: flex; align-items: center; gap: .5rem; }
    .sch-title { font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .5px; color: #4e73df; }
    .cnt-badge { background: #eef2ff; color: #4e73df; border-radius: 12px; padding: .15rem .55rem; font-size: .72rem; font-weight: 700; }
    .form-label { font-size: .82rem; font-weight: 600; color: #4a5568; margin-bottom: 3px; }

    /* ===== BUTTONS ===== */
    .btn-cli {
        border: none; border-radius: 8px; padding: .42rem 1rem; font-size: .83rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: .4rem;
        cursor: pointer; transition: all .18s; white-space: nowrap;
    }
    .btn-cli svg { width: 15px; height: 15px; flex-shrink: 0; }
    .btn-cli-primary   { background: #4e73df; color: #fff; } .btn-cli-primary:hover   { background: #3a5bc7; }
    .btn-cli-success   { background: #1cc88a; color: #fff; } .btn-cli-success:hover   { background: #17a673; }
    .btn-cli-danger    { background: #e74a3b; color: #fff; } .btn-cli-danger:hover    { background: #c93627; }
    .btn-cli-secondary { background: #858796; color: #fff; } .btn-cli-secondary:hover { background: #6a6b7a; }
    .btn-cli-warning   { background: #f6c23e; color: #222; } .btn-cli-warning:hover   { background: #e0a800; }
    .btn-cli-excel     { background: #217346; color: #fff; } .btn-cli-excel:hover     { background: #185c38; }
    .btn-cli-info      { background: #36b9cc; color: #fff; } .btn-cli-info:hover      { background: #258f9e; }
    .btn-cli-cobro     { background: #6f42c1; color: #fff; } .btn-cli-cobro:hover     { background: #59339d; }
    .btn-cli-nc        { background: #0f766e; color: #fff; } .btn-cli-nc:hover        { background: #0d5c57; }
    .btn-cli-nd { background: linear-gradient(135deg,#e67e22,#d35400); color:#fff; }
    .btn-cli-nd:hover { background: linear-gradient(135deg,#d35400,#b94300); }
    .nd-modal-header {
        background: linear-gradient(135deg,#e67e22,#d35400);
        padding:.75rem 1rem;
        display:flex;align-items:center;
    }
    .btn-cli:disabled  { opacity: .55; cursor: not-allowed; }
    .nc-modal-header   { background: linear-gradient(135deg, #0a4a44 0%, #0f766e 100%); padding: .9rem 1.25rem; display: flex; align-items: center; gap: .75rem; }
    .nc-sep            { height: 1px; background: linear-gradient(90deg, #e9f5f4, #b2dfdb, #e9f5f4); margin: .75rem 0; }

    /* ===== COBRO MODAL ===== */
    .cobro-plan-row { display:flex; gap:.5rem; align-items:flex-end; flex-wrap:wrap; margin-bottom:.5rem; }
    .cobro-plan-row .form-select, .cobro-plan-row .form-control { border-radius:8px; font-size:.83rem; }
    .cobro-lineas-table { width:100%; border-collapse:collapse; font-size:.8rem; margin-top:.35rem; }
    .cobro-lineas-table th { background:#1a2a4a; color:#fff; padding:.35rem .55rem; font-size:.68rem;
                             text-transform:uppercase; letter-spacing:.3px; }
    .cobro-lineas-table td { padding:.35rem .55rem; border-bottom:1px solid #f0f0f0; vertical-align:middle; }
    .cobro-lineas-table tbody tr:hover { background:#f8f0ff; }
    .cobro-total-bar { display:flex; justify-content:space-between; align-items:center;
                       background:#f0f4ff; border:1px solid #e3e6f0; border-radius:8px;
                       padding:.55rem 1rem; margin-top:.5rem; }
    .cobro-alerta { background:#fff3cd; border:1px solid #ffc107; border-radius:8px;
                    padding:.55rem .9rem; font-size:.82rem; color:#856404; margin-top:.4rem; display:none; }
    .cobro-success { background:#d4edda; border:1px solid #1cc88a; border-radius:8px;
                     padding:1rem 1.25rem; display:none; }
    .cc-fila-cobro:hover { background:#f0eaff !important; }
    .cc-fila-cobro.cc-fila-activa { background:#e8dff7 !important; outline:2px solid #6f42c1; }
    .btn-cc-reprint { background:none; border:1px solid #6f42c1; border-radius:5px; color:#6f42c1;
                      cursor:pointer; padding:2px 5px; line-height:1; }
    .btn-cc-reprint:hover { background:#6f42c1; color:#fff; }
    .cc-detalle-table { width:100%; border-collapse:collapse; font-size:.82rem; }
    .cc-detalle-table th { background:#6f42c1; color:#fff; padding:4px 8px; font-size:.72rem;
                           text-transform:uppercase; letter-spacing:.3px; font-weight:600; }
    .cc-detalle-table td { padding:4px 8px; border-bottom:1px solid #e3d9f5; }
    .cc-detalle-table tr:last-child td { border-bottom:none; }

    /* ===== CC TABLE ===== */
    .cc-table thead tr { background: linear-gradient(90deg, #1a2a4a 0%, #2d4a7a 100%); }
    .cc-table th { padding: .45rem .65rem; color: #fff; font-size: .67rem; font-weight: 700;
                   text-transform: uppercase; letter-spacing: .4px; white-space: nowrap; }
    .cc-table td { padding: .38rem .65rem; font-size: .8rem; color: #2d3748;
                   border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
    .cc-table tbody tr:hover { filter: brightness(.97); }

    /* ===== TABLE ===== */
    .cli-table { width: 100%; border-collapse: collapse; font-size: .81rem; }
    .cli-table thead tr { background: linear-gradient(90deg, #1a2a4a 0%, #2d4a7a 100%); }
    .cli-table th { padding: .5rem .65rem; color: #fff; font-size: .69rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; white-space: nowrap; }
    .cli-table td { padding: .4rem .65rem; color: #2d3748; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
    .cli-table tbody tr { cursor: pointer; transition: background .12s; }
    .cli-table tbody tr:hover { background: #f0f4ff; }
    .cli-table tbody tr.selected { background: #eef2ff; }
    .btn-cli-edit {
        background: none; border: none; padding: .2rem .35rem; border-radius: 5px;
        cursor: pointer; color: #4e73df; transition: all .15s;
    }
    .btn-cli-edit:hover { background: #eef2ff; }

    /* ===== SEARCH ===== */
    .search-box { position: relative; }
    .search-box input { padding-left: 2rem; border-radius: 8px; font-size: .83rem; border: 1px solid #ced4da; width: 100%; height: 34px; }
    .search-box input:focus { border-color: #4e73df; box-shadow: 0 0 0 3px rgba(78,115,223,.12); outline: none; }
    .search-box svg { position: absolute; left: .6rem; top: 50%; transform: translateY(-50%); color: #adb5bd; pointer-events: none; }

    /* ===== DETAIL ===== */
    .det-field { display: flex; flex-direction: column; padding: .5rem .75rem; border-bottom: 1px solid #f0f0f0; }
    .det-field:last-child { border-bottom: none; }
    .det-label { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #4e73df; margin-bottom: 2px; }
    .det-value { font-size: .83rem; color: #2d3748; }

    /* ===== EMPTY STATE ===== */
    .empty-state { text-align: center; padding: 2.5rem 1rem; color: #bbb; }

    /* ===== MODAL ===== */
    .modal-header-cli {
        background: linear-gradient(135deg, #1a2a4a 0%, #2d4a7a 100%);
        padding: .9rem 1.25rem; display: flex; align-items: center; gap: .75rem;
    }
    .modal-header-cli h5 { margin: 0; color: #fff; font-weight: 700; font-size: .95rem; }
    .modal-header-cli .btn-close { filter: invert(1); opacity: .8; margin-left: auto; }
    .modal-content { border: none; border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.18); }
    .modal-section-title {
        font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
        color: #4e73df; padding: .35rem 0 .2rem; border-bottom: 1px solid #e3e6f0; margin-bottom: .75rem;
    }
    .modal-footer-cli {
        background: #f8f9fc; border-top: 1px solid #e3e6f0;
        padding: .85rem 1.25rem; display: flex; justify-content: flex-end; gap: .5rem;
        border-radius: 0 0 12px 12px;
    }
    .modal-field-label { font-size: .8rem; font-weight: 600; color: #4a5568; margin-bottom: 3px; }
</style>

@* ===== PAGE HEADER ===== *@
<div class="page-header d-flex align-items-center gap-3">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
        <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
        <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
    </svg>
    <div>
        <h4>Gestión de Clientes</h4>
        <small class="opacity-75">Alta, baja y modificación de clientes</small>
    </div>
</div>

<div class="row g-3">

    @* ===== GRILLA ===== *@
    <div class="col-lg-7">
        <div class="section-card" style="overflow:visible;">
            <div class="section-card-header">
                <div class="sch-left">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/><path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
                    <span class="sch-title">Clientes</span>
                    <span class="cnt-badge" id="cntClientes">@Model.Clientes.Count</span>
                </div>
                <div class="d-flex align-items-center gap-2" style="flex-wrap:wrap;">
                    @* Exportar Excel *@
                    <button id="btnExportarExcel" class="btn-cli btn-cli-excel"
                            onclick="exportarExcel()" title="Exportar listado a Excel">
                        <svg id="icoExcel" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15">
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                            <path d="M7.194 7.766a1.657 1.657 0 0 0-.227-.27 1.02 1.02 0 0 1 .909.538l.854 1.646.854-1.646a1.02 1.02 0 0 1 .909-.538 1.659 1.659 0 0 0-.228.27l-.914 1.76.914 1.76a1.659 1.659 0 0 0 .228.27 1.02 1.02 0 0 1-.909-.538L8.531 9.602l-.854 1.646a1.02 1.02 0 0 1-.909.538c.08-.086.16-.175.228-.27l.914-1.76-.914-1.76z"/>
                        </svg>
                        <span id="lblExcel">Excel</span>
                    </button>
                    @* Botón agregar *@
                    <button class="btn-cli btn-cli-success" onclick="abrirModalNuevo()">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/></svg>
                        Agregar
                    </button>
                </div>
            </div>

            @* Barra de búsqueda *@
            <div style="padding:.65rem 1.1rem; background:#f8f9fc; border-bottom:1px solid #e3e6f0; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;">
                <select id="TipoBusqueda" class="form-select form-select-sm"
                        style="width:160px;border-radius:8px;font-size:.83rem;">
                    <option value="0">Nombre Comercial</option>
                    <option value="1">Razón Social</option>
                    <option value="2">CUIL</option>
                    <option value="3">Localidad</option>
                    <option value="4">Zona</option>
                </select>
                <div class="search-box" style="flex:1;min-width:180px;max-width:300px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                    <input type="text" id="txtBusqueda" placeholder="Buscar…"
                           onkeydown="if(event.key==='Enter') buscarClientes()" />
                </div>
                <button class="btn-cli btn-cli-primary" onclick="buscarClientes()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                    Buscar
                </button>
            </div>

            @* Tabla *@
            <div style="max-height:calc(100vh - 300px); overflow-y:auto;">
                <table class="cli-table" id="tablaClientes">
                    <thead>
                        <tr>
                            <th style="width:55px;">Cód.</th>
                            <th>Nombre Comercial</th>
                            <th>Razón Social</th>
                            <th style="width:44px;"></th>
                        </tr>
                    </thead>
                    <tbody id="tbodyClientes">
                        @foreach (var c in Model.Clientes)
                        {
                            <tr onclick="mostrarDetalle(@c.Id, this)" data-nombre="@c.NombreComercial?.ToUpper()">
                                <td><code style="font-size:.75rem;">@c.Id</code></td>
                                <td style="font-weight:600;">@c.NombreComercial</td>
                                <td style="font-size:.79rem;color:#6c757d;">@c.RazonSocial</td>
                                <td class="text-center">
                                    <button class="btn-cli-edit" title="Editar"
                                            onclick="event.stopPropagation(); abrirModalEditar(@c.Id)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="emptyTabla" class="empty-state" style="display:none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#ddd" viewBox="0 0 16 16" class="mb-2"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                <div style="font-size:.84rem;">Sin resultados</div>
            </div>
        </div>
    </div>

    @* ===== DETALLE ===== *@
    <div class="col-lg-5">
        <div class="section-card" id="cardDetalle">
            <div class="section-card-header">
                <div class="sch-left">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="#4e73df" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    <span class="sch-title">Detalle del Cliente</span>
                </div>
            </div>
            <div id="panelDetalle" style="padding:.75rem 0; min-height:200px;">
                <div class="empty-state">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#ddd" viewBox="0 0 16 16" class="mb-2"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    <div style="font-size:.84rem;">Seleccioná un cliente para ver su detalle</div>
                </div>
            </div>
        </div>
    </div>

</div>

@* ===== MODAL AGREGAR / EDITAR ===== *@
<div class="modal fade" id="clienteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header-cli">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                <h5 id="clienteModalLabel">Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="clienteForm" method="post" asp-page-handler="Guardar">
                <input type="hidden" id="ClienteId" name="Cliente.Id" />

                <div class="modal-body p-4">

                    <div class="modal-section-title">Datos Generales</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="modal-field-label">Nombre Comercial <span style="color:#e74a3b;">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.NombreComercial"
                                   style="border-radius:8px;" placeholder="Nombre o fantasía…" required />
                        </div>
                        <div class="col-md-6">
                            <label class="modal-field-label">Razón Social</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.RazonSocial"
                                   style="border-radius:8px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="modal-field-label">CUIL / CUIT</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.Cuil"
                                   style="border-radius:8px;" placeholder="XX-XXXXXXXX-X" />
                        </div>
                        <div class="col-md-8">
                            <label class="modal-field-label">Dirección</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.Direccion"
                                   style="border-radius:8px;" />
                        </div>
                    </div>

                    <div class="modal-section-title">Contacto</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="modal-field-label">Email</label>
                            <input type="email" class="form-control form-control-sm" name="Cliente.Email"
                                   style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="modal-field-label">Teléfono</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.Telefono"
                                   style="border-radius:8px;" />
                        </div>
                        <div class="col-md-3">
                            <label class="modal-field-label">Celular</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.Celular"
                                   style="border-radius:8px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="modal-field-label">Contacto</label>
                            <input type="text" class="form-control form-control-sm" name="Cliente.Contacto"
                                   style="border-radius:8px;" placeholder="Nombre del contacto…" />
                        </div>
                    </div>

                    @* ── Acceso del cliente ── *@
                    <div class="modal-section-title">Acceso del Cliente</div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="modal-field-label">Password Hash</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="inputPasswordHash" readonly
                                       autocomplete="new-password"
                                       class="form-control form-control-sm font-monospace"
                                       style="border-radius:8px 0 0 8px;font-size:.75rem;background:#f8f9fc;color:#2d3748;letter-spacing:.03em;"
                                       placeholder="Sin contraseña asignada" />
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2"
                                        style="border-radius:0 8px 8px 0;"
                                        onclick="toggleVerPasswordHash()"
                                        title="Mostrar / ocultar">
                                    <svg id="iconOjoHash" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
                                         fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" id="btnResetPassword" onclick="resetPasswordCliente()"
                                    class="btn btn-sm w-100"
                                    style="background:#f6c23e;color:#2d3748;border:none;border-radius:8px;font-weight:600;font-size:.82rem;display:none;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor"
                                     viewBox="0 0 16 16" class="me-1">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                                </svg>
                                Resetear Password
                            </button>
                        </div>
                    </div>
                    @* Toast para mostrar el nuevo password *@
                    <div id="alertNuevoPassword" class="alert alert-warning d-none py-2 px-3 mb-2"
                         style="border-radius:8px;font-size:.83rem;">
                        <strong>Nuevo password generado:</strong>
                        <span id="spanNuevoPassword" class="font-monospace fw-bold ms-2"
                              style="letter-spacing:.05em;"></span>
                        <small class="d-block text-muted mt-1">Anotalo ahora — no se vuelve a mostrar.</small>
                    </div>

                    <div class="modal-section-title">Clasificación</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="modal-field-label">Condición IVA</label>
                            <select class="form-select form-select-sm" name="Cliente.FkCondIva"
                                    asp-items="Model.CondicionIvas" style="border-radius:8px;">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="modal-field-label">Vendedor</label>
                            <select class="form-select form-select-sm" name="Cliente.FkVendedor"
                                    asp-items="Model.Vendedores" style="border-radius:8px;">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="modal-field-label">Localidad</label>
                            <select class="form-select form-select-sm" name="Cliente.FkLocalidad"
                                    asp-items="Model.Localidades" style="border-radius:8px;">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="modal-field-label">Zona</label>
                            <select class="form-select form-select-sm" name="Cliente.FkZona"
                                    asp-items="Model.Zonas" style="border-radius:8px;">
                                <option value="">-- Seleccione --</option>
                            </select>
                        </div>
                    </div>

                </div>

                <div class="modal-footer-cli">
                    <button type="button" class="btn-cli btn-cli-secondary" data-bs-dismiss="modal">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z"/></svg>
                        Cancelar
                    </button>
                    <button type="submit" class="btn-cli btn-cli-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4.5a.5.5 0 0 0-.146-.354l-3-3A.5.5 0 0 0 11.5 1H2zm0 1h9.293L14 4.707V14H2V2zM5 12a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5zm1-1h4V9H6v2zM5 5a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z"/></svg>
                        <span id="btnGuardarTxt">Guardar</span>
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    // ================================================================
    // COBRO
    // ================================================================
    let _cobroClienteId = 0;
    let _cobroLineas    = [];   // [{medioId, medioNombre, planNombre, importe, ref1, ref2, ref3, conDatos}]
    let _cobroId        = 0;
    let _planesData     = [];   // [{planId, planNombre, medioId, medioNombre, conDatos, recargo}]

    async function abrirModalCobro(clienteId, nombreCliente) {
        _cobroClienteId = clienteId;
        _cobroLineas    = [];
        _cobroId        = 0;

        // Reset modal
        document.getElementById('cobroModalSubtitle').textContent = nombreCliente;
        document.getElementById('cobroLoading').style.display  = 'block';
        document.getElementById('cobroPanel').style.display    = 'none';
        document.getElementById('cobroSuccess').style.display  = 'none';
        document.getElementById('cobroAlerta').style.display   = 'none';
        document.getElementById('cobroLineasSection').style.display = 'none';
        document.getElementById('cobroFooter').style.display   = 'flex';
        document.getElementById('btnCobrar').disabled          = true;
        document.getElementById('cobroLineasBody').innerHTML   = '';

        new bootstrap.Modal(document.getElementById('cobroModal')).show();

        try {
            // 1. Verificar caja
            const cajaR = await fetch('/Clientes/ABM?handler=VerificarCaja');
            const caja  = await cajaR.json();
            if (!caja.ok) {
                document.getElementById('cobroLoading').innerHTML =
                    '<div style="padding:2rem;text-align:center;">' +
                    '<svg xmlns="http://www.w3.org/2000/svg" fill="#f6c23e" viewBox="0 0 16 16" width="36" height="36">' +
                    '<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>' +
                    '<div style="margin-top:.75rem;font-weight:600;color:#e74a3b;">' + caja.msg + '</div></div>';
                return;
            }

            // 2. Cargar datos del cobro (saldo + planes)
            const datosR = await fetch('/Clientes/ABM?handler=DatosCobro&id=' + clienteId);
            const datos  = await datosR.json();

            _planesData = datos.planes;

            // Llenar select de planes
            const sel = document.getElementById('cbrPlan');
            sel.innerHTML = '<option value="">-- Seleccione un plan --</option>';
            _planesData.forEach(p => {
                const opt = document.createElement('option');
                opt.value       = p.planId;
                opt.textContent = p.medioNombre + ' — ' + p.planNombre;
                opt.dataset.medioId    = p.medioId;
                opt.dataset.medioNombre = p.medioNombre;
                opt.dataset.conDatos   = p.conDatos;
                sel.appendChild(opt);
            });

            // Mostrar saldo
            const saldo = parseFloat(datos.saldo) || 0;
            document.getElementById('cobroSaldoDisplay').textContent = formatMoney(saldo);
            document.getElementById('cobroSaldoDisplay').style.color = saldo > 0 ? '#e74a3b' : '#1cc88a';
            document.getElementById('cobroImporte').value = saldo > 0 ? saldo.toFixed(2) : '0.00';

            // Limpiar campos
            document.getElementById('cbrRef1').value = '';
            document.getElementById('cbrRef2').value = '';
            document.getElementById('cbrRef3').value = '';
            document.getElementById('cbrImporte').value = '';
            document.getElementById('cbrRefs').style.display = 'none';
            document.getElementById('cbrPlan').value = '';

            document.getElementById('cobroLoading').style.display = 'none';
            document.getElementById('cobroPanel').style.display   = 'block';

        } catch(e) {
            document.getElementById('cobroLoading').innerHTML =
                '<div style="padding:2rem;text-align:center;color:#e74a3b;">Error al cargar datos. Reintentá.</div>';
        }
    }

    function onPlanChange() {
        const sel = document.getElementById('cbrPlan');
        const opt = sel.options[sel.selectedIndex];
        const conDatos = opt && opt.dataset.conDatos === 'true';
        document.getElementById('cbrRefs').style.display = conDatos ? 'block' : 'none';
        if (!conDatos) {
            document.getElementById('cbrRef1').value = '';
            document.getElementById('cbrRef2').value = '';
            document.getElementById('cbrRef3').value = '';
        }
    }

    function agregarLineaCobro() {
        const sel      = document.getElementById('cbrPlan');
        const opt      = sel.options[sel.selectedIndex];
        const importe  = parseFloat(document.getElementById('cbrImporte').value) || 0;
        const ref1     = document.getElementById('cbrRef1').value.trim();
        const ref2     = document.getElementById('cbrRef2').value.trim();
        const ref3     = document.getElementById('cbrRef3').value.trim();

        if (!opt || !opt.value) {
            mostrarAlerta('cobroAlerta', 'Seleccioná un plan de pago.'); return;
        }
        if (importe <= 0) {
            mostrarAlerta('cobroAlerta', 'Ingresá un importe mayor a cero.'); return;
        }
        const conDatos = opt.dataset.conDatos === 'true';
        if (conDatos && !ref1) {
            mostrarAlerta('cobroAlerta', 'Este medio de pago requiere datos. Completá al menos la Referencia 1.'); return;
        }

        _cobroLineas.push({
            planId:     parseInt(opt.value),
            medioId:    parseInt(opt.dataset.medioId),
            medioNombre: opt.dataset.medioNombre,
            planNombre: opt.textContent,
            importe,
            ref1, ref2, ref3
        });

        // Resetear campos
        sel.value = '';
        document.getElementById('cbrImporte').value = '';
        document.getElementById('cbrRefs').style.display = 'none';
        document.getElementById('cbrRef1').value = '';
        document.getElementById('cbrRef2').value = '';
        document.getElementById('cbrRef3').value = '';
        document.getElementById('cobroAlerta').style.display = 'none';

        renderLineasCobro();
    }

    function eliminarLineaCobro(idx) {
        _cobroLineas.splice(idx, 1);
        renderLineasCobro();
    }

    function renderLineasCobro() {
        const tbody = document.getElementById('cobroLineasBody');
        tbody.innerHTML = '';
        _cobroLineas.forEach((l, i) => {
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td>' + l.medioNombre + '<br><small style="color:#888;font-size:.72rem;">' + l.planNombre + '</small></td>' +
                '<td style="text-align:right;font-weight:700;color:#6f42c1;">' + formatMoney(l.importe) + '</td>' +
                '<td style="font-size:.75rem;">' + (l.ref1 || '—') + '</td>' +
                '<td style="font-size:.75rem;">' + (l.ref2 || '—') + '</td>' +
                '<td style="font-size:.75rem;">' + (l.ref3 || '—') + '</td>' +
                '<td><button onclick="eliminarLineaCobro(' + i + ')" style="background:none;border:none;color:#e74a3b;cursor:pointer;font-size:.85rem;" title="Eliminar">✕</button></td>';
            tbody.appendChild(tr);
        });

        document.getElementById('cobroLineasSection').style.display = _cobroLineas.length ? 'block' : 'none';
        actualizarTotalCobro();
    }

    function actualizarTotalCobro() {
        const importeACobrar = parseFloat(document.getElementById('cobroImporte').value) || 0;
        const totalAsignado  = _cobroLineas.reduce((s, l) => s + l.importe, 0);
        const diferencia     = importeACobrar - totalAsignado;

        document.getElementById('cobroTotalAsignado').textContent = formatMoney(totalAsignado);

        const divDif = document.getElementById('cobroDiferencia');
        if (Math.abs(diferencia) < 0.01) {
            divDif.innerHTML = '<span style="color:#1cc88a;font-weight:700;">✓ Completo</span>';
            document.getElementById('btnCobrar').disabled = (_cobroLineas.length === 0 || importeACobrar <= 0);
        } else {
            const sign = diferencia > 0 ? 'Faltan' : 'Excede en';
            divDif.innerHTML = '<span style="color:#e74a3b;font-size:.78rem;">' + sign + ' ' + formatMoney(Math.abs(diferencia)) + '</span>';
            document.getElementById('btnCobrar').disabled = true;
        }
    }

    async function procesarCobro() {
        const btn = document.getElementById('btnCobrar');
        btn.disabled = true;
        btn.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:5px;"></span>Procesando…';

        const importeTotal = parseFloat(document.getElementById('cobroImporte').value) || 0;
        const payload = {
            clienteId:    _cobroClienteId,
            importeTotal: importeTotal,
            detalle: _cobroLineas.map(l => ({
                medioPagoId: l.medioId,
                medioNombre: l.medioNombre,
                importe:     l.importe,
                referencia1: l.ref1 || null,
                referencia2: l.ref2 || null,
                referencia3: l.ref3 || null
            }))
        };

        try {
            const r = await fetch('/Clientes/ABM?handler=Cobro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            let data;
            const ct = r.headers.get('content-type') || '';
            if (ct.includes('application/json')) {
                data = await r.json();
            } else {
                const txt = await r.text();
                btn.disabled = false;
                btn.innerHTML = '💳 Confirmar Cobro';
                mostrarAlerta('cobroAlerta', 'Error servidor (' + r.status + '): ' + txt.substring(0, 200));
                return;
            }

            if (data.ok) {
                _cobroId = data.cobroId;
                document.getElementById('cobroLoading').style.display  = 'none';
                document.getElementById('cobroPanel').style.display    = 'none';
                document.getElementById('cobroFooter').style.display   = 'none';
                document.getElementById('cobroSuccessMsg').innerHTML =
                    'Cobro N° <strong>' + String(_cobroId).padStart(8,'0') + '</strong> registrado por ' +
                    '<strong>' + formatMoney(importeTotal) + '</strong>';
                document.getElementById('btnImprimirRecibo').style.display = 'inline-flex';
                document.getElementById('cobroSuccess').style.display   = 'block';
            } else {
                btn.disabled = false;
                btn.innerHTML = '💳 Confirmar Cobro';
                mostrarAlerta('cobroAlerta', data.msg || 'Error al procesar el cobro.');
            }
        } catch(e) {
            btn.disabled = false;
            btn.innerHTML = '💳 Confirmar Cobro';
            mostrarAlerta('cobroAlerta', 'Error: ' + (e.message || e));
        }
    }

    function imprimirRecibo() {
        if (!_cobroId) return;
        window.open('/Clientes/ABM?handler=ReciboCobro&id=' + _cobroId, '_blank');
    }

    // Helpers cobro
    function mostrarAlerta(id, msg) {
        const el = document.getElementById(id);
        el.textContent = msg;
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 5000);
    }

    function formatMoney(n) {
        return '$ ' + parseFloat(n).toLocaleString('es-AR', {minimumFractionDigits:2, maximumFractionDigits:2});
    }

    // -------- CUENTA CORRIENTE --------
    let _ccClienteId = 0;

    function abrirModalCC(clienteId, nombreCliente) {
        _ccClienteId = clienteId;
        document.getElementById('ccModalLabel').textContent = 'Cuenta Corriente';
        document.getElementById('ccModalSubtitle').textContent = nombreCliente;
        cerrarDetalleCC();
        document.getElementById('ccContent').innerHTML =
            '<div style="text-align:center;padding:3rem;">' +
            '<div style="display:inline-block;width:22px;height:22px;border:3px solid rgba(78,115,223,.2);' +
            'border-top-color:#4e73df;border-radius:50%;animation:spin .7s linear infinite;"></div>' +
            '</div>';

        new bootstrap.Modal(document.getElementById('ccModal')).show();

        fetch('/Clientes/ABM?handler=CuentaCorriente&id=' + clienteId)
            .then(r => r.text())
            .then(html => {
                document.getElementById('ccContent').innerHTML = html;
                // Delegación de eventos: click en fila cobro → mostrar detalle
                document.getElementById('ccContent').addEventListener('click', function(e) {
                    const fila = e.target.closest('tr.cc-fila-cobro');
                    if (!fila) return;
                    const cobroId = fila.getAttribute('data-cobro-id');
                    if (!cobroId) return;
                    mostrarDetalleCC(parseInt(cobroId), fila);
                });
            })
            .catch(() => {
                document.getElementById('ccContent').innerHTML =
                    '<p style="color:#e74a3b;padding:1.5rem;">Error al cargar la cuenta corriente.</p>';
            });
    }

    function mostrarDetalleCC(cobroId, filaEl) {
        // Marca la fila activa
        document.querySelectorAll('#ccContent tr.cc-fila-activa')
            .forEach(r => r.classList.remove('cc-fila-activa'));
        if (filaEl) filaEl.classList.add('cc-fila-activa');

        const panel = document.getElementById('ccDetalle');
        const body  = document.getElementById('ccDetalleBody');
        document.getElementById('ccDetalleTitulo').textContent =
            'Detalle del Cobro N° ' + String(cobroId).padStart(8, '0');
        body.innerHTML =
            '<div style="text-align:center;padding:1rem;">' +
            '<div style="display:inline-block;width:16px;height:16px;border:2px solid rgba(111,66,193,.2);' +
            'border-top-color:#6f42c1;border-radius:50%;animation:spin .7s linear infinite;"></div></div>';
        panel.style.display = 'block';

        fetch('/Clientes/ABM?handler=DetalleCobro&id=' + cobroId)
            .then(r => r.json())
            .then(data => {
                if (!data.ok) { body.innerHTML = '<p style="color:#e74a3b;font-size:.82rem;">Error al cargar el detalle.</p>'; return; }

                let html = '<div style="display:flex;gap:1.5rem;font-size:.8rem;margin-bottom:.6rem;flex-wrap:wrap;">' +
                    '<span><strong style="color:#6f42c1;">Fecha:</strong> ' + data.fecha + '</span>' +
                    '<span><strong style="color:#6f42c1;">Total:</strong> ' + fmtCC(data.importeTotal) + '</span>' +
                    '</div>';
                html += '<table class="cc-detalle-table"><thead><tr>' +
                    '<th>Medio de Pago</th>' +
                    '<th style="text-align:right;">Importe</th>' +
                    '<th>Dato 1</th><th>Dato 2</th><th>Dato 3</th>' +
                    '</tr></thead><tbody>';
                data.detalle.forEach(d => {
                    html += '<tr>' +
                        '<td>' + escHTML(d.medioPago) + '</td>' +
                        '<td style="text-align:right;font-weight:600;">' + fmtCC(d.importe) + '</td>' +
                        '<td style="text-align:right;">' + escHTML(d.dato1) + '</td>' +
                        '<td style="text-align:right;">' + escHTML(d.dato2) + '</td>' +
                        '<td style="text-align:right;">' + escHTML(d.dato3) + '</td>' +
                        '</tr>';
                });
                html += '</tbody></table>';
                body.innerHTML = html;
            })
            .catch(() => { body.innerHTML = '<p style="color:#e74a3b;font-size:.82rem;">Error de conexión.</p>'; });
    }

    function cerrarDetalleCC() {
        document.getElementById('ccDetalle').style.display = 'none';
        document.querySelectorAll('#ccContent tr.cc-fila-activa')
            .forEach(r => r.classList.remove('cc-fila-activa'));
    }

    function verEstadoCC() {
        if (!_ccClienteId) return;
        window.open('/Clientes/ABM?handler=EstadoCC&id=' + _ccClienteId, '_blank');
    }

    function reimprimirRecibo(cobroId) {
        window.open('/Clientes/ABM?handler=ReciboCobro&id=' + cobroId, '_blank');
    }

    function fmtCC(n) {
        return '$ ' + parseFloat(n).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function escHTML(s) {
        if (!s) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // -------- EXPORTAR EXCEL --------
    async function exportarExcel() {
        const btn   = document.getElementById('btnExportarExcel');
        const lbl   = document.getElementById('lblExcel');
        const ico   = document.getElementById('icoExcel');

        // Estado: generando
        btn.disabled = true;
        ico.style.display = 'none';
        lbl.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:4px;"></span>Generando…';

        mostrarToast(
            '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="14" height="14" style="margin-right:6px;vertical-align:middle;"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/></svg> Generando Excel…', 'info');

        try {
            const response = await fetch('/Clientes/ABM?handler=ExportarExcel');
            if (!response.ok) throw new Error('HTTP ' + response.status);

            const blob = await response.blob();
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            const hoy  = new Date();
            const dd   = String(hoy.getDate()).padStart(2,'0');
            const mm   = String(hoy.getMonth()+1).padStart(2,'0');
            const yy   = hoy.getFullYear();
            a.href     = url;
            a.download = 'Clientes_' + dd + mm + yy + '.xls';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);

            mostrarToast(
                '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="14" height="14" style="margin-right:6px;vertical-align:middle;"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg> ¡Excel listo! La descarga comenzó.', 'success');

        } catch (e) {
            console.error(e);
            mostrarToast('&#9888; Error al generar el Excel. Reintentá.', 'error');
        } finally {
            // Restaurar botón
            btn.disabled = false;
            ico.style.display = '';
            lbl.textContent = 'Excel';
        }
    }

    // -------- TOAST --------
    function mostrarToast(htmlMsg, tipo) {
        const existing = document.getElementById('cli-toast');
        if (existing) { clearTimeout(existing._timer); existing.remove(); }

        const paleta = {
            info:    { bg: '#1a2a4a', bdr: '#4e73df' },
            success: { bg: '#155724', bdr: '#1cc88a' },
            error:   { bg: '#721c24', bdr: '#e74a3b' }
        };
        const c = paleta[tipo] || paleta.info;

        const t = document.createElement('div');
        t.id = 'cli-toast';
        t.style.cssText =
            'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;' +
            'background:' + c.bg + ';color:#fff;' +
            'padding:.7rem 1.1rem;border-radius:10px;' +
            'box-shadow:0 4px 20px rgba(0,0,0,.3);' +
            'font-size:.84rem;font-weight:600;' +
            'display:flex;align-items:center;' +
            'border-left:4px solid ' + c.bdr + ';' +
            'max-width:340px;min-width:220px;' +
            'animation:toastIn .22s ease;';
        t.innerHTML = htmlMsg;
        document.body.appendChild(t);

        t._timer = setTimeout(() => {
            t.style.animation = 'toastOut .22s ease forwards';
            setTimeout(() => t.remove(), 230);
        }, 4000);
    }

    // Inicializar filtro defecto
    document.getElementById('TipoBusqueda').selectedIndex = @ViewData["FiltroDefecto"];

    // -------- DETALLE --------
    function mostrarDetalle(id, tr) {
        document.querySelectorAll('#tbodyClientes tr').forEach(r => r.classList.remove('selected'));
        if (tr) tr.classList.add('selected');

        const panel = document.getElementById('panelDetalle');
        panel.innerHTML = '<div style="text-align:center;padding:2rem;"><div style="display:inline-block;width:20px;height:20px;border:2px solid rgba(78,115,223,.25);border-top-color:#4e73df;border-radius:50%;animation:spin .7s linear infinite;"></div></div>';

        fetch('/Clientes/ABM?handler=Detalle&id=' + id)
            .then(r => r.text())
            .then(html => { panel.innerHTML = html; })
            .catch(() => { panel.innerHTML = '<p style="color:#e74a3b;padding:.75rem;">Error al cargar.</p>'; });
    }

    // -------- BUSCAR --------
    async function buscarClientes() {
        const tipo  = parseInt(document.getElementById('TipoBusqueda').value);
        const valor = document.getElementById('txtBusqueda').value.trim();
        if (!valor) return;

        const response = await fetch('/Clientes/ABM?handler=BuscarClientes&tipo=' + tipo + '&valor=' + encodeURIComponent(valor));
        const html = await response.text();

        const tbody = document.getElementById('tbodyClientes');
        tbody.innerHTML = html;

        // Agregar evento de selección a las filas nuevas
        tbody.querySelectorAll('tr').forEach(tr => {
            tr.addEventListener('click', () => mostrarDetalle(
                tr.querySelector('td code')?.textContent || 0, tr));
        });

        const n = tbody.querySelectorAll('tr').length;
        document.getElementById('emptyTabla').style.display = n === 0 ? 'block' : 'none';
        document.getElementById('cntClientes').textContent = n;

        if (n === 1) {
            const id = tbody.querySelector('td code')?.textContent;
            if (id) mostrarDetalle(id, tbody.querySelector('tr'));
        }
    }

    // -------- ELIMINAR --------
    async function eliminarCliente(id) {
        if (!confirm('¿Eliminar este cliente?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const r = await fetch('/Clientes/ABM?handler=Eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                           'RequestVerificationToken': token },
                body: 'id=' + encodeURIComponent(id)
            });
            const data = await r.json();
            if (data.success) location.reload();
        } catch (e) { console.error(e); }
    }

    // -------- MODAL NUEVO --------
    function abrirModalNuevo() {
        document.getElementById('clienteForm').reset();
        document.getElementById('ClienteId').value = 0;
        document.getElementById('clienteModalLabel').textContent = 'Agregar Cliente';
        document.getElementById('btnGuardarTxt').textContent = 'Agregar';
        // Ocultar sección password en modo nuevo
        document.getElementById('inputPasswordHash').value = '';
        document.getElementById('btnResetPassword').style.display = 'none';
        document.getElementById('alertNuevoPassword').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('clienteModal')).show();
    }

    // -------- MODAL EDITAR --------
    async function abrirModalEditar(id) {
        const r = await fetch('/Clientes/ABM?handler=Cliente&id=' + id);
        if (!r.ok) { alert('No se pudo obtener el cliente'); return; }
        const c = await r.json();

        document.getElementById('ClienteId').value = c.id;
        document.querySelector('input[name="Cliente.NombreComercial"]').value = c.nombreComercial ?? '';
        document.querySelector('input[name="Cliente.RazonSocial"]').value     = c.razonSocial     ?? '';
        document.querySelector('input[name="Cliente.Cuil"]').value            = c.cuil            ?? '';
        document.querySelector('input[name="Cliente.Direccion"]').value       = c.direccion       ?? '';
        document.querySelector('input[name="Cliente.Email"]').value           = c.email           ?? '';
        document.querySelector('input[name="Cliente.Telefono"]').value        = c.telefono        ?? '';
        document.querySelector('input[name="Cliente.Celular"]').value         = c.celular         ?? '';
        document.querySelector('input[name="Cliente.Contacto"]').value        = c.contacto        ?? '';
        document.querySelector('select[name="Cliente.FkCondIva"]').value      = c.fkCondIva       ?? '';
        document.querySelector('select[name="Cliente.FkVendedor"]').value     = c.fkVendedor      ?? '';
        document.querySelector('select[name="Cliente.FkLocalidad"]').value    = c.fkLocalidad     ?? '';
        document.querySelector('select[name="Cliente.FkZona"]').value         = c.fkZona          ?? '';

        // Password hash
        const inpPwd = document.getElementById('inputPasswordHash');
        inpPwd.value = c.passwordHash ?? '';
        inpPwd.type  = 'password';
        // Restaurar icono ojo
        document.getElementById('iconOjoHash').innerHTML =
            '<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>';
        document.getElementById('btnResetPassword').style.display = '';
        document.getElementById('alertNuevoPassword').classList.add('d-none');

        document.getElementById('clienteModalLabel').textContent = 'Editar Cliente';
        document.getElementById('btnGuardarTxt').textContent = 'Guardar cambios';
        new bootstrap.Modal(document.getElementById('clienteModal')).show();
    }

    // -------- TOGGLE OJO PASSWORD --------
    // Estado inicial: type="text" (visible). El ojo lo oculta → text.
    const _SVG_OJO_ABIERTO = '<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>';
    const _SVG_OJO_CERRADO = '<path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/><path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.821a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.83z"/><path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/><path fill-rule="evenodd" d="M13.646 14.354l-12-12 .708-.708 12 12-.708.708z"/>';

    function toggleVerPasswordHash() {
        const inp = document.getElementById('inputPasswordHash');
        const ico = document.getElementById('iconOjoHash');
        if (inp.type === 'text') {
            // Ocultar → password
            inp.type = 'password';
            ico.innerHTML = _SVG_OJO_CERRADO;
        } else {
            // Revelar → text
            inp.type = 'text';
            ico.innerHTML = _SVG_OJO_ABIERTO;
        }
    }

    // -------- RESET PASSWORD --------
    async function resetPasswordCliente() {
        const id = document.getElementById('ClienteId').value;
        if (!id || id === '0') return;

        if (!confirm('¿Generar un nuevo password para este cliente?\nEl password actual quedará invalidado.')) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        try {
            const r = await fetch('/Clientes/ABM?handler=ResetPassword', {
                method : 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                           'RequestVerificationToken': token },
                body   : 'id=' + encodeURIComponent(id)
            });
            const data = await r.json();
            if (data.ok) {
                // Actualizar campo password hash con el nuevo hash (no el texto plano)
                document.getElementById('inputPasswordHash').value = '(nuevo hash guardado en BD)';
                // Mostrar el password en texto plano una sola vez
                document.getElementById('spanNuevoPassword').textContent = data.password;
                document.getElementById('alertNuevoPassword').classList.remove('d-none');
            } else {
                alert('Error: ' + (data.msg ?? 'No se pudo resetear el password.'));
            }
        } catch (e) {
            alert('Error de red: ' + e.message);
        }
    }
</script>

