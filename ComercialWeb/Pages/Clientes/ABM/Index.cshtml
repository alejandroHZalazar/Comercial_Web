@* Antiforgery para el POST de eliminar *@
<form id="__AntiForgeryForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    // Inyectar token en la función eliminarCliente
    (function(){
        const tokenInput = document.querySelector('#__AntiForgeryForm input[name="__RequestVerificationToken"]');
        if (!tokenInput) return;
        const token = tokenInput.value;
        // Re-definir con token correcto
        window._csrfToken = token;
    })();
    // Override eliminarCliente to use correct token
    async function eliminarCliente(id) {
        if (!confirm('¿Eliminar este cliente?')) return;
        const token = window._csrfToken || '';
        try {
            const r = await fetch('/Clientes/ABM?handler=Eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                           'RequestVerificationToken': token },
                body: 'id=' + encodeURIComponent(id)
            });
            const data = await r.json();
            if (data.success) location.reload();
        } catch (e) { console.error(e); }
    }

    @@keyframes spin not here - defined inline style
</script>
<style>
    @@keyframes spin    { to { transform: rotate(360deg); } }
    @@keyframes toastIn  { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    @@keyframes toastOut { from { opacity:1; transform:translateY(0); } to { opacity:0; transform:translateY(12px); } }
</style>

<script>
    // -------- NOTA DE CRÉDITO --------
    let _ncClienteId = 0;

    function abrirModalNC() {
        if (!_ccClienteId) return;
        _ncClienteId = _ccClienteId;

        const subtitle = document.getElementById('ccModalSubtitle').textContent;
        document.getElementById('ncModalSubtitle').textContent = subtitle;

        document.getElementById('ncLoading').style.display = 'block';
        document.getElementById('ncPanel').style.display   = 'none';
        document.getElementById('ncSuccess').style.display = 'none';
        document.getElementById('ncFooter').style.display  = 'flex';
        document.getElementById('ncAlerta').style.display  = 'none';
        document.getElementById('btnGuardarNC').disabled   = true;

        // Reset campos
        document.getElementById('ncImporte').value      = '';
        document.getElementById('ncFactAsociada').value = '';
        document.getElementById('ncFecha').value        = '';
        document.getElementById('ncObs').value          = '';

        new bootstrap.Modal(document.getElementById('ncModal')).show();

        fetch('/Clientes/ABM?handler=DatosNC')
            .then(r => r.json())
            .then(data => {
                // Llenar selects IVA
                const selIva = document.getElementById('ncIva');
                selIva.innerHTML = '<option value="0">Sin IVA (0%)</option>';
                data.ivas.forEach(i => {
                    selIva.innerHTML += `<option value="${i.valor}">${i.valor}%</option>`;
                });
                // Llenar selects IIBB
                const selIIBB = document.getElementById('ncIIBB');
                selIIBB.innerHTML = '<option value="0">Sin IIBB (0%)</option>';
                data.impuestos.forEach(i => {
                    selIIBB.innerHTML += `<option value="${i.valor}">${i.valor}%</option>`;
                });
                document.getElementById('ncLoading').style.display = 'none';
                document.getElementById('ncPanel').style.display   = 'block';
                document.getElementById('btnGuardarNC').disabled   = false;
            })
            .catch(() => {
                document.getElementById('ncLoading').innerHTML =
                    '<p style="color:#e74a3b;padding:1rem;">Error al cargar datos.</p>';
            });
    }

    async function guardarNC() {
        const btn     = document.getElementById('btnGuardarNC');
        const importe = parseFloat(document.getElementById('ncImporte').value) || 0;
        const factNum = document.getElementById('ncFactAsociada').value.trim();
        const obs     = document.getElementById('ncObs').value.trim();
        const iva     = parseFloat(document.getElementById('ncIva').value) || 0;
        const iibb    = parseFloat(document.getElementById('ncIIBB').value) || 0;
        const fecha   = document.getElementById('ncFecha').value;

        // Validaciones
        if (importe <= 0)    { mostrarAlertaNC('El importe debe ser mayor a 0.'); return; }
        if (!obs)            { mostrarAlertaNC('Las observaciones son obligatorias.'); return; }
        if (factNum && isNaN(parseInt(factNum))) { mostrarAlertaNC('La factura asociada debe ser numérica.'); return; }

        // Formatear fecha a dd/MM/yyyy
        let fechaStr = null;
        if (fecha) {
            const [y, m, d] = fecha.split('-');
            fechaStr = `${d}/${m}/${y}`;
        }

        btn.disabled = true;
        btn.innerHTML = '<span style="display:inline-block;width:11px;height:11px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;margin-right:4px;"></span>Procesando\u2026';

        const payload = {
            clienteId:        _ncClienteId,
            importe:          importe,
            facturaAsociada:  factNum ? parseInt(factNum) : null,
            fechaFacturaAsoc: fechaStr,
            ivaPorcentaje:    iva,
            iIBBPorcentaje:   iibb,
            observaciones:    obs
        };

        try {
            const r = await fetch('/Clientes/ABM?handler=NotaCredito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const ct = r.headers.get('content-type') || '';
            if (!ct.includes('application/json')) {
                mostrarAlertaNC('Error servidor (' + r.status + ')');
                btn.disabled = false;
                btn.innerHTML = 'Guardar Nota de Crédito';
                return;
            }
            const data = await r.json();
            if (data.ok) {
                document.getElementById('ncPanel').style.display   = 'none';
                document.getElementById('ncFooter').style.display  = 'none';
                document.getElementById('ncSuccessMsg').innerHTML  =
                    'Nota de Crédito N° <strong>' + String(data.cobroId).padStart(8,'0') + '</strong> registrada por <strong>' + formatMoney(importe) + '</strong>';
                document.getElementById('ncSuccess').style.display = 'block';

                // Refrescar la grilla de Cuenta Corriente en el modal de fondo
                cerrarDetalleCC();
                fetch('/Clientes/ABM?handler=CuentaCorriente&id=' + _ccClienteId)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('ccContent').innerHTML = html;
                        document.getElementById('ccContent').addEventListener('click', function(e) {
                            const fila = e.target.closest('tr.cc-fila-cobro');
                            if (!fila) return;
                            const cobroId = fila.getAttribute('data-cobro-id');
                            if (cobroId) mostrarDetalleCC(cobroId, fila);
                        });
                    })
                    .catch(() => { /* si falla el refresh, no pasa nada crítico */ });
            } else {
                mostrarAlertaNC(data.msg || 'Error al procesar.');
                btn.disabled = false;
                btn.innerHTML = 'Guardar Nota de Crédito';
            }
        } catch(e) {
            mostrarAlertaNC('Error: ' + e.message);
            btn.disabled = false;
            btn.innerHTML = 'Guardar Nota de Crédito';
        }
    }

    function mostrarAlertaNC(msg) {
        const el = document.getElementById('ncAlerta');
        el.textContent = msg;
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 5000);
    }

    // -------- NOTA DE DÉBITO --------
    let _ndClienteId = 0;

    function abrirModalND() {
        if (!_ccClienteId) return;
        _ndClienteId = _ccClienteId;

        const subtitle = document.getElementById('ccModalSubtitle').textContent;
        document.getElementById('ndModalSubtitle').textContent = subtitle;

        document.getElementById('ndPanel').style.display   = 'block';
        document.getElementById('ndSuccess').style.display = 'none';
        document.getElementById('ndFooter').style.display  = 'flex';
        document.getElementById('ndAlerta').style.display  = 'none';
        document.getElementById('ndImporte').value         = '';
        document.getElementById('ndObs').value             = '';
        document.getElementById('btnGuardarND').disabled   = true;

        new bootstrap.Modal(document.getElementById('ndModal')).show();
    }

    function validarFormND() {
        const imp = parseFloat(document.getElementById('ndImporte').value) || 0;
        const obs = document.getElementById('ndObs').value.trim();
        document.getElementById('btnGuardarND').disabled = !(imp > 0 && obs.length > 0);
    }

    async function guardarND() {
        const btn     = document.getElementById('btnGuardarND');
        const importe = parseFloat(document.getElementById('ndImporte').value) || 0;
        const obs     = document.getElementById('ndObs').value.trim();

        if (importe <= 0) { mostrarAlertaND('El importe debe ser mayor a 0.'); return; }
        if (!obs)         { mostrarAlertaND('Las observaciones son obligatorias.'); return; }

        btn.disabled = true;
        btn.innerHTML = '<span style="display:inline-block;width:13px;height:13px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle;"></span> Procesando…';

        try {
            const r = await fetch('/Clientes/ABM?handler=NotaDebito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ clienteId: _ndClienteId, importe, observaciones: obs })
            });
            const ct = r.headers.get('content-type') || '';
            if (!ct.includes('application/json')) {
                mostrarAlertaND('Error servidor (' + r.status + ')');
                btn.disabled = false;
                btn.innerHTML = 'Guardar Nota de Débito';
                return;
            }
            const data = await r.json();
            if (data.ok) {
                document.getElementById('ndPanel').style.display   = 'none';
                document.getElementById('ndFooter').style.display  = 'none';
                document.getElementById('ndSuccessMsg').innerHTML  =
                    'Nota de Débito N° <strong>' + String(data.ndId).padStart(8,'0') + '</strong> registrada por <strong>' + formatMoney(importe) + '</strong>';
                document.getElementById('ndSuccess').style.display = 'block';

                // Refrescar la grilla de Cuenta Corriente en el modal de fondo
                cerrarDetalleCC();
                fetch('/Clientes/ABM?handler=CuentaCorriente&id=' + _ccClienteId)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('ccContent').innerHTML = html;
                        document.getElementById('ccContent').addEventListener('click', function(e) {
                            const fila = e.target.closest('tr.cc-fila-cobro');
                            if (!fila) return;
                            const cobroId = fila.getAttribute('data-cobro-id');
                            if (cobroId) mostrarDetalleCC(cobroId, fila);
                        });
                    })
                    .catch(() => {});
            } else {
                mostrarAlertaND(data.msg || 'Error al procesar.');
                btn.disabled = false;
                btn.innerHTML = 'Guardar Nota de Débito';
            }
        } catch(e) {
            mostrarAlertaND('Error: ' + e.message);
            btn.disabled = false;
            btn.innerHTML = 'Guardar Nota de Débito';
        }
    }

    function mostrarAlertaND(msg) {
        const el = document.getElementById('ndAlerta');
        el.textContent = msg;
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 4000);
    }
</script>
