// Helper: convierte texto formateado como "$1.234,56" a número
function _parseFmtCurrency(s){
    if (!s) return 0;
    // Eliminar símbolo de moneda, puntos de miles y reemplazar coma decimal
    var clean = s.replace(/[^0-9,.-]/g, '').replace(/\./g, '').replace(',', '.');
    return parseFloat(clean) || 0;
}

