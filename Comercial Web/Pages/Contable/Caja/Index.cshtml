// ── Arqueo ─────────────────────────────────────────────────────────────────
var _arqSaldoSistema = 0;   // cargado al abrir el modal

window.abrirArqueo = function(){
    // Validar parámetros configurados
    if (ARQUEO_INGRESO_ID <= 0){
        alert('El parámetro caja/ArqueoIngreso no está configurado. Configure este valor en Configuración → Parámetros.');
        return;
    }
    if (ARQUEO_EGRESO_ID <= 0){
        alert('El parámetro caja/ArqueoEgreso no está configurado. Configure este valor en Configuración → Parámetros.');
        return;
    }
    if (MEDIO_EFECTIVO_ID <= 0){
        alert('El parámetro caja/MedioPagoEfectivo no está configurado. Configure este valor en Configuración → Parámetros.');
        return;
    }

    // Tomar el saldo efectivo actual del DOM (ya está calculado por el sistema)
    _arqSaldoSistema = _parseFmtCurrency(document.getElementById('lblEfectivo').textContent);

    // Inicializar campos
    document.getElementById('arqSaldoSisDisplay').textContent = fmt(_arqSaldoSistema);
    document.getElementById('arqSaldoFisico').value           = '';
    document.getElementById('arqObservaciones').value         = '';
    document.getElementById('arqDiffPanel').style.display     = 'none';
    var btn = document.getElementById('btnConfirmarArqueo');
    btn.disabled    = false;
    btn.innerHTML   = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg> Confirmar Arqueo';

    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalArqueo')).show();
    document.getElementById('modalArqueo').addEventListener('shown.bs.modal', function foc(){
        document.getElementById('arqSaldoFisico').focus();
        document.getElementById('modalArqueo').removeEventListener('shown.bs.modal', foc);
    });
};

// Actualiza el panel de diferencia mientras el usuario escribe
window.arqActualizarDiff = function(){
    var fisico = parseFloat(document.getElementById('arqSaldoFisico').value);
    var panel  = document.getElementById('arqDiffPanel');
    if (isNaN(fisico)){ panel.style.display = 'none'; return; }

    panel.style.display = '';
    var diff = fisico - _arqSaldoSistema;

    if (Math.abs(diff) < 0.005){
        panel.style.background = '#d4edda'; panel.style.border = '1px solid #c3e6cb';
        document.getElementById('arqDiffLabel').style.color = '#155724';
        document.getElementById('arqDiffLabel').textContent = '✔ Sin diferencias — cuadra exacto';
        document.getElementById('arqDiffValor').style.color = '#155724';
        document.getElementById('arqDiffValor').textContent = '';
    } else if (diff > 0){
        panel.style.background = '#fff3cd'; panel.style.border = '1px solid #ffeeba';
        document.getElementById('arqDiffLabel').style.color = '#856404';
        document.getElementById('arqDiffLabel').textContent = 'Sobrante (se registrará un ingreso)';
        document.getElementById('arqDiffValor').style.color = '#856404';
        document.getElementById('arqDiffValor').textContent = fmt(diff);
    } else {
        panel.style.background = '#f8d7da'; panel.style.border = '1px solid #f5c6cb';
        document.getElementById('arqDiffLabel').style.color = '#721c24';
        document.getElementById('arqDiffLabel').textContent = 'Faltante (se registrará un egreso)';
        document.getElementById('arqDiffValor').style.color = '#721c24';
        document.getElementById('arqDiffValor').textContent = fmt(Math.abs(diff));
    }
};

