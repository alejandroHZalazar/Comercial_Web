@page
@model Comercial_Web.Pages.Contable.Caja.IndexModel
@{
    ViewData["Title"] = "Caja";
    var fmt = (decimal v) => v.ToString("C2", new System.Globalization.CultureInfo("es-AR"));
}

<style>
    .ck-header  { background:linear-gradient(135deg,#1a3a5c 0%,#2e6da4 100%); border-radius:12px; padding:1rem 1.5rem; margin-bottom:1.1rem; color:#fff; display:flex; align-items:center; gap:.8rem; }
    .ck-header h4 { margin:0; font-weight:700; font-size:1.1rem; }
    .ck-card    { background:#fff; border:1px solid #e3e6f0; border-radius:10px; padding:.9rem 1.1rem; box-shadow:0 2px 8px rgba(0,0,0,.05); margin-bottom:.85rem; }
    .ck-label   { font-size:.74rem; font-weight:600; color:#6c757d; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.15rem; }
    .ck-value   { font-size:1rem; font-weight:700; color:#1a3a5c; }
    .ck-state   { display:inline-block; padding:.2rem .65rem; border-radius:20px; font-size:.78rem; font-weight:700; letter-spacing:.05em; }
    .ck-state.abierta { background:#d4edda; color:#155724; border:1px solid #c3e6cb; }
    .ck-state.cerrada { background:#f8d7da; color:#721c24; border:1px solid #f5c6cb; }
    .ck-tot-card{ background:#f8f9fc; border:1px solid #e3e6f0; border-radius:8px; padding:.65rem .9rem; }
    .ck-tot-lbl { font-size:.75rem; color:#6c757d; font-weight:600; }
    .ck-tot-val { font-size:1.05rem; font-weight:800; color:#1a3a5c; }
    .ck-tot-val.debe  { color:#c0392b; }
    .ck-tot-val.haber { color:#1cc88a; }
    .ck-btn-group { display:flex; flex-wrap:wrap; gap:.5rem; }
    .ck-btn { font-size:.82rem; font-weight:600; padding:.45rem .9rem; border-radius:8px; border:none; cursor:pointer; transition:transform .1s, opacity .15s; display:inline-flex; align-items:center; gap:.4rem; }
    .ck-btn:hover:not(:disabled){ transform:translateY(-1px); opacity:.92; }
    .ck-btn:disabled { opacity:.45; cursor:not-allowed; }
    .ck-btn.success { background:linear-gradient(135deg,#1cc88a,#13855c); color:#fff; }
    .ck-btn.danger  { background:linear-gradient(135deg,#e74a3b,#a92e22); color:#fff; }
    .ck-btn.warn    { background:linear-gradient(135deg,#f6c23e,#dd9a04); color:#fff; }
    .ck-btn.info    { background:linear-gradient(135deg,#36b9cc,#258391); color:#fff; }
    .ck-btn.primary { background:linear-gradient(135deg,#1a3a5c,#2e6da4); color:#fff; }
    .ck-btn.secondary{background:linear-gradient(135deg,#858796,#5a5c69); color:#fff; }
    #tblResumen { font-size:.85rem; }
    #tblResumen thead tr { background:#1a3a5c; color:#fff; }
    #tblResumen thead th { padding:.45rem .6rem; font-weight:600; }
    #tblResumen tbody td { padding:.35rem .6rem; vertical-align:middle; }
    #tblResumen tbody tr:nth-child(even) { background:#f8f9fc; }
    .modal-header-ck { background:linear-gradient(135deg,#1a3a5c,#2e6da4); color:#fff; }
</style>

<div class="ck-header">
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="26" height="26">
        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.01a1 1 0 1 1 0-.01V4a1 1 0 0 0 1 1zm13 1V5a1 1 0 0 1-1-1V4a1 1 0 0 0-1-1zm-1 1a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM8 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6"/>
    </svg>
    <h4>Caja</h4>
</div>

@if (!Model.HaceCaja)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
        <div>
            <strong>El módulo de Caja no está habilitado.</strong><br />
            Para utilizar esta funcionalidad debe activarse el parámetro <code>caja / haceCaja = 1</code>.
        </div>
    </div>
    return;
}

@* ══ ESTADO + USUARIO + BOTONES ═════════════════════════════════════════════ *@
<div class="ck-card">
    <div class="row g-3 align-items-center">
        <div class="col-md-3">
            <div class="ck-label">Usuario</div>
            <div class="ck-value">@Model.NombreUsuario</div>
        </div>
        <div class="col-md-3">
            <div class="ck-label">Estado</div>
            <div>
                <span class="ck-state @(Model.Estado.Abierta ? "abierta" : "cerrada")" id="lblEstadoCaja">
                    @(Model.Estado.Abierta ? "ABIERTA" : "CERRADA")
                </span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ck-label">Apertura</div>
            <div class="ck-value" id="lblApertura">
                @(Model.Estado.Abierta && Model.Estado.FechaApertura.HasValue
                    ? Model.Estado.FechaApertura.Value.ToString("dd/MM/yyyy HH:mm")
                    : "—")
            </div>
        </div>
        <div class="col-md-3">
            <div class="ck-label">Saldo Inicial</div>
            <div class="ck-value" id="lblSaldoInicial">
                @(Model.Estado.Abierta ? fmt(Model.Estado.SaldoInicial) : "—")
            </div>
        </div>
    </div>
</div>

@* ══ BOTONERA ══════════════════════════════════════════════════════════════ *@
<div class="ck-card">
    <div class="ck-btn-group">
        <button type="button" id="btnAbrirCaja"     class="ck-btn success"   onclick="abrirModal('modalAbrir')">▲ Abrir Caja</button>
        <button type="button" id="btnCerrarCaja"    class="ck-btn danger"    onclick="abrirModal('modalCerrar')">▼ Cerrar Caja</button>
        <button type="button" id="btnIngresoDinero" class="ck-btn info"      onclick="abrirMovimiento('ingreso')">+ Ingreso de Dinero</button>
        <button type="button" id="btnEgresoDinero"  class="ck-btn warn"      onclick="abrirMovimiento('egreso')">− Extracción de Dinero</button>
        <button type="button" id="btnGastos"        class="ck-btn secondary" onclick="abrirGastos()">📋 Gastos</button>
        <button type="button" id="btnArqueo"        class="ck-btn primary"   onclick="abrirArqueo()">⚖ Arqueo de Caja</button>
        <button type="button" id="btnPagoProv"      class="ck-btn warn"      onclick="abrirPagoProv()">🏷 Pago a Proveedores</button>
    </div>
</div>

@* ══ TOTALES ═══════════════════════════════════════════════════════════════ *@
<div class="row g-2 mb-2">
    <div class="col-md-4">
        <div class="ck-tot-card">
            <div class="ck-tot-lbl">Total Debe</div>
            <div class="ck-tot-val debe" id="lblTotalDebe">@fmt(Model.TotalDebe)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ck-tot-card">
            <div class="ck-tot-lbl">Total Haber</div>
            <div class="ck-tot-val haber" id="lblTotalHaber">@fmt(Model.TotalHaber)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ck-tot-card" style="background:#fff7e6;border-color:#ffc107;">
            <div class="ck-tot-lbl" style="color:#856404;">Saldo en Efectivo</div>
            <div class="ck-tot-val" id="lblEfectivo" style="color:#856404;">@fmt(Model.SaldoEfectivo)</div>
        </div>
    </div>
</div>

@* ══ GRILLA RESUMEN ════════════════════════════════════════════════════════ *@
<div class="ck-card" style="padding:.4rem .6rem;">
    <div class="table-responsive">
        <table id="tblResumen" class="table table-bordered table-sm mb-0">
            <thead>
                <tr>
                    <th>Debe</th>
                    <th style="text-align:right;width:170px;">Importe Debe</th>
                    <th>Haber</th>
                    <th style="text-align:right;width:170px;">Importe Haber</th>
                </tr>
            </thead>
            <tbody id="tbodyResumen">
                @if (Model.Estado.Abierta && Model.Resumen.Count > 0)
                {
                    foreach (var r in Model.Resumen)
                    {
                        <tr>
                            <td>@(r.Debe ?? "")</td>
                            <td style="text-align:right;">@(r.ImporteDebe.HasValue ? fmt(r.ImporteDebe.Value) : "")</td>
                            <td>@(r.Haber ?? "")</td>
                            <td style="text-align:right;">@(r.ImporteHaber.HasValue ? fmt(r.ImporteHaber.Value) : "")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="rowVacio">
                        <td colspan="4" style="text-align:center;color:#aaa;padding:1rem;font-size:.85rem;">
                            @(Model.Estado.Abierta ? "Sin movimientos registrados aún." : "La caja está cerrada.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ══ MODAL: ABRIR CAJA ═════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalAbrir" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header modal-header-ck py-3">
                <div class="d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="20" height="20">
                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.01a1 1 0 1 1 0-.01V4a1 1 0 0 0 1 1zm13 1V5a1 1 0 0 1-1-1V4a1 1 0 0 0-1-1zm-1 1a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM8 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6"/>
                    </svg>
                    <h5 class="modal-title mb-0 fw-bold">Apertura de Caja</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">

                @* ── Datos del usuario y último cierre ── *@
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div style="background:#f0f4ff;border:1px solid #b8caff;border-radius:8px;padding:.75rem 1rem;">
                            <div class="row g-2 align-items-center">
                                <div class="col-sm-4">
                                    <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Usuario</div>
                                    <div style="font-size:.95rem;font-weight:700;color:#1a3a5c;" id="abrUsuario">@Model.NombreUsuario</div>
                                </div>
                                <div class="col-sm-4">
                                    <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Último cierre</div>
                                    <div style="font-size:.88rem;font-weight:600;color:#1a3a5c;" id="abrFechaCierre">
                                        @(Model.Estado.Existe && Model.Estado.FechaCierre.HasValue
                                            ? Model.Estado.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Sin cierres previos")
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Saldo del último cierre</div>
                                    <div style="font-size:1.05rem;font-weight:800;color:#1cc88a;" id="abrSaldoCierreDisplay">
                                        @fmt(Model.Estado.SaldoCierre ?? 0m)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Observaciones ── *@
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:.83rem;">Observaciones</label>
                    <textarea id="abrObservaciones" class="form-control" rows="3"
                              placeholder="Ingrese observaciones de apertura (opcional)…"
                              style="font-size:.85rem;resize:vertical;"></textarea>
                </div>

                @* ── Leyenda informativa ── *@
                <div class="alert mb-0 d-flex align-items-start gap-2 py-2 px-3"
                     style="background:#fff8e1;border:1px solid #ffe082;border-radius:8px;font-size:.8rem;color:#6d4c00;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" style="margin-top:.1rem;flex-shrink:0;">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                    </svg>
                    <span>
                        En caso de extracción o ingreso de dinero de la caja anterior,
                        <strong>debe registrar el movimiento al abrir la caja</strong> usando los botones correspondientes.
                    </span>
                </div>

            </div>

            <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal" style="font-size:.85rem;">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarAbrir" class="btn btn-success fw-semibold px-4"
                        onclick="confirmarAbrir()" style="font-size:.85rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    Abrir Caja
                </button>
            </div>
        </div>
    </div>
</div>

@* ══ MODAL: CERRAR CAJA ════════════════════════════════════════════════════ *@
<div class="modal fade" id="modalCerrar" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header modal-header-ck py-3">
                <div class="d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="20" height="20">
                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
                    </svg>
                    <h5 class="modal-title mb-0 fw-bold">Cierre de Caja</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">

                @* ── Datos del usuario y la caja abierta ── *@
                <div class="mb-4">
                    <div style="background:#fff3f3;border:1px solid #f5c6cb;border-radius:8px;padding:.75rem 1rem;">
                        <div class="row g-2 align-items-center">
                            <div class="col-sm-4">
                                <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Usuario</div>
                                <div style="font-size:.95rem;font-weight:700;color:#1a3a5c;">@Model.NombreUsuario</div>
                            </div>
                            <div class="col-sm-4">
                                <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Fecha apertura</div>
                                <div style="font-size:.88rem;font-weight:600;color:#1a3a5c;" id="cerFechaApertura">
                                    @(Model.Estado.Abierta && Model.Estado.FechaApertura.HasValue
                                        ? Model.Estado.FechaApertura.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "—")
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div style="font-size:.72rem;font-weight:700;color:#6c757d;text-transform:uppercase;letter-spacing:.05em;">Saldo final en efectivo</div>
                                <div style="font-size:1.05rem;font-weight:800;color:#c0392b;" id="cerSaldoFinalDisplay">
                                    @fmt(Model.SaldoEfectivo)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* ── Observaciones ── *@
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:.83rem;">Observaciones</label>
                    <textarea id="cerObservaciones" class="form-control" rows="3"
                              placeholder="Ingrese observaciones de cierre (opcional)…"
                              style="font-size:.85rem;resize:vertical;"></textarea>
                </div>

                @* ── Leyenda informativa ── *@
                <div class="d-flex align-items-start gap-2 py-2 px-3"
                     style="background:#fff8e1;border:1px solid #ffe082;border-radius:8px;font-size:.8rem;color:#6d4c00;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="16" height="16" style="margin-top:.1rem;flex-shrink:0;">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                    </svg>
                    <span>
                        En caso de extracción o ingreso de dinero de la caja actual,
                        <strong>debe registrar el movimiento antes de cerrar la caja</strong> usando los botones correspondientes.
                    </span>
                </div>

            </div>

            <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal" style="font-size:.85rem;">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarCerrar" class="btn btn-danger fw-semibold px-4"
                        onclick="confirmarCerrar()" style="font-size:.85rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;">
                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
                    </svg>
                    Cerrar Caja
                </button>
            </div>
        </div>
    </div>
</div>

@* ══ MODAL: MOVIMIENTO (ingreso / egreso / gasto / pago prov) ══════════════ *@
<div class="modal fade" id="modalMovimiento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-header-ck">
                <h5 class="modal-title" id="lblTituloMov">Movimiento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="movProveedorWrap" class="mb-3" style="display:none;">
                    <label class="form-label fw-semibold">Proveedor</label>
                    <select id="movProveedor" class="form-select"></select>
                </div>
                <div class="mb-3" id="movConceptoWrap">
                    <label class="form-label fw-semibold">Concepto</label>
                    <select id="movConcepto" class="form-select"></select>
                </div>
                <div class="mb-3" id="movConceptoFijoWrap" style="display:none;">
                    <label class="form-label fw-semibold">Concepto</label>
                    <div class="form-control bg-light text-muted d-flex align-items-center gap-2" style="cursor:default;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="14" height="14"><path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/><path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/></svg>
                        <span id="movConceptoFijoNombre" class="fw-semibold text-dark"></span>
                        <span class="text-muted small">(automático)</span>
                    </div>
                </div>
                <div class="mb-3" id="movMedioPagoWrap">
                    <label class="form-label fw-semibold">Medio de Pago</label>
                    <select id="movMedioPago" class="form-select">
                        @foreach (var mp in Model.ListaMediosPago)
                        {
                            <option value="@mp.Value">@mp.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-3" id="movEfectivoWrap" style="display:none;">
                    <label class="form-label fw-semibold">Medio de Pago</label>
                    <div class="form-control bg-light text-muted d-flex align-items-center gap-2" style="cursor:default;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.01a1 1 0 1 1 0-.01V4a1 1 0 0 0 1 1zm13 1V5a1 1 0 0 1-1-1V4a1 1 0 0 0-1-1zm-1 1a1 1 0 0 1 1 1V11a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM8 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6"/></svg>
                        <strong>Efectivo</strong> <span class="text-muted small">(único permitido para este tipo de movimiento)</span>
