// ── Movimiento (ingreso / egreso / pago proveedor) ────────────────────────
var _movTipo = '';   // 'ingreso' | 'egreso' | 'pagoProv'
var _movEfectivoForzado  = false;   // true para ingreso y egreso
var _movConceptoForzado  = false;   // true para ingreso y egreso (concepto viene de parámetros)

window.abrirMovimiento = async function(tipo){
    _movTipo = tipo;
    var titulo      = '';
    var tipoMov     = '';    // I | E  (sólo usado para pagoProv, que sí carga conceptos)
    var afectaEf    = null;
    var mostrarProv = false;

    switch(tipo){
        case 'ingreso': titulo='Ingreso de Dinero';    break;
        case 'egreso':  titulo='Extracción de Dinero'; break;
    }

    document.getElementById('lblTituloMov').textContent = titulo;
    document.getElementById('movImporte').value  = '';
    document.getElementById('movObservaciones').value = '';

    // ── Efectivo forzado (ingreso / egreso) ──────────────────────────────────
    _movEfectivoForzado = (tipo === 'ingreso' || tipo === 'egreso');
    document.getElementById('movMedioPagoWrap').style.display = _movEfectivoForzado ? 'none' : '';
    document.getElementById('movEfectivoWrap').style.display  = _movEfectivoForzado ? ''     : 'none';

    // ── Concepto forzado (ingreso / egreso) ──────────────────────────────────
    _movConceptoForzado = (tipo === 'ingreso' || tipo === 'egreso');
    var cWrap  = document.getElementById('movConceptoWrap');
    var cfWrap = document.getElementById('movConceptoFijoWrap');
    if (_movConceptoForzado){
        // Verificar que el parámetro esté configurado
        var conceptoParamId = tipo === 'ingreso' ? INGRESO_CONCEPTO_ID : EGRESO_CONCEPTO_ID;
        if (conceptoParamId <= 0){
            var paramNombre = tipo === 'ingreso' ? 'caja/IngresoDinero' : 'caja/EgresoDinero';
            alert('El parámetro ' + paramNombre + ' no está configurado. Configure este valor en Configuración → Parámetros antes de continuar.');
            return;
        }
        // Mostrar el nombre del concepto obtenido del servidor al cargar la página
        // (lo consultamos inline para no depender del valor cacheado)
        cWrap.style.display  = 'none';
        cfWrap.style.display = '';
        // Nombre del concepto: recuperarlo del servidor con una consulta rápida
        try {
            var tipoFiltro = tipo === 'ingreso' ? 'I' : 'E';
            var todos = await (await fetch('?handler=Conceptos&tipo='+tipoFiltro+'&afectaEfectivo=true')).json();
            var concepto = todos.find(function(c){ return c.id === conceptoParamId; });
            document.getElementById('movConceptoFijoNombre').textContent =
                concepto ? concepto.nombre : ('Concepto #' + conceptoParamId);
        } catch(e){
            document.getElementById('movConceptoFijoNombre').textContent = 'Concepto #' + conceptoParamId;
        }
    } else {
        cWrap.style.display  = '';
        cfWrap.style.display = 'none';
        // Cargar conceptos para el select (sólo pagoProv llega aquí)
        var qs = '?handler=Conceptos&tipo='+encodeURIComponent(tipoMov);
        if (afectaEf !== null) qs += '&afectaEfectivo=' + (afectaEf ? 'true':'false');
        var conceptos = await (await fetch(qs)).json();
        var sel = document.getElementById('movConcepto');
        sel.innerHTML = conceptos.length
            ? conceptos.map(c => '<option value="'+c.id+'">'+escHtml(c.nombre)+'</option>').join('')
            : '<option value="0">— No hay conceptos disponibles —</option>';
    }

    // El combo de proveedor dentro de modalMovimiento ya no se usa (pagoProv tiene su propio modal)
    document.getElementById('movProveedorWrap').style.display = 'none';

    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalMovimiento')).show();
};

window.confirmarMovimiento = async function(){
    var conceptoId = _movConceptoForzado ? 0 : (parseInt(document.getElementById('movConcepto').value)||0);
    var medioId    = _movEfectivoForzado ? 0 : (parseInt(document.getElementById('movMedioPago').value)||0);
    var importe    = parseFloat(document.getElementById('movImporte').value)||0;
    var obs        = document.getElementById('movObservaciones').value.trim();

    if (!_movConceptoForzado && conceptoId<=0){ alert('Seleccione un concepto.'); return; }
    if (!_movEfectivoForzado && medioId<=0)   { alert('Seleccione un medio de pago.'); return; }
    if (importe<=0){ alert('El importe debe ser mayor a cero.'); return; }

    var dto = { tipo: _movTipo, conceptoCajaId:conceptoId, medioPagoId:medioId, importe:importe, observaciones: obs||null, proveedorId: null };

    var resp = await fetch('?handler=Movimiento', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dto) });
    var r = await resp.json();
    if (!r.ok){ alert(r.msg||'Error al registrar movimiento.'); return; }
    bootstrap.Modal.getInstance(document.getElementById('modalMovimiento'))?.hide();
    await refrescar();
};

// ── Pago a Proveedores ─────────────────────────────────────────────────────
window.abrirPagoProv = async function(){
    var alertEl  = document.getElementById('pagoProvParamAlert');
    var formWrap = document.getElementById('pagoProvFormWrap');
    var btn      = document.getElementById('btnConfirmarPagoProv');

    // Validar parámetros
    var paramError = '';
    if (PAGO_PROV_CONCEPTO_ID <= 0) paramError = 'El parámetro <code>caja/ConceptosPagosProveedores</code> no está configurado.';
    else if (MEDIO_EFECTIVO_ID <= 0) paramError = 'El parámetro <code>caja/MedioPagoEfectivo</code> no está configurado.';

    if (paramError){
        alertEl.style.removeProperty('display');
        document.getElementById('pagoProvParamAlertMsg').innerHTML =
            '<strong>Parámetro faltante.</strong> ' + paramError +
            ' Configure este valor en <strong>Configuración → Parámetros</strong>.';
        formWrap.style.display = 'none';
        btn.disabled = true;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalPagoProv')).show();
        return;
    }

    // Parámetros OK — mostrar formulario
    alertEl.style.display = 'none';
    formWrap.style.display = '';
    btn.disabled = false;
    btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg> Registrar Pago';

    // Limpiar campos
    document.getElementById('ppImporte').value       = '';
    document.getElementById('ppObservaciones').value = '';

    // Cargar proveedores
    try {
        var provs = await (await fetch('?handler=Proveedores')).json();
        var sel   = document.getElementById('ppProveedor');
        sel.innerHTML = '<option value="0">— Seleccione un proveedor —</option>';
        if (provs.length){
            sel.innerHTML += provs.map(p =>
                '<option value="'+p.id+'">'+escHtml(p.nombre)+'</option>'
            ).join('');
        } else {
            sel.innerHTML = '<option value="0">— No hay proveedores disponibles —</option>';
        }
    } catch(e){
        document.getElementById('ppProveedor').innerHTML =
            '<option value="0">— Error al cargar proveedores —</option>';
    }

    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalPagoProv')).show();
    document.getElementById('modalPagoProv').addEventListener('shown.bs.modal', function foc(){
        document.getElementById('ppProveedor').focus();
        document.getElementById('modalPagoProv').removeEventListener('shown.bs.modal', foc);
    });
};

