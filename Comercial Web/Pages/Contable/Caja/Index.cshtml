                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    Confirmar Arqueo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function(){
'use strict';

var HACE_CAJA          = @(Model.HaceCaja ? "true" : "false");
var MEDIO_EFECTIVO_ID  = @Model.MedioEfectivoId;
var GASTO_CONCEPTO_ID  = @Model.GastoConceptoId;
var INGRESO_CONCEPTO_ID= @Model.IngresoConceptoId;
var EGRESO_CONCEPTO_ID = @Model.EgresoConceptoId;
var ARQUEO_INGRESO_ID   = @Model.ArqueoIngresoId;
var ARQUEO_EGRESO_ID    = @Model.ArqueoEgresoId;
var PAGO_PROV_CONCEPTO_ID = @Model.PagoProvConceptoId;
if (!HACE_CAJA) return;

// ── Helpers ────────────────────────────────────────────────────────────────
function fmt(n){ return new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',minimumFractionDigits:2,maximumFractionDigits:2}).format(n||0); }
function escHtml(s){ return (s==null?'':String(s)).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

window.abrirModal = function(id){
    var el = document.getElementById(id);
    if (!el) return;
    if (id === 'modalCerrar'){
        // Sincronizar saldo y fecha apertura con los valores actuales del DOM
        // (que refrescar() mantiene al día)
        document.getElementById('cerSaldoFinalDisplay').textContent =
            document.getElementById('lblEfectivo').textContent;
        document.getElementById('cerFechaApertura').textContent =
            document.getElementById('lblApertura').textContent;
        document.getElementById('cerObservaciones').value = '';
        document.getElementById('btnConfirmarCerrar').disabled = false;
        document.getElementById('btnConfirmarCerrar').innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 16 16" width="15" height="15" style="margin-right:.35rem;vertical-align:-.1em;"><path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/></svg> Cerrar Caja';
    } else if (id === 'modalAbrir'){
        // El saldo inicial y datos del último cierre vienen del servidor vía Razor;
        // sólo limpiamos observaciones al abrir.
        document.getElementById('abrObservaciones').value = '';
        document.getElementById('btnConfirmarAbrir').disabled = false;
    }
    bootstrap.Modal.getOrCreateInstance(el).show();
};

// ── Refrescar estado / grilla / totales ───────────────────────────────────
async function refrescar(){
    try {
        var resp = await fetch('?handler=EstadoJson');
        var d = await resp.json();
        // Estado UI
        var lblEst = document.getElementById('lblEstadoCaja');
        var abierta = d.estado && d.estado.abierta;
        lblEst.textContent = abierta ? 'ABIERTA' : 'CERRADA';
        lblEst.className = 'ck-state ' + (abierta ? 'abierta' : 'cerrada');

        document.getElementById('lblApertura').textContent = (abierta && d.estado.fechaApertura)
            ? new Date(d.estado.fechaApertura).toLocaleString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })
            : '—';
        document.getElementById('lblSaldoInicial').textContent = abierta ? fmt(d.estado.saldoInicial) : '—';
        document.getElementById('lblTotalDebe').textContent    = fmt(d.totalDebe);
        document.getElementById('lblTotalHaber').textContent   = fmt(d.totalHaber);
        document.getElementById('lblEfectivo').textContent     = fmt(d.saldoEfectivo);

        // Grilla
        var tb = document.getElementById('tbodyResumen');
        if (!abierta){
            tb.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#aaa;padding:1rem;font-size:.85rem;">La caja está cerrada.</td></tr>';
        } else if (!d.resumen.length){
            tb.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#aaa;padding:1rem;font-size:.85rem;">Sin movimientos registrados aún.</td></tr>';
        } else {
            tb.innerHTML = d.resumen.map(r =>
                '<tr>'+
                  '<td>'+escHtml(r.debe||'')+'</td>'+
                  '<td style="text-align:right;">'+(r.importeDebe!=null?fmt(r.importeDebe):'')+'</td>'+
                  '<td>'+escHtml(r.haber||'')+'</td>'+
                  '<td style="text-align:right;">'+(r.importeHaber!=null?fmt(r.importeHaber):'')+'</td>'+
                '</tr>'
            ).join('');
        }

        // Habilitar/deshabilitar botones según estado
        document.getElementById('btnAbrirCaja').disabled     =  abierta;
        document.getElementById('btnCerrarCaja').disabled    = !abierta;
        document.getElementById('btnIngresoDinero').disabled = !abierta;
        document.getElementById('btnEgresoDinero').disabled  = !abierta;
        document.getElementById('btnGastos').disabled        = !abierta;
        document.getElementById('btnArqueo').disabled        = !abierta;
        document.getElementById('btnPagoProv').disabled      = !abierta;
    } catch(e){ console.error('refrescar:', e); }
}

// ── Abrir caja ─────────────────────────────────────────────────────────────
// El saldo inicial se toma automáticamente del saldo_cierre de la caja anterior
// (lógica emulada en el servidor, igual que sp_Caja_Apertura).
window.confirmarAbrir = async function(){
    var btn = document.getElementById('btnConfirmarAbrir');
    btn.disabled = true;
    btn.textContent = 'Abriendo…';

    var obs = document.getElementById('abrObservaciones').value.trim();
    var dto = {
        observaciones: obs || null
    };

    try {
        var resp = await fetch('?handler=Abrir', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dto) });
        var r = await resp.json();
        if (!r.ok){
            alert(r.msg || 'Ha ocurrido un error durante el procesamiento.');
            btn.disabled = false;
