</div>

@section Scripts {
<script>
// ======================================================================
// PARÁMETROS DEL SISTEMA
// ======================================================================
const BONIF_POR_LINEA = @Model.BonificacionPorLinea;
const PROD_DOLARIZADOS = @Model.ProductosDolarizados;
const COTIZ_DOLAR = @Model.CotizDolar.ToString(System.Globalization.CultureInfo.InvariantCulture);

// ======================================================================
// ESTADO GLOBAL
// ======================================================================
let _clienteId = 0;
let _pedidoId  = 0;
let _rows      = [];
let _lastProdInput = 'desc';
let _prodSelIdx = -1;
let _cliSelIdx  = -1;

// Inicializar columna Sel y desc/rec bar según parámetro
(function initBonif() {
  if (BONIF_POR_LINEA === 0) {
    document.getElementById('thSel').style.display = 'none';
    document.getElementById('descRecMsg').textContent = 'Se aplicará a todos los productos.';
  } else {
    document.getElementById('descRecMsg').textContent = 'Se aplicará solo a filas seleccionadas (Sel ✓).';
  }
})();

// ======================================================================
// FORMATEO
// ======================================================================
function fmt(n) {
  return '$\u00a0' + (+(n||0)).toLocaleString('es-AR', {minimumFractionDigits:2,maximumFractionDigits:2});
}
function fmtN(n, dec) {
  dec = dec === undefined ? 2 : dec;
  return (+(n||0)).toLocaleString('es-AR', {minimumFractionDigits:dec,maximumFractionDigits:dec});
}

// ======================================================================
// CLIENTE AUTOCOMPLETE
// ======================================================================
let _cliTimer = null;
function onClienteInput(val) {
  clearTimeout(_cliTimer);
  _cliSelIdx = -1;
  if (val.length < 2) { cerrarDropCli(); return; }
  _cliTimer = setTimeout(function() { fetchClientes(val); }, 300);
}

function onClienteKeydown(e) {
  var drop = document.getElementById('dropClientes');
  var items = drop.querySelectorAll('.ac-item');
  if (e.key === 'ArrowDown') { e.preventDefault(); _cliSelIdx = Math.min(_cliSelIdx+1, items.length-1); highlightCli(items); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); _cliSelIdx = Math.max(_cliSelIdx-1, 0); highlightCli(items); }
  else if (e.key === 'Enter') { e.preventDefault(); if (_cliSelIdx >= 0 && items[_cliSelIdx]) items[_cliSelIdx].click(); }
  else if (e.key === 'Escape') cerrarDropCli();
}
function highlightCli(items) {
  items.forEach(function(it,i) { it.classList.toggle('active', i === _cliSelIdx); });
  if (items[_cliSelIdx]) items[_cliSelIdx].scrollIntoView({block:'nearest'});
}

async function fetchClientes(q) {
  var r = await fetch('/Ventas/Pedidos?handler=BuscarClientes&q=' + encodeURIComponent(q));
  var data = await r.json();
  var drop = document.getElementById('dropClientes');
  if (!data.length) { cerrarDropCli(); return; }
  drop.innerHTML = data.map(function(c,i) {
    return '<div class="ac-item" data-idx="' + i + '"'
      + ' ondblclick="seleccionarCliente(' + escAttr(JSON.stringify(c)) + ')"'
      + ' onclick="seleccionarCliente(' + escAttr(JSON.stringify(c)) + ')">'
      + '<strong>' + (c.nombreComercial||'') + '</strong>'
      + '<small>' + (c.direccionFull||'') + '</small>'
      + '</div>';
  }).join('');
  drop.classList.add('open');
}

function seleccionarCliente(c) {
  _clienteId = c.clienteId;
  document.getElementById('hClienteId').value = c.clienteId;
  document.getElementById('txtBuscarCliente').value = '';
  cerrarDropCli();
  document.getElementById('ci-nombre').textContent    = c.nombreComercial || '';
  document.getElementById('ci-telefono').textContent  = c.telefono   || '--';
  document.getElementById('ci-direccion').textContent = c.direccionFull || '--';
  document.getElementById('ci-contacto').textContent  = c.contacto   || '--';
  document.getElementById('clienteInfo').style.display  = 'block';
  document.getElementById('clienteVacio').style.display = 'none';
}
function cerrarDropCli() {
  document.getElementById('dropClientes').classList.remove('open');
  document.getElementById('dropClientes').innerHTML = '';
}

// ======================================================================
// BÚSQUEDA DE PRODUCTOS
// ======================================================================
let _prodTimer = null;
let _prodSelIdxBarras=-1, _prodSelIdxCodProv=-1, _prodSelIdxDesc=-1;

async function onProdExactoKeydown(e, tipo) {
  var inputId = tipo === 'codBarras' ? 'txtCodBarras' : 'txtCodProv';
  var dropId  = tipo === 'codBarras' ? 'dropBarras'   : 'dropCodProv';
  var drop    = document.getElementById(dropId);
  var items   = drop.querySelectorAll('.ac-item');

  if (e.key === 'ArrowDown') {
    e.preventDefault();
    var idx = tipo==='codBarras'?_prodSelIdxBarras:_prodSelIdxCodProv;
    idx = Math.min(idx+1, items.length-1);
    if (tipo==='codBarras') _prodSelIdxBarras=idx; else _prodSelIdxCodProv=idx;
    highlightProd(items, idx);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    var idx2 = tipo==='codBarras'?_prodSelIdxBarras:_prodSelIdxCodProv;
    idx2 = Math.max(idx2-1, 0);
    if (tipo==='codBarras') _prodSelIdxBarras=idx2; else _prodSelIdxCodProv=idx2;
    highlightProd(items, idx2);
  } else if (e.key === 'Enter') {
    e.preventDefault();
    var idxSel = tipo==='codBarras'?_prodSelIdxBarras:_prodSelIdxCodProv;
    if (items.length > 0 && items[idxSel]) { items[idxSel].click(); return; }
    var val = document.getElementById(inputId).value.trim();
    if (!val) return;
    _lastProdInput = tipo;
    var data = await fetchProductos(val, tipo);
    if (data.length === 1) { seleccionarProducto(data[0]); }
    else if (data.length > 1) { mostrarDropProd(data, dropId, tipo); }
  }
}

function onProdInput(val, tipo) {
  var dropId = tipo === 'codBarras' ? 'dropBarras' : 'dropCodProv';
  clearTimeout(_prodTimer);
  _lastProdInput = tipo;
  if (!val) { cerrarDropProd(dropId); return; }
  _prodTimer = setTimeout(async function() {
    var data = await fetchProductos(val, tipo);
    mostrarDropProd(data, dropId, tipo);
  }, 300);
}

function onProdDescInput(val) {
  clearTimeout(_prodTimer);
  _lastProdInput = 'desc';
  _prodSelIdxDesc = -1;
  if (val.length < 2) { cerrarDropProd('dropDesc'); return; }
  _prodTimer = setTimeout(async function() {
    var data = await fetchProductos(val, 'descripcion');
    mostrarDropProd(data, 'dropDesc', 'descripcion');
  }, 300);
}
function onProdDescKeydown(e) {
  var drop  = document.getElementById('dropDesc');
  var items = drop.querySelectorAll('.ac-item');
  if (e.key==='ArrowDown') { e.preventDefault(); _prodSelIdxDesc=Math.min(_prodSelIdxDesc+1,items.length-1); highlightProd(items,_prodSelIdxDesc); }
  else if (e.key==='ArrowUp')   { e.preventDefault(); _prodSelIdxDesc=Math.max(_prodSelIdxDesc-1,0); highlightProd(items,_prodSelIdxDesc); }
  else if (e.key==='Enter') { e.preventDefault(); if (_prodSelIdxDesc>=0&&items[_prodSelIdxDesc]) items[_prodSelIdxDesc].click(); }
  else if (e.key==='Escape') cerrarDropProd('dropDesc');
}
function highlightProd(items, idx) {
  items.forEach(function(it,i) { it.classList.toggle('active', i===idx); });
  if (items[idx]) items[idx].scrollIntoView({block:'nearest'});
}

async function fetchProductos(q, tipo) {
  var r = await fetch('/Ventas/Pedidos?handler=BuscarProductos&q=' + encodeURIComponent(q) + '&tipo=' + tipo);
  return await r.json();
}
function mostrarDropProd(data, dropId, tipo) {
  var drop = document.getElementById(dropId);
  if (!data.length) { cerrarDropProd(dropId); return; }
  drop.innerHTML = data.map(function(p) {
    return '<div class="ac-item"'
      + ' onclick="seleccionarProducto(' + escAttr(JSON.stringify(p)) + ')"'
      + ' ondblclick="seleccionarProducto(' + escAttr(JSON.stringify(p)) + ')">'
      + '<strong>' + (p.codProveedor||'') + '</strong> -- ' + (p.descripcion||'')
      + '<small>Stock: ' + fmtN(p.stock) + ' | P.S/IVA: ' + fmt(p.precioSinIva) + '</small>'
      + '</div>';
  }).join('');
  drop.classList.add('open');
}
function cerrarDropProd(dropId) {
  var d = document.getElementById(dropId);
  if(d) { d.classList.remove('open'); d.innerHTML=''; }
}
function cerrarTodosDropsProd() {
  ['dropBarras','dropCodProv','dropDesc'].forEach(function(id) { cerrarDropProd(id); });
}

function escAttr(s) {
  return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;');
}

let _prodPendiente = null;
function seleccionarProducto(p) {
  cerrarTodosDropsProd();
  document.getElementById('txtCodBarras').value   = '';
  document.getElementById('txtCodProv').value     = '';
  document.getElementById('txtDescripcion').value = '';
  _prodPendiente = p;
  var cant = document.getElementById('txtCantidad');
  cant.value = '';
  cant.focus();
  cant.select();
}

function onCantidadKeydown(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    var cant = parseFloat(document.getElementById('txtCantidad').value) || 0;
    if (cant <= 0 || !_prodPendiente) return;
    var rowIdx = agregarProducto(_prodPendiente, cant);
    _prodPendiente = null;
    document.getElementById('txtCantidad').value = '';
    setTimeout(function() {
      var obsInput = document.querySelector('#tbodyDetalle tr[data-idx="' + rowIdx + '"] input.td-obs');
      var map = { codBarras:'txtCodBarras', codProveedor:'txtCodProv', desc:'txtDescripcion' };
      var targetId = map[_lastProdInput] || 'txtDescripcion';
      if (obsInput) {
        obsInput.focus();
        obsInput.addEventListener('keydown', function obsEnter(ev) {
          if (ev.key === 'Enter') {
            ev.preventDefault();
            obsInput.removeEventListener('keydown', obsEnter);
            var el = document.getElementById(targetId);
            if (el) { el.focus(); el.select(); }
          }
        });
      } else {
        var el = document.getElementById(targetId);
        if (el) { el.focus(); el.select(); }
      }
    }, 50);
  } else if (e.key === 'Escape') {
    _prodPendiente = null;
    document.getElementById('txtCantidad').value = '';
    var map = { codBarras:'txtCodBarras', codProveedor:'txtCodProv', desc:'txtDescripcion' };
    var el  = document.getElementById(map[_lastProdInput] || 'txtDescripcion');
    if (el) el.focus();
  }
}

// ======================================================================
// GRILLA
// ======================================================================
function getIva() { return parseFloat(document.getElementById('selIva').value) || 0; }

function calcRow(row) {
  var iva = getIva();
  row.subtotalSinIva = row.precioSinIva * (1 + row.descRec / 100);
  row.precioConIva   = row.subtotalSinIva * (1 + iva / 100);
  row.subtotal       = row.precioConIva * row.cantidad;
}

function agregarProducto(p, cant) {
  var iva = getIva();
  var row = {
    fkProducto:    p.productoId,
    codBarras:     p.codBarras   || '',
    codProveedor:  p.codProveedor || '',
    descripcion:   p.descripcion  || '',
    observ:        '',
    stock:         p.stock        || 0,
    precioSinIva:  p.precioSinIva || 0,
    descRec:       0,
    subtotalSinIva: p.precioSinIva || 0,
    precioConIva:  (p.precioSinIva || 0) * (1 + iva/100),
    cantidad:      cant,
    subtotal:      (p.precioSinIva || 0) * (1 + iva/100) * cant,
    dolarizado:    p.dolarizado || false,
    costo:         p.costo       || 0,
    precioOrig:    p.precioOrig  || 0,
    selected:      false
  };
  calcRow(row);
  _rows.push(row);
  var idx = _rows.length - 1;
  renderGrilla();
  recalcularTotales();
  return idx;
}

function eliminarFila(idx) {
  _rows.splice(idx, 1);
  renderGrilla();
  recalcularTotales();
}

function _syncChkAll() {
  var chkAll = document.getElementById('chkSelAll');
  if (!chkAll) return;
  var total = _rows.length;
  var sel   = _rows.filter(function(r){ return r.selected; }).length;
  chkAll.indeterminate = sel > 0 && sel < total;
  chkAll.checked       = total > 0 && sel === total;
}

function renderGrilla() {
  var tbody = document.getElementById('tbodyDetalle');
  if (_rows.length === 0) {
    tbody.innerHTML = '<tr id="trVacio"><td colspan="13" style="text-align:center;padding:1.5rem;color:#aaa;font-size:.82rem;">No hay productos en el pedido.</td></tr>';
    _syncChkAll();
    return;
  }
  tbody.innerHTML = _rows.map(function(r, i) {
    var selVis = BONIF_POR_LINEA === 1 ? '' : 'display:none;';
    var clsDescRec = r.descRec < 0 ? 'td-neg' : (r.descRec > 0 ? 'td-pos' : '');
    return '<tr data-idx="' + i + '">'
      + '<td style="' + selVis + 'text-align:center;"><input type="checkbox" class="row-sel" onchange="rowSelChange(' + i + ',this.checked)" ' + (r.selected?'checked':'') + '></td>'
      + '<td style="font-size:.72rem;">' + escH(r.codBarras) + '</td>'
      + '<td style="font-size:.72rem;">' + escH(r.codProveedor) + '</td>'
      + '<td title="' + escH(r.descripcion) + '">' + escH(r.descripcion) + '</td>'
      + '<td><input type="text" class="td-edit td-obs" value="' + escH(r.observ||'') + '" maxlength="50"'
      +   ' oninput="_rows[' + i + '].observ=this.value" style="width:110px;text-align:left;"></td>'
      + '<td class="td-calc">' + fmtN(r.stock) + '</td>'
      + '<td><input type="number" class="td-edit" value="' + fmtNum(r.precioSinIva) + '" min="0" step="0.01"'
      +   ' oninput="onChangePrecio(' + i + ',this.value)"'
      +   ' onchange="onChangePrecio(' + i + ',this.value)"'
      +   ' style="width:80px;"></td>'
      + '<td><input type="number" class="td-edit ' + clsDescRec + '" value="' + fmtNum(r.descRec) + '" step="0.01"'
      +   ' oninput="onChangeDescRec(' + i + ',this.value)"'
      +   ' onchange="onChangeDescRec(' + i + ',this.value)"'
      +   ' style="width:60px;"></td>'
      + '<td class="td-calc">' + fmt(r.subtotalSinIva) + '</td>'
      + '<td class="td-calc">' + fmt(r.precioConIva) + '</td>'
      + '<td><input type="number" class="td-edit" value="' + fmtNum(r.cantidad) + '" min="0" step="0.01"'
      +   ' oninput="onChangeCantidad(' + i + ',this.value)"'
      +   ' onchange="onChangeCantidad(' + i + ',this.value)"'
      +   ' style="width:65px;"></td>'
      + '<td class="td-calc" id="sub-' + i + '">' + fmt(r.subtotal) + '</td>'
      + '<td><button class="btn-del-row" title="Eliminar" onclick="eliminarFila(' + i + ')">&#x2715;</button></td>'
      + '</tr>';
  }).join('');
  _syncChkAll();
}

function fmtNum(n) { return (+(n||0)).toFixed(2); }
function escH(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function onChangePrecio(idx, val) {
  _rows[idx].precioSinIva = parseFloat(val)||0;
  calcRow(_rows[idx]);
  actualizarCeldasCalc(idx);
  recalcularTotales();
}
function onChangeDescRec(idx, val) {
  var v = parseFloat(val) || 0;
  if (BONIF_POR_LINEA === 0) {
    // Aplica a TODAS las filas
    _rows.forEach(function(r) { r.descRec = v; calcRow(r); });
    renderGrilla();
  } else {
    // Solo a la fila actual
    _rows[idx].descRec = v;
    calcRow(_rows[idx]);
    actualizarCeldasCalc(idx);
  }
  recalcularTotales();
}

// ======================================================================
// DESC/REC — barra de aplicación global/selectiva
// ======================================================================
document.querySelectorAll('input[name="tipoDescRec"]').forEach(function(radio) {
  radio.addEventListener('change', function() {
    var isDesc = document.getElementById('rdDescuento').checked;
    document.getElementById('lblDescuento').style.background = isDesc ? '#e74a3b' : '#f0f0f0';
    document.getElementById('lblDescuento').style.color      = isDesc ? '#fff'    : '#666';
    document.getElementById('lblRecargo').style.background   = isDesc ? '#f0f0f0': '#1cc88a';
    document.getElementById('lblRecargo').style.color        = isDesc ? '#666'   : '#fff';
  });
});

function aplicarDescRec() {
  var pct   = parseFloat(document.getElementById('txtDescRecPct').value) || 0;
  var isDesc = document.getElementById('rdDescuento').checked;
  var valor  = isDesc ? -pct : pct;
  var msg    = document.getElementById('descRecMsg');
  if (pct === 0) { msg.textContent = 'Ingrese un porcentaje mayor a 0.'; return; }
  if (_rows.length === 0) { msg.textContent = 'No hay productos en el pedido.'; return; }

  if (BONIF_POR_LINEA === 0) {
    _rows.forEach(function(r) { r.descRec = valor; calcRow(r); });
    msg.textContent = (isDesc ? 'Descuento' : 'Recargo') + ' de ' + pct + '% aplicado a todos los productos.';
  } else {
    var selRows = _rows.filter(function(r) { return r.selected; });
    if (selRows.length === 0) {
      msg.textContent = 'Seleccione al menos una fila para aplicar.';
      return;
    }
    selRows.forEach(function(r) { r.descRec = valor; calcRow(r); });
    msg.textContent = (isDesc ? 'Descuento' : 'Recargo') + ' de ' + pct + '% aplicado a ' + selRows.length + ' fila(s) seleccionada(s).';
  }
  renderGrilla();
  recalcularTotales();
  // Limpiar mensaje después de 3s
  setTimeout(function() { document.getElementById('descRecMsg').textContent = ''; }, 3000);
}

function limpiarDescRec() {
  _rows.forEach(function(r) { r.descRec = 0; calcRow(r); });
  renderGrilla();
  recalcularTotales();
  document.getElementById('txtDescRecPct').value = '';
  var msg = document.getElementById('descRecMsg');
  msg.textContent = 'Desc/Rec eliminado de todas las filas.';
  setTimeout(function() { msg.textContent = ''; }, 3000);
}
function onChangeCantidad(idx, val) {
  _rows[idx].cantidad = parseFloat(val)||0;
  calcRow(_rows[idx]);
  actualizarCeldasCalc(idx);
  recalcularTotales();
}
function rowSelChange(idx, checked) {
  _rows[idx].selected = checked;
  // Sincronizar checkbox maestro
  var chkAll = document.getElementById('chkSelAll');
  if (chkAll) {
    var total = _rows.length;
    var seleccionadas = _rows.filter(function(r){ return r.selected; }).length;
    chkAll.indeterminate = seleccionadas > 0 && seleccionadas < total;
    chkAll.checked = seleccionadas === total && total > 0;
  }
}

function seleccionarTodas(checked) {
  _rows.forEach(function(r) { r.selected = checked; });
  // Actualizar checkboxes en DOM sin re-renderizar toda la grilla
  document.querySelectorAll('#tbodyDetalle input.row-sel').forEach(function(cb) {
    cb.checked = checked;
  });
}
function actualizarCeldasCalc(idx) {
  var r = _rows[idx];
  var tr = document.querySelector('#tbodyDetalle tr[data-idx="' + idx + '"]');
  if (!tr) return;
  var cells = tr.querySelectorAll('td');
  cells[8].textContent = fmt(r.subtotalSinIva);
  cells[9].textContent = fmt(r.precioConIva);
  cells[11].textContent = fmt(r.subtotal);
}

// ======================================================================
// TOTALIZADORES
// ======================================================================
function recalcularTodo() {
  _rows.forEach(function(r) { calcRow(r); });
  renderGrilla();
  recalcularTotales();
}
function recalcularTotales() {
  var subSIva  = _rows.reduce(function(a,r) { return a + r.precioSinIva * r.cantidad; }, 0);
  var descRec  = _rows.reduce(function(a,r) { return a + (r.subtotalSinIva - r.precioSinIva) * r.cantidad; }, 0);
  var totSIva  = _rows.reduce(function(a,r) { return a + r.subtotalSinIva * r.cantidad; }, 0);
  var totGral  = _rows.reduce(function(a,r) { return a + r.subtotal; }, 0);
  document.getElementById('totSubSIva').textContent = fmt(subSIva);
  document.getElementById('totDescRec').textContent = fmt(descRec);
  document.getElementById('totSIva').textContent    = fmt(totSIva);
  document.getElementById('totGeneral').textContent = fmt(totGral);
}

// ======================================================================
// GUARDAR PEDIDO
// ======================================================================
async function guardarPedido() {
  if (_clienteId <= 0) { alert('Debe seleccionar un cliente.'); return; }
  if (_rows.length === 0) { alert('Debe agregar al menos un producto.'); return; }
  var vendId = parseInt(document.getElementById('selVendedor').value)||0;
  if (vendId <= 0) { alert('Debe seleccionar un vendedor.'); return; }

  var btn = document.getElementById('btnConfirmar');
  btn.disabled = true;
  document.getElementById('progressWrap').style.display='block';
  animProgress();

  var dto = {
    pedidoId:    _pedidoId,
    fkCliente:   _clienteId,
    iva:         parseFloat(document.getElementById('selIva').value)||0,
    fkVendedor:  vendId,
    observacion: document.getElementById('txtObservacion').value.trim(),
    total:       _rows.reduce(function(a,r){return a+r.subtotal;},0),
    detalle:     _rows.map(function(r) {
      return {
        fkProducto:    r.fkProducto,
        codBarras:     r.codBarras,
        codProveedor:  r.codProveedor,
        descripcion:   r.descripcion,
        precioSinIva:  r.precioSinIva,
        cantidad:      r.cantidad,
        precioOrig:    r.precioOrig,
        costo:         r.costo,
        precioConIva:  r.precioConIva,
        observ:        r.observ,
        descuento:     r.descRec < 0 ? Math.abs(r.descRec) : 0,
        recargo:       r.descRec > 0 ? r.descRec : 0,
        subtotalSinIva: r.subtotalSinIva
      };
    })
  };

  try {
    var resp = await fetch('/Ventas/Pedidos?handler=GuardarPedido', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(dto)
    });
    var ct = resp.headers.get('content-type')||'';
    if (!ct.includes('application/json')) { throw new Error('Error del servidor (' + resp.status + ')'); }
    var data = await resp.json();
    if (data.ok) {
      setProgress(100);
      setTimeout(function() {
        alert('Pedido N\u00b0 ' + String(data.pedidoId).padStart(6,'0') + ' guardado correctamente.');
        limpiarTodo();
      }, 400);
    } else {
      alert(data.msg || 'Error al guardar.');
      btn.disabled = false;
      document.getElementById('progressWrap').style.display='none';
    }
  } catch(e) {
    alert('Error: ' + e.message);
    btn.disabled = false;
    document.getElementById('progressWrap').style.display='none';
  }
}

let _progInterval = null;
let _progVal = 0;
function animProgress() {
  _progVal = 0;
  _progInterval = setInterval(function() {
    _progVal = Math.min(_progVal + Math.random()*15, 90);
    setProgress(_progVal);
  }, 200);
}
function setProgress(v) {
  if (v >= 100 && _progInterval) { clearInterval(_progInterval); _progInterval=null; }
  var bar = document.getElementById('progressBar');
  bar.style.width = v + '%';
  bar.textContent = v < 100 ? 'Guardando...' : '¡Listo!';
}

// ======================================================================
// LIMPIAR
// ======================================================================
function limpiarTodo() {
  _clienteId = 0; _pedidoId = 0; _rows = [];
  document.getElementById('clienteInfo').style.display  = 'none';
  document.getElementById('clienteVacio').style.display = 'block';
  document.getElementById('hClienteId').value           = '0';
  document.getElementById('txtBuscarCliente').value     = '';
  document.getElementById('txtObservacion').value       = '';
  document.getElementById('txtCodBarras').value         = '';
  document.getElementById('txtCodProv').value           = '';
  document.getElementById('txtDescripcion').value       = '';
  document.getElementById('txtCantidad').value          = '';
  document.getElementById('lblPedidoId').textContent    = '';
  document.getElementById('progressWrap').style.display = 'none';
  document.getElementById('btnConfirmar').disabled       = false;
  _prodPendiente = null;
  renderGrilla();
  recalcularTotales();
}

// ======================================================================
// MODAL: BUSCAR PEDIDO — multi-select helpers
// ======================================================================
function abrirBuscarPedido() {
  new bootstrap.Modal(document.getElementById('modalBuscarPedido')).show();
}

function bpToggleDrop(dropId, wrapId) {
  var drop = document.getElementById(dropId);
  var wrap = document.getElementById(wrapId);
  // Cerrar otros
  document.querySelectorAll('.bp-multisel-drop.open').forEach(function(d) { if (d.id !== dropId) d.classList.remove('open'); });
  document.querySelectorAll('.bp-multisel-wrap').forEach(function(w) { if (w.id !== wrapId) w.classList.remove('open'); });
  drop.classList.toggle('open');
  wrap.classList.toggle('open');
}
function bpSelAll(dropId, lblId) {
  document.querySelectorAll('#' + dropId + ' .bp-multisel-item input[type=checkbox]').forEach(function(cb) { cb.checked = true; });
  bpUpdateLabel(dropId, lblId);
}
function bpSelNone(dropId, lblId) {
  document.querySelectorAll('#' + dropId + ' .bp-multisel-item input[type=checkbox]').forEach(function(cb) { cb.checked = false; });
  bpUpdateLabel(dropId, lblId);
}
function bpUpdateLabel(dropId, lblId) {
  var checks = document.querySelectorAll('#' + dropId + ' .bp-multisel-item input[type=checkbox]');
  var sel = [];
  checks.forEach(function(cb) { if (cb.checked) sel.push(cb.parentElement.textContent.trim()); });
  var lbl = document.getElementById(lblId);
  if (sel.length === 0 || sel.length === checks.length) lbl.textContent = '-- Todos --';
  else if (sel.length <= 2) lbl.textContent = sel.join(', ');
  else lbl.textContent = sel.length + ' seleccionados';
}
function bpGetCheckedValues(dropId) {
  var vals = [];
  document.querySelectorAll('#' + dropId + ' .bp-multisel-item input[type=checkbox]:checked').forEach(function(cb) { vals.push(cb.value); });
  return vals;
}
function bpFilterItems(dropId, q) {
  var items = document.querySelectorAll('#' + dropId + ' .bp-multisel-item');
  var lower = q.toLowerCase();
  items.forEach(function(item) {
    var txt = item.textContent.toLowerCase();
    item.style.display = txt.includes(lower) ? '' : 'none';
  });
}
// Cerrar dropdowns al click fuera
document.addEventListener('click', function(e) {
  if (!e.target.closest('.bp-multisel-wrap')) {
    document.querySelectorAll('.bp-multisel-drop.open').forEach(function(d) { d.classList.remove('open'); });
    document.querySelectorAll('.bp-multisel-wrap').forEach(function(w) { w.classList.remove('open'); });
  }
});

async function ejecutarBuscarPedido() {
  var desde    = document.getElementById('bpDesde').value;
  var hasta    = document.getElementById('bpHasta').value;
  var vendIds  = bpGetCheckedValues('bpDropVend');
  var cliIds   = bpGetCheckedValues('bpDropCli');
  var url = '/Ventas/Pedidos?handler=BuscarPedidos'
    + (desde             ? '&desde='     + encodeURIComponent(desde)            : '')
    + (hasta             ? '&hasta='     + encodeURIComponent(hasta)            : '')
    + (vendIds.length    ? '&vendedores=' + encodeURIComponent(vendIds.join(',')): '')
    + (cliIds.length     ? '&clientes='  + encodeURIComponent(cliIds.join(',')) : '');
  var tbody = document.getElementById('bpTbody');
  tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:1rem;color:#aaa;">Buscando…</td></tr>';
  try {
    var r    = await fetch(url);
    var data = await r.json();
    if (!data.length) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:1rem;color:#888;">Sin resultados.</td></tr>';
      return;
    }
    tbody.innerHTML = data.map(function(p) {
      var fecha = p.fecha ? new Date(p.fecha).toLocaleDateString('es-AR') : '';
      return '<tr class="bp-row" data-id="' + p.id + '" data-cli="' + (p.fkCliente||0) + '" style="cursor:pointer;" onclick="bpToggleDetalle(this,' + p.id + ',' + (p.fkCliente||0) + ')">'
        + '<td style="padding:.35rem .4rem;text-align:center;color:#aaa;font-size:.7rem;">&#9654;</td>'
        + '<td style="padding:.35rem .6rem;"><strong>' + p.id + '</strong></td>'
        + '<td>' + fecha + '</td>'
        + '<td>' + escH(p.nombreCliente||'') + '</td>'
        + '<td>' + escH(p.nombreVendedor||'') + '</td>'
        + '<td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + escH(p.observacion||'') + '">' + escH(p.observacion||'') + '</td>'
        + '<td style="text-align:right;">' + fmt(p.total) + '</td>'
        + '<td><button class="btn btn-xs btn-primary" style="font-size:.72rem;padding:.2rem .5rem;" onclick="event.stopPropagation();cargarPedido(' + p.id + ',' + (p.fkCliente||0) + ')">Cargar</button></td>'
        + '</tr>'
        + '<tr class="bp-detalle-row" id="bpDet_' + p.id + '" style="display:none;"><td colspan="8" style="padding:0;background:#f8f9ff;"></td></tr>';
    }).join('');
  } catch(e) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:1rem;color:#dc3545;">Error al buscar.</td></tr>';
  }
}

var _bpDetalleAbiertoId = null;
async function bpToggleDetalle(trEl, pedidoId, fkCliente) {
  var detTr = document.getElementById('bpDet_' + pedidoId);
  var td    = detTr.querySelector('td');
  if (_bpDetalleAbiertoId === pedidoId) {
    detTr.style.display = 'none';
    trEl.querySelector('td:first-child').innerHTML = '&#9654;';
    _bpDetalleAbiertoId = null;
    return;
  }
  if (_bpDetalleAbiertoId !== null) {
    var prevDet = document.getElementById('bpDet_' + _bpDetalleAbiertoId);
    if (prevDet) prevDet.style.display = 'none';
    document.querySelectorAll('.bp-row').forEach(function(r){ r.querySelector('td:first-child').innerHTML = '&#9654;'; });
  }
  _bpDetalleAbiertoId = pedidoId;
  trEl.querySelector('td:first-child').innerHTML = '&#9660;';
  td.innerHTML = '<div style="padding:.6rem 1rem;color:#aaa;font-size:.78rem;">Cargando detalle…</div>';
  detTr.style.display = '';
  try {
    var r    = await fetch('/Ventas/Pedidos?handler=Pedido&id=' + pedidoId);
    var data = await r.json();
    if (!data.ok) { td.innerHTML = '<div style="padding:.6rem;color:#dc3545;">Error al cargar el detalle.</div>'; return; }
    var c   = data.cab;
    var d   = data.detalle || [];
    var iva = parseFloat(c.iva) || 0;

    // Regla: si cabecera tiene descuento global, usarlo para toda las líneas
    var descRecGlobalVis = null;
    if (c.descuento != null) {
      descRecGlobalVis = (c.descuento || 0) * -1 + (c.recargo || 0);
    }

    var html = '<div style="display:flex;gap:1rem;padding:.75rem 1rem;flex-wrap:wrap;">';
    // Panel cliente
    html += '<div style="min-width:200px;flex:0 0 auto;">'
      + '<div style="font-size:.68rem;font-weight:700;color:#4e73df;text-transform:uppercase;letter-spacing:.4px;margin-bottom:.4rem;border-bottom:1px solid #dee2e6;padding-bottom:.2rem;">Datos del cliente</div>'
      + '<table style="font-size:.78rem;border-collapse:collapse;">'
      + '<tr><td style="color:#6c757d;padding:.1rem .4rem .1rem 0;white-space:nowrap;font-weight:600;">Nombre:</td><td>' + escH(c.nombreComercial||'\u2014') + '</td></tr>'
      + '<tr><td style="color:#6c757d;padding:.1rem .4rem .1rem 0;white-space:nowrap;font-weight:600;">Tel\u00e9fono:</td><td>' + escH(c.telefono||'\u2014') + '</td></tr>'
      + '<tr><td style="color:#6c757d;padding:.1rem .4rem .1rem 0;white-space:nowrap;font-weight:600;">Direcci\u00f3n:</td><td>' + escH(c.direccionFull||'\u2014') + '</td></tr>'
      + '<tr><td style="color:#6c757d;padding:.1rem .4rem .1rem 0;white-space:nowrap;font-weight:600;">Contacto:</td><td>' + escH(c.contacto||'\u2014') + '</td></tr>'
      + '</table></div>';

    // Indicador si aplica descuento/recargo global
    var globalTag = '';
    if (descRecGlobalVis !== null && descRecGlobalVis !== 0) {
      var globalLbl = descRecGlobalVis < 0
        ? '<span style="color:#e74a3b;font-weight:700;">Desc. ' + Math.abs(descRecGlobalVis).toFixed(2) + '% global</span>'
        : '<span style="color:#1cc88a;font-weight:700;">Rec. ' + descRecGlobalVis.toFixed(2) + '% global</span>';
      globalTag = ' &nbsp;(' + globalLbl + ')';
    }

    // Tabla de detalle con cálculos
    html += '<div style="flex:1;min-width:400px;overflow-x:auto;">'
      + '<div style="font-size:.68rem;font-weight:700;color:#4e73df;text-transform:uppercase;letter-spacing:.4px;margin-bottom:.4rem;border-bottom:1px solid #dee2e6;padding-bottom:.2rem;">Detalle del pedido (IVA: ' + iva + '%)' + globalTag + '</div>'
      + '<table style="width:100%;border-collapse:collapse;font-size:.76rem;">'
      + '<thead><tr style="background:#e8edf5;">'
      + '<th style="padding:.25rem .4rem;text-align:left;">Descripci\u00f3n</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">P.S/IVA</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">Desc/Rec%</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">SubT.S/IVA</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">P.C/IVA</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">Cant.</th>'
      + '<th style="padding:.25rem .4rem;text-align:right;">Subtotal</th>'
      + '</tr></thead><tbody>';
    var totSubt = 0;
    d.forEach(function(l) {
      var precioSIva = l.precioSinIva || 0;
      // Aplicar descuento global de cabecera si corresponde, caso contrario usar el de la línea
      var descRec = descRecGlobalVis !== null
        ? descRecGlobalVis
        : (l.descuento || 0) * -1 + (l.recargo || 0);
      var subtSIva   = precioSIva * (1 + descRec / 100);
      var pCIva      = subtSIva * (1 + iva / 100);
      var cant       = l.cantidad || 0;
      var subtotal   = pCIva * cant;
      totSubt += subtotal;
      var drClass = descRec < 0 ? 'color:#e74a3b;' : (descRec > 0 ? 'color:#1cc88a;' : '');
      html += '<tr style="border-bottom:1px solid #f0f0f0;">'
        + '<td style="padding:.2rem .4rem;">' + escH(l.descripcion||'') + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;">' + fmt(precioSIva) + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;' + drClass + '">' + (descRec !== 0 ? descRec.toFixed(2) + '%' : '-') + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;">' + fmt(subtSIva) + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;">' + fmt(pCIva) + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;">' + fmt(cant) + '</td>'
        + '<td style="padding:.2rem .4rem;text-align:right;font-weight:600;">' + fmt(subtotal) + '</td>'
        + '</tr>';
    });
    html += '<tr style="background:#e8edf5;font-weight:700;">'
      + '<td colspan="6" style="padding:.3rem .4rem;text-align:right;">TOTAL:</td>'
      + '<td style="padding:.3rem .4rem;text-align:right;">' + fmt(totSubt) + '</td>'
      + '</tr>';
    html += '</tbody></table></div></div>';
    td.innerHTML = html;
  } catch(e) {
    td.innerHTML = '<div style="padding:.6rem;color:#dc3545;">Error: ' + e.message + '</div>';
  }
}

async function cargarPedido(pedidoId, fkCliente) {
  var r    = await fetch('/Ventas/Pedidos?handler=Pedido&id=' + pedidoId);
  var data = await r.json();
  if (!data.ok) { alert('Error al cargar el pedido.'); return; }

  var modalEl = document.getElementById('modalBuscarPedido');
  var modalInst = bootstrap.Modal.getInstance(modalEl);
  if (modalInst) modalInst.hide();
  limpiarTodo();

  var c = data.cab;
  _clienteId = c.fkCliente || 0;
  _pedidoId  = c.id;
  document.getElementById('hClienteId').value = _clienteId;
  document.getElementById('ci-nombre').textContent    = c.nombreComercial || '';
  document.getElementById('ci-telefono').textContent  = c.telefono  || '--';
  document.getElementById('ci-direccion').textContent = c.direccionFull || '--';
  document.getElementById('ci-contacto').textContent  = c.contacto  || '--';
  document.getElementById('clienteInfo').style.display  = 'block';
  document.getElementById('clienteVacio').style.display = 'none';
  document.getElementById('lblPedidoId').textContent = '(Editando Pedido N\u00b0 ' + String(c.id).padStart(6,'0') + ')';

  if (c.iva != null) {
    var selIva = document.getElementById('selIva');
    for (var i=0; i<selIva.options.length; i++) {
      if (parseFloat(selIva.options[i].value) === c.iva) { selIva.options[i].selected=true; break; }
    }
  }
  if (c.fkVendedor) {
    var selV = document.getElementById('selVendedor');
    for (var j=0; j<selV.options.length; j++) {
      if (parseInt(selV.options[j].value) === c.fkVendedor) { selV.options[j].selected=true; break; }
    }
  }
  document.getElementById('txtObservacion').value = c.observacion || '';

  var iva = parseFloat(document.getElementById('selIva').value)||0;

  // Regla: si pedido tiene descuento global (cabecera), aplicarlo a todas las líneas
  var descRecGlobal = null;
  if (c.descuento != null) {
    descRecGlobal = (c.descuento || 0) * -1 + (c.recargo || 0);
  }

  _rows = (data.detalle||[]).map(function(d) {
    var descRec = descRecGlobal !== null
      ? descRecGlobal
      : (d.recargo > 0 ? d.recargo : (d.descuento > 0 ? -d.descuento : 0));
    var row = {
      fkProducto:    d.fkProducto,
      codBarras:     d.codBarras   || '',
      codProveedor:  d.codProveedor|| '',
      descripcion:   d.descripcion || '',
      observ:        d.observ      || '',
      stock:         d.stock,
      precioSinIva:  d.precioSinIva,
      descRec:       descRec,
      subtotalSinIva: 0,
      precioConIva:  0,
      cantidad:      d.cantidad,
      subtotal:      0,
      dolarizado:    d.dolarizado,
      costo:         d.costo,
      precioOrig:    d.precioOrig,
      selected:      false
    };
    calcRow(row);
    return row;
  });

  // Si había descuento global, pre-cargar la barra Desc/Rec con ese valor
  if (descRecGlobal !== null) {
    var absPct = Math.abs(descRecGlobal);
    document.getElementById('txtDescRecPct').value = absPct > 0 ? absPct : '';
    document.getElementById(descRecGlobal < 0 ? 'rdDescuento' : 'rdRecargo').checked = true;
    document.getElementById(descRecGlobal < 0 ? 'rdDescuento' : 'rdRecargo').dispatchEvent(new Event('change'));
  }

  renderGrilla();
  recalcularTotales();
}

