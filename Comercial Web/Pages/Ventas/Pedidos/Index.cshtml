function abrirNuevoCliente() {
  ['ncNombre','ncRazon','ncCuil','ncDireccion','ncEmail',
   'ncTelefono','ncCelular','ncContacto'].forEach(function(id) {
    document.getElementById(id).value = '';
  });
  ['ncCondIva','ncVendedor','ncLocalidad','ncZona'].forEach(function(id) {
    document.getElementById(id).value = '';
  });
  document.getElementById('ncAlerta').style.display = 'none';
  new bootstrap.Modal(document.getElementById('modalNuevoCliente')).show();
  setTimeout(function() { document.getElementById('ncNombre').focus(); }, 400);
}
async function guardarNuevoCliente() {
  var alerta = document.getElementById('ncAlerta');
  alerta.style.display = 'none';
  var nombre = document.getElementById('ncNombre').value.trim();
  if (!nombre) {
    alerta.textContent = 'El nombre comercial es obligatorio.';
    alerta.style.display = 'block';
    return;
  }
  var strVal = function(id) { var v = document.getElementById(id).value.trim(); return v || null; };
  var intVal = function(id) { var v = parseInt(document.getElementById(id).value,10); return v > 0 ? v : null; };
  var dto = {
    nombreComercial: nombre,
    razonSocial:     strVal('ncRazon'),
    cuil:            strVal('ncCuil'),
    direccion:       strVal('ncDireccion'),
    email:           strVal('ncEmail'),
    telefono:        strVal('ncTelefono'),
    celular:         strVal('ncCelular'),
    contacto:        strVal('ncContacto'),
    fkCondIva:       intVal('ncCondIva'),
    fkVendedor:      intVal('ncVendedor'),
    fkLocalidad:     intVal('ncLocalidad'),
    fkZona:          intVal('ncZona')
  };
  try {
    var r = await fetch('/Ventas/Pedidos?handler=CrearClienteRapido', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(dto)
    });
    var ct = r.headers.get('Content-Type') || '';
    if (!ct.includes('application/json')) {
      var txt = await r.text();
      alerta.textContent = 'Error del servidor (HTTP ' + r.status + '): ' + (txt || '').substring(0,300);
      alerta.style.display = 'block';
      console.error('CrearClienteRapido error', r.status, txt);
      return;
    }
    var data = await r.json();
    if (data.ok) {
      var modalInst = bootstrap.Modal.getInstance(document.getElementById('modalNuevoCliente'));
      if (modalInst) modalInst.hide();
      seleccionarCliente({
        clienteId:       data.clienteId,
        nombreComercial: data.nombreComercial,
        telefono:        data.telefono,
        contacto:        data.contacto,
        direccionFull:   data.direccion
      });
    } else {
      alerta.textContent = data.msg || 'Error al crear el cliente.';
      alerta.style.display = 'block';
    }
  } catch (err) {
    alerta.textContent = 'Error inesperado: ' + err.message;
    alerta.style.display = 'block';
  }
}

